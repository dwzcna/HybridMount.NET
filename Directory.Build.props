<Project>
  <PropertyGroup>
    <Version>0.0.9.8</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <BinaryVersion>$(Version)</BinaryVersion>
    <BinaryVersion Condition="$([System.Version]::Parse('$(Version)').Revision) == -1">$(Version).0</BinaryVersion>
    <AssemblyVersion>$(BinaryVersion)</AssemblyVersion>
    <FileVersion>$(BinaryVersion)</FileVersion>
    <Company>dwzcn</Company>
    <Product>HybridMount.NET</Product>
    <Copyright>Copyright © dwzcn 2026</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
