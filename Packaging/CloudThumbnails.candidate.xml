<?xml version="1.0" encoding="utf-8"?>
<!-- 0.0.9.37隔离候选，未通过原生菜单／自动选择门槛；不进入产品清单，不可直接部署。 -->
<Extensions xmlns:desktop3="http://schemas.microsoft.com/appx/manifest/desktop/windows10/3" xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10">
    <desktop3:Extension Category="windows.cloudFiles">
        <desktop3:CloudFiles IconResource="Assets\HybridMount.png">
            <desktop3:CustomStateHandler />
            <desktop3:ThumbnailProviderHandler Clsid="A65802EB-4D1C-4C7E-A519-34C76B9BB281" />
            <desktop3:ExtendedPropertyHandler />
            <desktop3:BannersHandler />
            <desktop3:CloudFilesContextMenus />
        </desktop3:CloudFiles>
    </desktop3:Extension>
    <com:Extension Category="windows.comServer">
        <com:ComServer>
            <com:ExeServer Executable="HybridMount.NET.exe" Arguments="--thumbnail-server" DisplayName="HybridMount 缩略图缓存">
                <com:Class Id="A65802EB-4D1C-4C7E-A519-34C76B9BB281" DisplayName="HybridMount 缩略图" />
            </com:ExeServer>
        </com:ComServer>
    </com:Extension>
</Extensions>
