<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable><IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);HYBRIDMOUNT_HEADLESS_TEST</DefineConstants>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.NET.Test.Sdk"/><PackageReference Include="xunit"/><PackageReference Include="xunit.runner.visualstudio"><PrivateAssets>all</PrivateAssets></PackageReference><PackageReference Include="Microsoft.Data.Sqlite"/>
    <PackageReference Include="AWSSDK.S3"/><PackageReference Include="AWSSDK.SQS"/><PackageReference Include="WebDAVClient"/><PackageReference Include="CommunityToolkit.Mvvm"/></ItemGroup>
  <ItemGroup>
    <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\HybridMount.Ext.dll" Link="HybridMount.Ext.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\HybridMount.Ext.dll')"/>
    <Content Include="..\HybridMount\Assets\SyncExcluded.ico" Link="Assets\SyncExcluded.ico" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="..\HybridMount\Assets\SyncIssue.ico" Link="Assets\SyncIssue.ico" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
  <ItemGroup><Content Include="..\HybridMount\Assets\SyncExcluded.png" Link="Assets\SyncExcluded.png" CopyToOutputDirectory="PreserveNewest"/><Content Include="..\HybridMount\Assets\SyncIssue.png" Link="Assets\SyncIssue.png" CopyToOutputDirectory="PreserveNewest"/><Content Include="Assets\sample.*" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup>
    <Compile Include="..\HybridMount\Models\AppearancePreferences.cs" Link="Production\AppearancePreferences.cs"/>
    <Compile Include="..\HybridMount\Models\IpcMessages.cs" Link="Production\IpcMessages.cs"/>
    <Compile Include="..\HybridMount\Models\Diagnostics\*.cs" Link="Production\Diagnostics\%(Filename)%(Extension)"/>
    <Compile Include="..\HybridMount\Common\IAppearancePreferenceStore.cs" Link="Production\IAppearancePreferenceStore.cs"/>
    <Compile Include="..\HybridMount\Services\ApplicationPaths.cs" Link="Production\ApplicationPaths.cs"/>
    <Compile Include="..\HybridMount\Services\AppearanceSettingsService.cs" Link="Production\AppearanceSettingsService.cs"/>
    <Compile Include="..\HybridMount\Services\WinRegisterService.cs" Link="Production\WinRegisterService.cs"/>
    <Compile Include="..\HybridMount\Services\LifecycleDiagnostics.cs" Link="Production\LifecycleDiagnostics.cs"/>
    <Compile Include="..\HybridMount\Services\ShutdownSequence.cs" Link="Production\ShutdownSequence.cs"/>
    <Compile Include="..\HybridMount\Services\LoggerService*.cs" Link="Production\%(Filename)%(Extension)"/>
    <Compile Include="..\HybridMount\Services\Ipc*.cs" Link="Production\%(Filename)%(Extension)"/>
    <Compile Include="..\HybridMount\Services\SingleInstanceService.cs" Link="Production\SingleInstanceService.cs"/>
    <Compile Include="..\HybridMount\ViewModels\**\*.cs" Link="Production\ViewModels\%(RecursiveDir)%(Filename)%(Extension)"/>
    <Compile Include="..\HybridMount\Models\StartupState.cs" Link="Production\StartupState.cs"/>
    <Compile Include="..\HybridMount\Models\ApplicationPage.cs" Link="Production\ApplicationPage.cs"/>
    <Compile Include="..\HybridMount\Common\INavigationService.cs" Link="Production\INavigationService.cs"/>
    <Compile Include="..\HybridMount\Services\NavigationService.cs" Link="Production\NavigationService.cs"/>
    <Compile Include="..\HybridMount\Services\TaskFocusService.cs" Link="Production\TaskFocusService.cs"/>
    <Compile Include="..\HybridMount\Common\IStartupService.cs" Link="Production\IStartupService.cs"/>
    <Compile Include="..\HybridMount\Common\IUiDispatcher.cs" Link="Production\IUiDispatcher.cs"/>
    <Compile Include="..\HybridMount\Services\ApplicationPreferencesService.cs" Link="Production\ApplicationPreferencesService.cs"/>
    <Compile Include="..\HybridMount\Models\Mounting\**\*.cs" Link="Production\Models\Mounting\%(RecursiveDir)%(Filename)%(Extension)"/>
    <Compile Include="..\HybridMount\Services\Mounting\**\*.cs" Link="Production\Services\Mounting\%(RecursiveDir)%(Filename)%(Extension)"/>
    <Compile Include="..\HybridMount\Common\IRemoteChangeSource.cs" Link="Production\IRemoteChangeSource.cs"/>
    <Compile Include="..\HybridMount\Common\IRemoteUsageSource.cs" Link="Production\IRemoteUsageSource.cs"/>
    <Compile Include="..\HybridMount\Common\IFileSource.cs" Link="Production\IFileSource.cs"/>
    <Compile Include="..\HybridMount\Common\IMountDefinitionStore.cs" Link="Production\IMountDefinitionStore.cs"/>
    <Compile Include="..\HybridMount\Common\ILocalUploadCommitter.cs" Link="Production\ILocalUploadCommitter.cs"/>
    <Compile Include="..\HybridMount\Common\IReadDiagnosticsSource.cs" Link="Production\IReadDiagnosticsSource.cs"/>
    <Compile Include="..\HybridMount\Common\SourcePartialMoveException.cs" Link="Production\SourcePartialMoveException.cs"/>
    <Using Include="HybridMount.Models"/><Using Include="HybridMount.Models.Mounting"/><Using Include="HybridMount.Common"/><Using Include="HybridMount.Services"/><Using Include="Xunit"/>
  </ItemGroup>
</Project>
