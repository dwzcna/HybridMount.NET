<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);HYBRIDMOUNT_HEADLESS_TEST</DefineConstants>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
  </PropertyGroup>
  <Import Project="ProductionSources.props" />
  <!-- 各集合共享本机CFAPI／物理缓存资源；限制集合级并行，单个用例内的1／4／128并发保持真实执行。 -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.SQS" />
    <PackageReference Include="WebDAVClient" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\HybridMount.Ext.resources.dll" Link="HybridMount.Ext.resources.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\zh-CN\HybridMount.Ext.resources.dll.mui" Link="zh-CN\HybridMount.Ext.resources.dll.mui" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\en-US\HybridMount.Ext.resources.dll.mui" Link="en-US\HybridMount.Ext.resources.dll.mui" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\zh-HK\HybridMount.Ext.resources.dll.mui" Link="zh-HK\HybridMount.Ext.resources.dll.mui" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\HybridMount.Stock\bin\$(Platform)\$(Configuration)\HybridMount.Stock.exe" Link="HybridMount.Stock.exe" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('..\artifacts\native-runtime-tests\$(Platform)\$(Configuration)\HybridMount.Stock.exe')" />
    <Content Include="..\artifacts\native-runtime-tests\$(Platform)\$(Configuration)\HybridMount.Stock.exe" Link="HybridMount.Stock.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\artifacts\native-runtime-tests\$(Platform)\$(Configuration)\HybridMount.Stock.exe')" />
    <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\HybridMount.Ext.dll" Link="HybridMount.Ext.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\HybridMount.Ext.dll')" />
    <Content Include="..\HybridMount\Assets\SyncExcluded.ico" Link="Assets\SyncExcluded.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\HybridMount\Assets\SyncIssue.ico" Link="Assets\SyncIssue.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\HybridMount\Assets\SyncExcluded.png" Link="Assets\SyncExcluded.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\HybridMount\Assets\SyncIssue.png" Link="Assets\SyncIssue.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\sample.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\HybridMount\Resources\Messages*.resx" Link="Resources\%(Filename)%(Extension)" LogicalName="HybridMount.Resources.%(Filename).resources" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- 测试输出保留NuGet的runtimes布局；原生宿主仅允许加载应用目录SQLite，因此精确复制当前架构依赖。 -->
  <Target Name="CopyNativeRuntimeDependency" AfterTargets="Build">
    <PropertyGroup>
      <_NativeRid>win-x64</_NativeRid>
      <_NativeRid Condition="'$(Platform)'=='ARM64'">win-arm64</_NativeRid>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetDir)runtimes\$(_NativeRid)\native\e_sqlite3.dll" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
