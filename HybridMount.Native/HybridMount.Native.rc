#include <windows.h>
#include "Version.h"
101 ICON "../HybridMount/Assets/HybridMount.ico"
// 状态图标仅作系统图标资源提取，不注册或激活自有Shell处理器。
102 ICON "../HybridMount/Assets/SyncExcluded.ico"
103 ICON "../HybridMount/Assets/SyncIssue.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION HYBRIDMOUNT_VERSION
 PRODUCTVERSION HYBRIDMOUNT_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "dwzcn\0"
   VALUE "FileDescription", "HybridMount.NET Explorer Extension\0"
   VALUE "FileVersion", HYBRIDMOUNT_VERSION_TEXT
   VALUE "InternalName", "HybridMount.Native\0"
   VALUE "OriginalFilename", "HybridMount.Native.dll\0"
   VALUE "ProductName", "HybridMount.NativePreview\0"
   VALUE "ProductVersion", HYBRIDMOUNT_VERSION_TEXT
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
