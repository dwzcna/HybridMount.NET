<ContentDialog xmlns:loc="using:HybridMount.UI" xmlns:helpers="using:HybridMount.UI" x:Class="HybridMount.Views.Dialogs.Mounting.WebDAVConfigurationContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:mounting="using:HybridMount.Controls.Mounting" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:HybridMount.Controls" xmlns:views="using:HybridMount.Views.Windows" xmlns:vm="using:HybridMount.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <UserControl Style="{StaticResource ProtocolFieldsStyle}" x:Name="ConnectionFields"><StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockConnectionSettings" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockConnectionSettings"/>
                    <TextBox x:Name="NameField" x:Uid="/Strings/WebDAVConfigurationContentDialogNameField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogNameField"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathField" IsReadOnly="True" x:Uid="/Strings/WebDAVConfigurationContentDialogPathField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogPathField"/>
                        <Button x:Name="ChooseButton" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseFolder" x:Uid="/Strings/WebDAVConfigurationContentDialogChooseButton" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogChooseButton"/>
                    </Grid>
                    <TextBox x:Name="EndpointField" x:Uid="/Strings/WebDAVConfigurationContentDialogEndpointField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogEndpointField"/>
                    <StackPanel x:Name="HttpsFields" Spacing="12" Visibility="Collapsed">
                        <TextBox x:Name="CertificatePinField" x:Uid="/Strings/WebDAVConfigurationContentDialogCertificatePinField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogCertificatePinField"/>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="FetchCertificateButton" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="FetchCertificate"><TextBlock x:Name="FetchCertificateLabel" TextWrapping="Wrap"/></Button>
                            <Button x:Name="ClearCertificateTrustButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ClearCertificateTrust"><TextBlock x:Name="ClearCertificateTrustLabel" TextWrapping="Wrap"/></Button>
                        </Grid>
                        <TextBlock x:Name="FetchedCertificateDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed"/>
                        <TextBlock TextWrapping="Wrap" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockForASelfSignedCertificateVerify" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockForASelfSignedCertificateVerify"/>
                    </StackPanel>
                    <StackPanel Spacing="12">
                                    <TextBox x:Name="UserField" x:Uid="/Strings/WebDAVConfigurationContentDialogUserField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogUserField"/>
                                    <PasswordBox x:Name="PasswordField" x:Uid="/Strings/WebDAVConfigurationContentDialogPasswordField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogPasswordField"/>
                                </StackPanel>
                    <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="HttpWarning" IsOpen="False" IsClosable="True" Severity="Warning" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(HttpWarning.IsOpen),Mode=OneWay}" x:Uid="/Strings/WebDAVConfigurationContentDialogHttpWarning" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogHttpWarning"/>
                    <controls:SettingRow x:Uid="/Strings/WebDAVConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts"><ToggleSwitch HorizontalAlignment="Left" x:Name="AutoConnectField" IsOn="True" Toggled="AutoConnectChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogAutoConnectField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogAutoConnectField"/></controls:SettingRow>
                </StackPanel></UserControl>
                <InfoBar x:Name="CertificateWarning" Style="{StaticResource InstantNotificationStyle}" IsOpen="False" IsClosable="True" Severity="Warning"
                         Visibility="{x:Bind helpers:TextVisibility.ForFlag(CertificateWarning.IsOpen),Mode=OneWay}">
                    <InfoBar.ActionButton><Button x:Name="TrustCertificateButton" Style="{StaticResource SubtleButtonStyle}" Click="TrustCertificate"/></InfoBar.ActionButton>
                </InfoBar>
                <mounting:ProtocolCapabilitiesView x:Name="CapabilityView"/>
                <Expander Style="{StaticResource ProtocolExpanderStyle}" HorizontalAlignment="Stretch" x:Uid="/Strings/WebDAVConfigurationContentDialogExpanderExcludedFilesAdvanced" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogExpanderExcludedFilesAdvanced"><UserControl Style="{StaticResource ProtocolFieldsStyle}" x:Name="ExclusionFields"><StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockExcludedFiles" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockExcludedFiles"/>
                    <ListView x:Name="ExclusionList" SelectionMode="None" MaxHeight="220" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:FileExclusionRuleViewModel">
                            <Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox MinWidth="96" Grid.Column="0" SelectedIndex="{x:Bind MatchIndex,Mode=TwoWay}" HorizontalAlignment="Stretch" x:Uid="/Strings/WebDAVConfigurationContentDialogComboBoxMatchMode" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogComboBoxMatchMode"><x:String>包含</x:String><x:String>前缀</x:String><x:String>后缀</x:String></ComboBox>
                                <TextBox Grid.Column="1" Text="{x:Bind Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="255" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBoxFileNameText" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBoxFileNameText"/>
                                <Button Grid.Column="2" Tag="{x:Bind}" Click="RemoveExclusionRule" Padding="6" x:Uid="/Strings/WebDAVConfigurationContentDialogButtonDeleteRule" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogButtonDeleteRule"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <mounting:ProtocolActionPanel Spacing="8">
                        <Button Style="{StaticResource ProtocolSecondaryButtonStyle}" Click="AddExclusionRule" x:Uid="/Strings/WebDAVConfigurationContentDialogButtonAddRule" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogButtonAddRule"/>
                        <Button Style="{StaticResource ProtocolSecondaryButtonStyle}" Click="AddDefaultExclusionRules" x:Uid="/Strings/WebDAVConfigurationContentDialogButtonAddDefaultRules" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogButtonAddDefaultRules"/>
                        <Button Style="{StaticResource ProtocolSecondaryButtonStyle}" x:Name="SaveExclusionsButton" Click="SaveExclusions" x:Uid="/Strings/WebDAVConfigurationContentDialogSaveExclusionsButton" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogSaveExclusionsButton"/>
                    </mounting:ProtocolActionPanel>
                </StackPanel></UserControl></Expander>
                <Expander Style="{StaticResource ProtocolExpanderStyle}" HorizontalAlignment="Stretch" x:Uid="/Strings/WebDAVConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced"><UserControl Style="{StaticResource ProtocolFieldsStyle}" x:Name="SettingsFields" Visibility="Collapsed"><StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockCapacityLimit" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockCapacityLimit"/>
                    <controls:SettingRow Visibility="{x:Bind CapacityAuto.Visibility,Mode=OneWay}" x:Uid="/Strings/WebDAVConfigurationContentDialogSettingRowUseServerCapacityInformationAutomatically" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogSettingRowUseServerCapacityInformationAutomatically"><ToggleSwitch HorizontalAlignment="Left" x:Name="CapacityAuto" Toggled="CapacityModeChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogCapacityAuto" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogCapacityAuto"/></controls:SettingRow>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MaximumField" TextChanged="CapacityTextChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogMaximumField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogMaximumField"/>
                        <ComboBox MinWidth="80" x:Name="CapacityUnit" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="CapacityUnitChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogCapacityUnit" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogCapacityUnit"><x:String>GB</x:String><x:String>TB</x:String></ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ProtocolSecondaryButtonStyle}" x:Name="SaveCapacityButton" Click="SaveCapacity" HorizontalAlignment="Stretch"><TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockSaveCapacitySettings" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockSaveCapacitySettings"/></Button>
                        <Button Style="{StaticResource ProtocolSecondaryButtonStyle}" x:Name="RecheckButton" Grid.Column="1" Click="RecheckCapacity" HorizontalAlignment="Stretch"><TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockFetchCapacityInformationFromServer" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockFetchCapacityInformationFromServer"/></Button>
                    </Grid>
                    <TextBlock x:Name="CapacityDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(CapacityDescription.Text),Mode=OneWay}"/>
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockSyncAndPreviews" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockSyncAndPreviews"/>
                    <controls:SettingRow Visibility="{x:Bind ThumbnailToggle.Visibility,Mode=OneWay}" x:Uid="/Strings/WebDAVConfigurationContentDialogSettingRowThumbnailsExperimental" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogSettingRowThumbnailsExperimental"><ToggleSwitch HorizontalAlignment="Left" x:Name="ThumbnailToggle" Toggled="ThumbnailChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogThumbnailToggle" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogThumbnailToggle"/></controls:SettingRow>
                    <TextBlock x:Name="ThumbnailDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(ThumbnailDescription.Text),Mode=OneWay}"/>
                    <controls:SettingRow x:Uid="/Strings/WebDAVConfigurationContentDialogSettingRowAutomaticRemoteDetectionRFC" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogSettingRowAutomaticRemoteDetectionRFC"><ToggleSwitch HorizontalAlignment="Left" x:Name="RemoteAuto" Toggled="RemoteAutoChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogRemoteAuto" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogRemoteAuto"/></controls:SettingRow>
                    <NumberBox x:Name="IncrementalField" Minimum="10" Maximum="86400" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogIncrementalField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogIncrementalField"/>
                    <NumberBox x:Name="FullField" Minimum="30" Maximum="604800" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogFullField" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogFullField"/>
                    <Button Style="{StaticResource ProtocolSecondaryButtonStyle}" x:Name="SaveIntervalsButton" Click="SaveIntervals" x:Uid="/Strings/WebDAVConfigurationContentDialogSaveIntervalsButton" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogSaveIntervalsButton"/>
                    <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(DetectionDescription.Text),Mode=OneWay}"/>
                </StackPanel></UserControl></Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind helpers:TextVisibility.ForOpenFeedback(ProbeBar.IsOpen,ErrorBar.IsOpen,OperationBar.IsOpen),Mode=OneWay}" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ProbeBar" Visibility="{x:Bind ProbeBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Informational" x:Uid="/Strings/WebDAVConfigurationContentDialogProbeBar" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogProbeBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ErrorBar" Visibility="{x:Bind ErrorBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Error" x:Uid="/Strings/WebDAVConfigurationContentDialogErrorBar" loc:UserInterface.ResourceId="/Strings/WebDAVConfigurationContentDialogErrorBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="OperationBar" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
