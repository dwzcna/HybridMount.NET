<ContentDialog xmlns:loc="using:HybridMount.UI" xmlns:helpers="using:HybridMount.UI" x:Class="HybridMount.Views.Dialogs.Mounting.S3ConfigurationContentDialog"
               IsPrimaryButtonEnabled="{x:Bind Interaction.CanSubmit,Mode=OneWay}" IsSecondaryButtonEnabled="{x:Bind Interaction.CanTest,Mode=OneWay}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:mounting="using:HybridMount.Controls.Mounting" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:HybridMount.Controls" xmlns:views="using:HybridMount.Views.Windows" xmlns:vm="using:HybridMount.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <UserControl Style="{StaticResource StretchUserControlStyle}" x:Name="ConnectionFields" IsEnabled="{x:Bind Interaction.CanEditDraft,Mode=OneWay}"><StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockConnectionSettings" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockConnectionSettings"/>
                    <TextBox x:Name="NameField" x:Uid="/Strings/S3ConfigurationContentDialogNameField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogNameField"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathField" IsReadOnly="True" x:Uid="/Strings/S3ConfigurationContentDialogPathField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogPathField"/>
                        <Button Style="{StaticResource ActionButtonStyle}" x:Name="ChooseButton" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind Interaction.ChooseFolderCommand}" x:Uid="/Strings/S3ConfigurationContentDialogChooseButton" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogChooseButton"/>
                    </Grid>
                    <TextBox x:Name="EndpointField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogEndpointField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogEndpointField"/>
                    <StackPanel Spacing="12">
                                    <TextBox x:Name="BucketField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogBucketField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogBucketField"/>
                                    <TextBox x:Name="PrefixField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogPrefixField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogPrefixField"/>
                                    <TextBox x:Name="RegionField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" Text="us-east-1" x:Uid="/Strings/S3ConfigurationContentDialogRegionField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogRegionField"/>
                                    <CheckBox x:Name="PathStyleField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" IsChecked="True" x:Uid="/Strings/S3ConfigurationContentDialogPathStyleField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogPathStyleField"/>
                                    <CheckBox x:Name="DefaultCredentialsField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" Checked="CredentialsModeChanged" Unchecked="CredentialsModeChanged" x:Uid="/Strings/S3ConfigurationContentDialogDefaultCredentialsField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogDefaultCredentialsField"/>
                                    <UserControl Style="{StaticResource StretchUserControlStyle}" x:Name="S3Secrets" IsEnabled="{x:Bind Interaction.CanEditS3Secrets,Mode=OneWay}"><StackPanel Spacing="12">
                                        <TextBox x:Name="AccessKeyField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" Header="Access Key ID"/>
                                        <PasswordBox x:Name="SecretKeyField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" Header="Secret Access Key"/>
                                        <PasswordBox x:Name="SessionTokenField" IsEnabled="{x:Bind Interaction.CanEditConnection,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogSessionTokenField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSessionTokenField"/>
                                    </StackPanel></UserControl>
                                </StackPanel>
                    <CheckBox x:Name="HttpField" IsEnabled="{x:Bind Interaction.CanEditRootOptions,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogHttpField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogHttpField"/>
                    <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="HttpWarning" IsOpen="False" IsClosable="True" Severity="Warning" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(HttpWarning.IsOpen),Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogHttpWarning" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogHttpWarning"/>
                    <controls:SettingRow x:Uid="/Strings/S3ConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts"><ToggleSwitch HorizontalAlignment="Left" x:Name="AutoConnectField" IsEnabled="{x:Bind Interaction.CanToggleSettings,Mode=OneWay}" IsOn="True" Toggled="AutoConnectChanged" x:Uid="/Strings/S3ConfigurationContentDialogAutoConnectField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogAutoConnectField"/></controls:SettingRow>
                </StackPanel></UserControl>
                <mounting:ProtocolCapabilitiesView x:Name="CapabilityView"/>
                <Expander Style="{StaticResource StretchExpanderStyle}" x:Uid="/Strings/S3ConfigurationContentDialogExpanderExcludedFilesAdvanced" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogExpanderExcludedFilesAdvanced"><UserControl Style="{StaticResource StretchUserControlStyle}" x:Name="ExclusionFields" IsEnabled="{x:Bind Interaction.CanEditSettings,Mode=OneWay}"><StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockExcludedFiles" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockExcludedFiles"/>
                    <ListView x:Name="ExclusionList" SelectionMode="None" MaxHeight="220" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource StretchListItemStyle}">

                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:FileExclusionRuleViewModel">
                            <Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox MinWidth="96" Grid.Column="0" SelectedIndex="{x:Bind MatchIndex,Mode=TwoWay}" HorizontalAlignment="Stretch" x:Uid="/Strings/S3ConfigurationContentDialogComboBoxMatchMode" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogComboBoxMatchMode"><x:String>包含</x:String><x:String>前缀</x:String><x:String>后缀</x:String></ComboBox>
                                <TextBox Grid.Column="1" Text="{x:Bind Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="255" x:Uid="/Strings/S3ConfigurationContentDialogTextBoxFileNameText" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogTextBoxFileNameText"/>
                                <Button Style="{StaticResource SubtleButtonStyle}" Grid.Column="2" Tag="{x:Bind}" Click="RemoveExclusionRule" Padding="6" x:Uid="/Strings/S3ConfigurationContentDialogButtonDeleteRule" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogButtonDeleteRule"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <helpers:ActionPanel Style="{StaticResource ActionPanelStyle}" ContentAlignment="Left">
                        <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind Interaction.AddExclusionRuleCommand}" x:Uid="/Strings/S3ConfigurationContentDialogButtonAddRule" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogButtonAddRule"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind Interaction.AddDefaultExclusionRulesCommand}" x:Uid="/Strings/S3ConfigurationContentDialogButtonAddDefaultRules" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogButtonAddDefaultRules"/>
                        <Button Style="{StaticResource ActionButtonStyle}" x:Name="SaveExclusionsButton" Command="{x:Bind Interaction.SaveExclusionsCommand}" x:Uid="/Strings/S3ConfigurationContentDialogSaveExclusionsButton" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSaveExclusionsButton"/>
                    </helpers:ActionPanel>
                </StackPanel></UserControl></Expander>
                <Expander Style="{StaticResource StretchExpanderStyle}" x:Uid="/Strings/S3ConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced"><UserControl Style="{StaticResource StretchUserControlStyle}" x:Name="SettingsFields" IsEnabled="{x:Bind Interaction.CanEditDraft,Mode=OneWay}" Visibility="Collapsed"><StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockCapacityLimit" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockCapacityLimit"/>
                    <controls:SettingRow Visibility="{x:Bind CapacityAuto.Visibility,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogSettingRowUseServerCapacityInformationAutomatically" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowUseServerCapacityInformationAutomatically"><ToggleSwitch HorizontalAlignment="Left" x:Name="CapacityAuto" IsEnabled="{x:Bind Interaction.CanToggleSettings,Mode=OneWay}" Toggled="CapacityModeChanged" x:Uid="/Strings/S3ConfigurationContentDialogCapacityAuto" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogCapacityAuto"/></controls:SettingRow>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MaximumField" IsEnabled="{x:Bind Interaction.CanEditCapacityValue,Mode=OneWay}" TextChanged="CapacityTextChanged" x:Uid="/Strings/S3ConfigurationContentDialogMaximumField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogMaximumField"/>
                        <ComboBox MinWidth="80" x:Name="CapacityUnit" IsEnabled="{x:Bind Interaction.CanEditCapacityValue,Mode=OneWay}" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="CapacityUnitChanged" x:Uid="/Strings/S3ConfigurationContentDialogCapacityUnit" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogCapacityUnit"><x:String>GB</x:String><x:String>TB</x:String></ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ActionButtonStyle}" x:Name="SaveCapacityButton" Command="{x:Bind Interaction.SaveCapacityCommand}" HorizontalAlignment="Stretch"><TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockSaveCapacitySettings" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockSaveCapacitySettings"/></Button>
                        <Button Style="{StaticResource ActionButtonStyle}" x:Name="RecheckButton" Grid.Column="1" Command="{x:Bind Interaction.RecheckCapacityCommand}" HorizontalAlignment="Stretch"><TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockFetchCapacityInformationFromServer" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockFetchCapacityInformationFromServer"/></Button>
                    </Grid>
                    <TextBlock x:Name="CapacityDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(CapacityDescription.Text),Mode=OneWay}"/>
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockSyncAndPreviews" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockSyncAndPreviews"/>
                    <controls:SettingRow Visibility="{x:Bind ThumbnailToggle.Visibility,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogSettingRowThumbnailsExperimental" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowThumbnailsExperimental"><ToggleSwitch HorizontalAlignment="Left" x:Name="ThumbnailToggle" IsEnabled="{x:Bind Interaction.CanEditThumbnails,Mode=OneWay}" Toggled="ThumbnailChanged" x:Uid="/Strings/S3ConfigurationContentDialogThumbnailToggle" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogThumbnailToggle"/></controls:SettingRow>
                    <TextBlock x:Name="ThumbnailDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(ThumbnailDescription.Text),Mode=OneWay}"/>
                    <controls:SettingRow x:Uid="/Strings/S3ConfigurationContentDialogSettingRowAutomaticRemoteDetection" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowAutomaticRemoteDetection"><ToggleSwitch HorizontalAlignment="Left" x:Name="RemoteAuto" IsEnabled="{x:Bind Interaction.CanToggleSettings,Mode=OneWay}" Toggled="RemoteAutoChanged" x:Uid="/Strings/S3ConfigurationContentDialogRemoteAuto" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogRemoteAuto"/></controls:SettingRow>
                    <NumberBox x:Name="IncrementalField" IsEnabled="{x:Bind Interaction.CanEditSettings,Mode=OneWay}" Minimum="10" Maximum="86400" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged" x:Uid="/Strings/S3ConfigurationContentDialogIncrementalField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogIncrementalField"/>
                    <NumberBox x:Name="FullField" IsEnabled="{x:Bind Interaction.CanEditSettings,Mode=OneWay}" Minimum="30" Maximum="604800" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged" x:Uid="/Strings/S3ConfigurationContentDialogFullField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogFullField"/>
                    <Button Style="{StaticResource ActionButtonStyle}" x:Name="SaveIntervalsButton" Command="{x:Bind Interaction.SaveIntervalsCommand}" x:Uid="/Strings/S3ConfigurationContentDialogSaveIntervalsButton" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSaveIntervalsButton"/>
                    <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(DetectionDescription.Text),Mode=OneWay}"/>
                    <TextBlock x:Name="SqsDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(SqsDescription.Text),Mode=OneWay}"/>
                    <Expander Style="{StaticResource StretchExpanderStyle}" IsExpanded="False" x:Uid="/Strings/S3ConfigurationContentDialogExpanderSQSEventAccelerationSettings" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogExpanderSQSEventAccelerationSettings">
                        <StackPanel Spacing="12">
                            <UserControl Style="{StaticResource StretchUserControlStyle}" x:Name="SqsFields" IsEnabled="{x:Bind Interaction.CanEditDraft,Mode=OneWay}"><StackPanel Spacing="12">
                                <controls:SettingRow x:Uid="/Strings/S3ConfigurationContentDialogSettingRowEnableSQSEventAcceleration" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowEnableSQSEventAcceleration"><ToggleSwitch HorizontalAlignment="Left" x:Name="SqsEnabled" IsEnabled="{x:Bind Interaction.CanToggleSettings,Mode=OneWay}" Toggled="SqsEnabledChanged" x:Uid="/Strings/S3ConfigurationContentDialogSqsEnabled" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSqsEnabled"/></controls:SettingRow>
                                <TextBox x:Name="SqsUrl" IsEnabled="{x:Bind Interaction.CanEditSqs,Mode=OneWay}" Header="Standard Queue URL"/>
                                <TextBox x:Name="SqsRegion" IsEnabled="{x:Bind Interaction.CanEditSqs,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogSqsRegion" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSqsRegion"/>
                                <ComboBox x:Name="SqsMode" IsEnabled="{x:Bind Interaction.CanEditSqs,Mode=OneWay}" HorizontalAlignment="Stretch" SelectionChanged="SqsCredentialsModeChanged" x:Uid="/Strings/S3ConfigurationContentDialogSqsMode" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSqsMode">
                                    <x:String>明确复用 S3 凭据</x:String><x:String>SDK 默认凭据链</x:String><x:String>独立访问密钥</x:String>
                                </ComboBox>
                                <UserControl Style="{StaticResource StretchUserControlStyle}" x:Name="SqsSecrets" IsEnabled="{x:Bind Interaction.CanEditSqsSecrets,Mode=OneWay}"><StackPanel Spacing="12">
                                    <TextBox x:Name="SqsAccessField" x:Uid="/Strings/S3ConfigurationContentDialogSqsAccessField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSqsAccessField"/>
                                    <PasswordBox x:Name="SqsSecretField" x:Uid="/Strings/S3ConfigurationContentDialogSqsSecretField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSqsSecretField"/>
                                    <PasswordBox x:Name="SqsSessionField" x:Uid="/Strings/S3ConfigurationContentDialogSqsSessionField" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSqsSessionField"/>
                                </StackPanel></UserControl>
                            </StackPanel></UserControl>
                            <Button Style="{StaticResource ActionButtonStyle}" x:Name="SqsTestButton" Command="{x:Bind Interaction.TestSqsCommand}" x:Uid="/Strings/S3ConfigurationContentDialogSqsTestButton" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSqsTestButton"/>
                            <Button Style="{StaticResource ActionButtonStyle}" x:Name="SqsSaveButton" Command="{x:Bind Interaction.SaveSqsCommand}" x:Uid="/Strings/S3ConfigurationContentDialogSqsSaveButton" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogSqsSaveButton"/>
                        </StackPanel>
                    </Expander>
                </StackPanel></UserControl></Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind helpers:TextVisibility.ForOpenFeedback(ProbeBar.IsOpen,ErrorBar.IsOpen,OperationBar.IsOpen),Mode=OneWay}" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ProbeBar" Visibility="{x:Bind ProbeBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Informational" x:Uid="/Strings/S3ConfigurationContentDialogProbeBar" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogProbeBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ErrorBar" Visibility="{x:Bind ErrorBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Error" x:Uid="/Strings/S3ConfigurationContentDialogErrorBar" loc:UserInterface.ResourceId="/Strings/S3ConfigurationContentDialogErrorBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="OperationBar" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
