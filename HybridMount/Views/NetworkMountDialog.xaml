<ContentDialog x:Class="HybridMount.Views.NetworkMountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WebDAV 挂载" PrimaryButtonText="创建并连接" CloseButtonText="取消" DefaultButton="Primary" PrimaryButtonClick="CreateMount" Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Spacing="12" MinWidth="440">
            <UserControl x:Name="Form"><StackPanel Spacing="12">
                <TextBox x:Name="NameField" Header="名称" Text="WebDAV 挂载"/>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PathField" Header="本地 NTFS 空目录" IsReadOnly="True"/>
                    <Button x:Name="ChooseButton" Grid.Column="1" Content="选择目录" VerticalAlignment="Bottom" Click="ChooseFolder"/>
                </Grid>
                <TextBox x:Name="EndpointField" Header="服务器地址" PlaceholderText="https://dav.example.com/dav/"/>
                <TextBox x:Name="UserField" Header="账号"/>
                <PasswordBox x:Name="PasswordField" Header="密码或第三方应用密码"/>
                <CheckBox x:Name="HttpField" Content="允许明文 HTTP（仅可信测试环境）"/>
                <ToggleSwitch x:Name="AutoConnectField" Header="随程序启动连接" IsOn="True"/>
                <TextBlock Text="本地修改会受到保护，当前版本不会自动上传。" TextWrapping="Wrap"/>
            </StackPanel></UserControl>
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Title="无法连接挂载"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
