<Page xmlns:loc="using:HybridMount.UI" x:Class="HybridMount.Views.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource SharedPageGridStyle}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="16"><Image Source="ms-appx:///Assets/HybridMount.png" Width="40" Height="40"/><TextBlock Text="HybridMount.NET" Style="{StaticResource PageTitleStyle}"/></StackPanel>
    <Grid x:Name="HomeToolbar" Grid.Row="1" Style="{StaticResource PageToolbarStyle}"><Border Style="{StaticResource PageCommandGroupStyle}"><CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/HomePageCommandBarManageMounts" loc:UserInterface.ResourceId="/Strings/HomePageCommandBarManageMounts"><AppBarButton Icon="Folder" Click="OpenMounts" x:Uid="/Strings/HomePageAppBarButtonManageMounts" loc:UserInterface.ResourceId="/Strings/HomePageAppBarButtonManageMounts"/></CommandBar></Border></Grid>
    <ScrollViewer x:Name="HomeScroll" Grid.Row="2" Margin="0,16,0,0">
    <StackPanel Spacing="24" HorizontalAlignment="Stretch">
      <Border Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/HomePageTextBlockOnDemandMountsAreReady" loc:UserInterface.ResourceId="/Strings/HomePageTextBlockOnDemandMountsAreReady"/>

        <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel></Border>
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="28" HorizontalAlignment="Left"/><TextBlock FontSize="18" FontWeight="SemiBold" x:Uid="/Strings/HomePageTextBlockCustomizeTheAppearance" loc:UserInterface.ResourceId="/Strings/HomePageTextBlockCustomizeTheAppearance"/><Border Style="{StaticResource PageCommandGroupStyle}"><CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/HomePageCommandBarOpenSettings" loc:UserInterface.ResourceId="/Strings/HomePageCommandBarOpenSettings"><AppBarButton Icon="Setting" Click="OpenSettings" x:Uid="/Strings/HomePageAppBarButtonOpenSettings" loc:UserInterface.ResourceId="/Strings/HomePageAppBarButtonOpenSettings"/></CommandBar></Border></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12"><FontIcon Glyph="&#xE8A5;" FontSize="28" HorizontalAlignment="Left"/><TextBlock FontSize="18" FontWeight="SemiBold" x:Uid="/Strings/HomePageTextBlockViewRuntimeRecords" loc:UserInterface.ResourceId="/Strings/HomePageTextBlockViewRuntimeRecords"/><Border Style="{StaticResource PageCommandGroupStyle}"><CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/HomePageCommandBarViewLogs" loc:UserInterface.ResourceId="/Strings/HomePageCommandBarViewLogs"><AppBarButton Icon="Document" Click="OpenLogs" x:Uid="/Strings/HomePageAppBarButtonViewLogs" loc:UserInterface.ResourceId="/Strings/HomePageAppBarButtonViewLogs"/></CommandBar></Border></StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer></Grid>
</Page>
