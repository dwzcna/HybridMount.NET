<Page xmlns:loc="using:HybridMount.UI" xmlns:helpers="using:HybridMount.UI" x:Class="HybridMount.Views.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:HybridMount.Controls" xmlns:views="using:HybridMount.Views.Windows">
  <Grid Style="{StaticResource SharedPageGridStyle}" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Style="{StaticResource PageTitleStyle}" x:Uid="/Strings/SettingsPageTextBlockSettings" loc:UserInterface.ResourceId="/Strings/SettingsPageTextBlockSettings"/>
    <ScrollViewer IsEnabled="{x:Bind ViewModel.CanEditSettings,Mode=OneWay}" x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
      <!-- 视口始终拉伸，单列将宽屏余量留在右侧；避免受限宽度内容被默认居中后偏移。 -->
      <Grid Padding="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.AppearanceMessage}">
            <StackPanel Spacing="16">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsPageTextBlockAppearance" loc:UserInterface.ResourceId="/Strings/SettingsPageTextBlockAppearance"/>
              <!-- 控件在可用列宽内缩小；宽屏仍保持原控件宽度和左侧对齐。 -->
              <Grid RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="300"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ComboBox HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.ThemeSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditAppearance, Mode=OneWay}" x:Uid="/Strings/SettingsPageComboBoxWindowTheme" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxWindowTheme">
                  <ComboBoxItem Tag="System" x:Uid="/Strings/SettingsPageComboBoxItemFollowSystem" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxItemFollowSystem"/><ComboBoxItem Tag="Light" x:Uid="/Strings/SettingsPageComboBoxItemLight" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxItemLight"/><ComboBoxItem Tag="Dark" x:Uid="/Strings/SettingsPageComboBoxItemDark" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxItemDark"/>
                </ComboBox>
                <ComboBox Grid.Row="1" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.BackdropSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditAppearance, Mode=OneWay}" x:Uid="/Strings/SettingsPageComboBoxWindowBackground" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxWindowBackground">
                  <ComboBoxItem Tag="None" x:Uid="/Strings/SettingsPageComboBoxItemNoMaterial" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxItemNoMaterial"/><ComboBoxItem Content="Mica" Tag="MicaBase"/><ComboBoxItem Content="Mica Alt" Tag="MicaAltBaseAlt"/><ComboBoxItem Content="Acrylic" Tag="AcrylicBase"/><ComboBoxItem Content="Thin Acrylic" Tag="AcrylicThin"/>
                </ComboBox>
                <ComboBox x:Name="DensityPicker" Grid.Row="2" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.DensitySelection,Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEditDensity,Mode=OneWay}" x:Uid="/Strings/SettingsPageComboBoxInterfaceDensity" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxInterfaceDensity">
                    <ComboBoxItem Tag="Comfortable" x:Uid="/Strings/SettingsPageComboBoxItemStandard" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxItemStandard"/><ComboBoxItem Tag="Compact" x:Uid="/Strings/SettingsPageComboBoxItemCompact" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxItemCompact"/>
                </ComboBox>
                <ComboBox Grid.Row="3" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.LanguageSelection,Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditLanguage,Mode=OneWay}" x:Uid="/Strings/SettingsPageComboBoxInterfaceLanguage" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxInterfaceLanguage">
                  <ComboBoxItem Tag="system" x:Uid="/Strings/SettingsPageComboBoxItemFollowSystem2" loc:UserInterface.ResourceId="/Strings/SettingsPageComboBoxItemFollowSystem2"/><ComboBoxItem Content="中文（中国）" Tag="zh-CN"/><ComboBoxItem Content="English (United States)" Tag="en-US"/><ComboBoxItem Content="中文（香港特別行政區）" Tag="zh-HK"/>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.StatusMessage}">
            <StackPanel Spacing="8">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsPageTextBlockStartupAndTray" loc:UserInterface.ResourceId="/Strings/SettingsPageTextBlockStartupAndTray"/>
              <controls:SettingRow IsCompact="True" x:Uid="/Strings/SettingsPageSettingRowHideToTheTrayWhenClosing" loc:UserInterface.ResourceId="/Strings/SettingsPageSettingRowHideToTheTrayWhenClosing"><ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTraySelection, Mode=TwoWay}" x:Uid="/Strings/SettingsPageToggleSwitchHideToTheTrayWhenClosing" loc:UserInterface.ResourceId="/Strings/SettingsPageToggleSwitchHideToTheTrayWhenClosing"/></controls:SettingRow>
              <controls:SettingRow IsCompact="True" Description="{x:Bind ViewModel.StartupDetail,Mode=OneWay}" x:Uid="/Strings/SettingsPageSettingRowStartAfterSigningInToWindows" loc:UserInterface.ResourceId="/Strings/SettingsPageSettingRowStartAfterSigningInToWindows"><ToggleSwitch IsOn="{x:Bind ViewModel.StartupSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditStartup, Mode=OneWay}" x:Uid="/Strings/SettingsPageToggleSwitchStartAfterSigningInToWindows" loc:UserInterface.ResourceId="/Strings/SettingsPageToggleSwitchStartAfterSigningInToWindows"/></controls:SettingRow>
              <helpers:SettingsActionPanel x:Name="StartupActions" Style="{StaticResource SettingsActionPanelStyle}">
                <Button x:Name="StartupSettingsButton" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenStartupSettings" x:Uid="/Strings/SettingsStartupSettings" loc:UserInterface.ResourceId="/Strings/SettingsStartupSettings">
                  <Grid ColumnSpacing="{StaticResource PageToolbarIconSpacing}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE713;" Style="{StaticResource SettingsActionIconStyle}"/><TextBlock Grid.Column="1" Style="{StaticResource SettingsActionTextStyle}" x:Uid="/Strings/SettingsStartupSettingsText" loc:UserInterface.ResourceId="/Strings/SettingsStartupSettingsText"/></Grid>
                </Button>
              </helpers:SettingsActionPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.CloudMessage}">
            <StackPanel Spacing="16">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsCloudHeading" loc:UserInterface.ResourceId="/Strings/SettingsCloudHeading"/>
              <TextBlock Text="{x:Bind ViewModel.CloudRecommendation,Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <NumberBox Value="{x:Bind ViewModel.CloudConcurrencyValue,Mode=TwoWay}" Minimum="1" Maximum="128" SmallChange="1" SpinButtonPlacementMode="Inline" IsEnabled="{x:Bind ViewModel.CanSaveCloud,Mode=OneWay}" HorizontalAlignment="Left" Width="280" x:Uid="/Strings/SettingsCloudInput" loc:UserInterface.ResourceId="/Strings/SettingsCloudInput"/>
              <helpers:SettingsActionPanel x:Name="CloudActions" Style="{StaticResource SettingsActionPanelStyle}">
                <Button x:Name="CloudSaveButton" Style="{StaticResource SettingsActionButtonStyle}" Click="SaveCloudConcurrency" IsEnabled="{x:Bind ViewModel.CanSaveCloud,Mode=OneWay}" x:Uid="/Strings/SettingsCloudSave" loc:UserInterface.ResourceId="/Strings/SettingsCloudSave">
                  <Grid ColumnSpacing="{StaticResource PageToolbarIconSpacing}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE74E;" Style="{StaticResource SettingsActionIconStyle}"/><TextBlock Grid.Column="1" Style="{StaticResource SettingsActionTextStyle}" x:Uid="/Strings/SettingsCloudSaveText" loc:UserInterface.ResourceId="/Strings/SettingsCloudSaveText"/></Grid>
                </Button>
              </helpers:SettingsActionPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.CacheMessage}">
            <StackPanel Spacing="16">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsPageTextBlockOfflineCache" loc:UserInterface.ResourceId="/Strings/SettingsPageTextBlockOfflineCache"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="320"/></Grid.ColumnDefinitions>
                <NumberBox Value="{x:Bind ViewModel.CacheLimitGiB, Mode=TwoWay}" Minimum="0" Maximum="1048576" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" x:Uid="/Strings/SettingsPageNumberBoxCacheSoftLimitGiBDisablesAutomatic" loc:UserInterface.ResourceId="/Strings/SettingsPageNumberBoxCacheSoftLimitGiBDisablesAutomatic"/>
              </Grid>
              <helpers:SettingsActionPanel x:Name="CacheActions" Style="{StaticResource SettingsActionPanelStyle}">
                <Button x:Name="CacheSaveButton" Style="{StaticResource SettingsActionButtonStyle}" Click="SaveCache" IsEnabled="{x:Bind ViewModel.CanEditCache,Mode=OneWay}" x:Uid="/Strings/SettingsCacheSave" loc:UserInterface.ResourceId="/Strings/SettingsCacheSave">
                  <Grid ColumnSpacing="{StaticResource PageToolbarIconSpacing}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE74E;" Style="{StaticResource SettingsActionIconStyle}"/><TextBlock Grid.Column="1" Style="{StaticResource SettingsActionTextStyle}" x:Uid="/Strings/SettingsCacheSaveText" loc:UserInterface.ResourceId="/Strings/SettingsCacheSaveText"/></Grid>
                </Button>
                <Button x:Name="CacheTrimButton" Style="{StaticResource SettingsActionButtonStyle}" Click="TrimCache" IsEnabled="{x:Bind ViewModel.CanEditCache,Mode=OneWay}" x:Uid="/Strings/SettingsCacheTrim" loc:UserInterface.ResourceId="/Strings/SettingsCacheTrim">
                  <Grid ColumnSpacing="{StaticResource PageToolbarIconSpacing}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE74D;" Style="{StaticResource SettingsActionIconStyle}"/><TextBlock Grid.Column="1" Style="{StaticResource SettingsActionTextStyle}" x:Uid="/Strings/SettingsCacheTrimText" loc:UserInterface.ResourceId="/Strings/SettingsCacheTrimText"/></Grid>
                </Button>
              </helpers:SettingsActionPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.ResetMessage}">
            <StackPanel Spacing="12">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsPageTextBlockReset" loc:UserInterface.ResourceId="/Strings/SettingsPageTextBlockReset"/>
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="/Strings/SettingsPageTextBlockClearSettingsLogsAndCachesFor" loc:UserInterface.ResourceId="/Strings/SettingsPageTextBlockClearSettingsLogsAndCachesFor"/>
              <helpers:SettingsActionPanel x:Name="ResetActions" Style="{StaticResource SettingsActionPanelStyle}">
                <Button x:Name="RemoveAllButton" Style="{StaticResource SettingsActionButtonStyle}" Click="RemoveAllMounts" IsEnabled="{x:Bind ViewModel.CanRemoveAll,Mode=OneWay}" x:Uid="/Strings/SettingsRemoveAll" loc:UserInterface.ResourceId="/Strings/SettingsRemoveAll">
                  <Grid ColumnSpacing="{StaticResource PageToolbarIconSpacing}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8CD;" Style="{StaticResource SettingsActionIconStyle}"/><TextBlock Grid.Column="1" Style="{StaticResource SettingsActionTextStyle}" x:Uid="/Strings/SettingsRemoveAllText" loc:UserInterface.ResourceId="/Strings/SettingsRemoveAllText"/></Grid>
                </Button>
                <Button x:Name="ResetSettingsButton" Style="{StaticResource SettingsActionButtonStyle}" Click="ResetSettings" IsEnabled="{x:Bind ViewModel.CanReset,Mode=OneWay}" x:Uid="/Strings/SettingsReset" loc:UserInterface.ResourceId="/Strings/SettingsReset">
                  <Grid ColumnSpacing="{StaticResource PageToolbarIconSpacing}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7A7;" Style="{StaticResource SettingsActionIconStyle}"/><TextBlock Grid.Column="1" Style="{StaticResource SettingsActionTextStyle}" x:Uid="/Strings/SettingsResetText" loc:UserInterface.ResourceId="/Strings/SettingsResetText"/></Grid>
                </Button>
              </helpers:SettingsActionPanel>
              <Button Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" Click="ShowRemovalTasks" IsEnabled="{x:Bind ViewModel.CanViewRemovalTasks,Mode=OneWay}" x:Uid="/Strings/RemoveAllTasks" loc:UserInterface.ResourceId="/Strings/RemoveAllTasks"/>
              <Button Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" Click="SearchExplorerEntries" IsEnabled="{x:Bind ViewModel.CanReset,Mode=OneWay}" x:Uid="/Strings/ExplorerEntrySearchButton" loc:UserInterface.ResourceId="/Strings/ExplorerEntrySearchButton"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
