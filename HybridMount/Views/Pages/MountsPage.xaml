<Page xmlns:loc="using:HybridMount.UI" xmlns:controls="using:HybridMount.Controls" xmlns:helpers="using:HybridMount.UI" x:Class="HybridMount.Views.Pages.MountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewmodels="using:HybridMount.ViewModels"
      xmlns:views="using:HybridMount.Views.Windows">
    <Grid helpers:PageMessagePresentation.Message="{x:Bind ViewModel.StatusMessage}" Style="{StaticResource SharedPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitleStyle}" x:Uid="/Strings/MountsPageTextBlockMount" loc:UserInterface.ResourceId="/Strings/MountsPageTextBlockMount"/>
            <InfoBar Grid.Row="2" Margin="0,12,0,0" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.HasRuntimeFailedMounts),Mode=OneWay}" IsOpen="{x:Bind ViewModel.HasRuntimeFailedMounts,Mode=OneWay}" IsClosable="False" Severity="Warning" x:Uid="/Strings/MountsPageInfoBarNativeBackendDisconnected" loc:UserInterface.ResourceId="/Strings/MountsPageInfoBarNativeBackendDisconnected">
                <InfoBar.ActionButton>
                    <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind ViewModel.ReconnectRuntimeFailedCommand}" x:Uid="/Strings/MountsPageButtonReconnectAll" loc:UserInterface.ResourceId="/Strings/MountsPageButtonReconnectAll"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Sync"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountsPageTextBlockReconnectAll" loc:UserInterface.ResourceId="/Strings/MountsPageTextBlockReconnectAll"/></StackPanel></Button>
                </InfoBar.ActionButton>
            </InfoBar>
            <Grid x:Name="MountToolbar" Grid.Row="1" Style="{StaticResource PageToolbarStyle}"><Border Style="{StaticResource PageCommandGroupStyle}"><CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/MountsPageCommandBarMountActions" loc:UserInterface.ResourceId="/Strings/MountsPageCommandBarMountActions">
                <AppBarButton x:Name="AddButton" IsEnabled="{x:Bind ViewModel.CanOpenDialog,Mode=OneWay}" Icon="Add" AccessKey="N" x:Uid="/Strings/MountsPageAddButton" loc:UserInterface.ResourceId="/Strings/MountsPageAddButton">
                    <AppBarButton.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="WebDAV" Command="{x:Bind ViewModel.CreateWebDavCommand}"/>
                        <MenuFlyoutItem Command="{x:Bind ViewModel.CreateS3Command}" x:Uid="/Strings/MountsPageMenuFlyoutItemS3ObjectStorage" loc:UserInterface.ResourceId="/Strings/MountsPageMenuFlyoutItemS3ObjectStorage"/>
                        <MenuFlyoutItem Command="{x:Bind ViewModel.CreateSynologyCommand}" x:Uid="/Strings/MountsPageMenuFlyoutItemSynologyNAS" loc:UserInterface.ResourceId="/Strings/MountsPageMenuFlyoutItemSynologyNAS"/>
                    </MenuFlyout></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="ExportButton" Icon="Save" AccessKey="E" Command="{x:Bind ViewModel.ExportConfigurationsCommand}" x:Uid="/Strings/MountsPageExportButton" loc:UserInterface.ResourceId="/Strings/MountsPageExportButton"/>
                <AppBarButton x:Name="ImportButton" Icon="OpenFile" AccessKey="I" Command="{x:Bind ViewModel.ImportConfigurationsCommand}" x:Uid="/Strings/MountsPageImportButton" loc:UserInterface.ResourceId="/Strings/MountsPageImportButton"/>
                <AppBarButton x:Name="RecoveryButton" Icon="Repair" AccessKey="R" Command="{x:Bind ViewModel.RecoverMountsCommand}" x:Uid="/Strings/MountsPageRecoveryButton" loc:UserInterface.ResourceId="/Strings/MountsPageRecoveryButton"/>
            </CommandBar></Border></Grid>
        <ListView x:Name="MountList" Grid.Row="3" Margin="0,16,0,0" ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="Single"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Uid="/Strings/MountsPageMountList" loc:UserInterface.ResourceId="/Strings/MountsPageMountList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource StretchListItemStyle}">
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MountListItemViewModel">
                    <controls:MountCard Item="{x:Bind}" ActionRequested="CardAction"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind helpers:TextVisibility.ForEmptyCount(ViewModel.Items.Count),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" x:Uid="/Strings/MountsPageTextBlockNoMountsYetSelectAddMount" loc:UserInterface.ResourceId="/Strings/MountsPageTextBlockNoMountsYetSelectAddMount"/>
    </Grid>
</Page>
