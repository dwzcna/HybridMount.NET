<Page xmlns:loc="using:HybridMount.UI" xmlns:helpers="using:HybridMount.UI" x:Class="HybridMount.Views.Pages.TasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:HybridMount.Views.Windows" xmlns:controls="using:HybridMount.Controls" xmlns:mounts="using:HybridMount.Models.Mounting" xmlns:vm="using:HybridMount.ViewModels" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <ResourceDictionary>
        <DataTemplate x:Key="JobResultTemplate" x:DataType="mounts:MountItemResult">
            <StackPanel Padding="8" Spacing="4">
                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap"/>
                <TextBlock loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="DisplayStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(Message),Mode=OneTime}"/>
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid helpers:PageLayout.FullWidth="True" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.StatusMessage}" Style="{StaticResource SharedPageGridStyle}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PageTitleStyle}" x:Uid="/Strings/TasksPageTextBlockTasks" loc:UserInterface.ResourceId="/Strings/TasksPageTextBlockTasks"/>
            <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="{x:Bind ViewModel.IssueViewTitle,Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.HasIssueFilter),Mode=OneWay}"/>
        <!-- 筛选始终靠左，动作靠右；筛选仅收起标签，动作使用系统溢出菜单。 -->
        <Grid x:Name="TaskToolbar" Grid.Row="1" Style="{StaticResource PageToolbarStyle}" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="TaskFilters" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <toolkit:Segmented Style="{StaticResource PageSegmentedStyle}" SelectedIndex="{x:Bind ViewModel.SelectedTaskFilter,Mode=TwoWay}" HorizontalAlignment="Left">
                    <toolkit:SegmentedItem x:Name="AllFilter" AccessKey="A" x:Uid="/Strings/TasksPageAllFilter" loc:UserInterface.ResourceId="/Strings/TasksPageAllFilter"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="AllApps"/><TextBlock x:Name="AllFilterLabel" VerticalAlignment="Center" x:Uid="/Strings/TasksPageAllFilterLabel" loc:UserInterface.ResourceId="/Strings/TasksPageAllFilterLabel"/></StackPanel></toolkit:SegmentedItem>
                    <toolkit:SegmentedItem x:Name="IssuesFilter" AccessKey="I" x:Uid="/Strings/TasksPageIssuesFilter" loc:UserInterface.ResourceId="/Strings/TasksPageIssuesFilter"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Important"/><TextBlock x:Name="IssuesFilterLabel" VerticalAlignment="Center" x:Uid="/Strings/TasksPageIssuesFilterLabel" loc:UserInterface.ResourceId="/Strings/TasksPageIssuesFilterLabel"/></StackPanel></toolkit:SegmentedItem>
                    <toolkit:SegmentedItem x:Name="ConflictsFilter" AccessKey="F" x:Uid="/Strings/TasksPageConflictsFilter" loc:UserInterface.ResourceId="/Strings/TasksPageConflictsFilter"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Switch"/><TextBlock x:Name="ConflictsFilterLabel" VerticalAlignment="Center" x:Uid="/Strings/TasksPageConflictsFilterLabel" loc:UserInterface.ResourceId="/Strings/TasksPageConflictsFilterLabel"/></StackPanel></toolkit:SegmentedItem>
                </toolkit:Segmented>
                <Border Style="{StaticResource PageCommandGroupStyle}" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.HasIssueFilter),Mode=OneWay}"><CommandBar x:Name="ClearFilterCommands" Style="{StaticResource PageCommandBarStyle}" IsDynamicOverflowEnabled="False" OverflowButtonVisibility="Collapsed" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.HasIssueFilter),Mode=OneWay}">
                    <AppBarButton Icon="Clear" Click="ClearIssueFilter" x:Uid="/Strings/TasksPageAppBarButtonAllMounts" loc:UserInterface.ResourceId="/Strings/TasksPageAppBarButtonAllMounts"/>
                </CommandBar></Border>
            </StackPanel>
            <Border Style="{StaticResource PageCommandGroupStyle}" Grid.Column="1"><CommandBar x:Name="TaskActions" HorizontalContentAlignment="Right" Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/TasksPageTaskActions" loc:UserInterface.ResourceId="/Strings/TasksPageTaskActions">
                <AppBarButton Icon="Cancel" AccessKey="C" Click="CancelJob" IsEnabled="{x:Bind ViewModel.CanCancelSelected,Mode=OneWay}" x:Uid="/Strings/TasksPageAppBarButtonCancelSelectedTask" loc:UserInterface.ResourceId="/Strings/TasksPageAppBarButtonCancelSelectedTask"/>
                <AppBarButton Icon="Help" AccessKey="X" Click="ResolveConflict" x:Uid="/Strings/TasksPageAppBarButtonResolveConflict" loc:UserInterface.ResourceId="/Strings/TasksPageAppBarButtonResolveConflict"/>
                <AppBarButton Icon="View" AccessKey="V" Click="ShowResults" x:Uid="/Strings/TasksPageAppBarButtonViewResults" loc:UserInterface.ResourceId="/Strings/TasksPageAppBarButtonViewResults"/>
                <AppBarButton Icon="Refresh" AccessKey="R" Click="RetryUpload" x:Uid="/Strings/TasksPageAppBarButtonRetrySelected" loc:UserInterface.ResourceId="/Strings/TasksPageAppBarButtonRetrySelected"/>
                <AppBarButton Icon="Sync" AccessKey="K" Click="RecheckRename" x:Uid="/Strings/TasksPageAppBarButtonCheckAgain" loc:UserInterface.ResourceId="/Strings/TasksPageAppBarButtonCheckAgain"/>
                <AppBarButton Icon="SaveLocal" AccessKey="S" Click="SaveUploadCopy" x:Uid="/Strings/TasksPageAppBarButtonSaveACopy" loc:UserInterface.ResourceId="/Strings/TasksPageAppBarButtonSaveACopy"/>
                <AppBarButton Icon="OpenFile" AccessKey="O" Click="OpenLocation" x:Uid="/Strings/TasksPageAppBarButtonOpenFileLocation" loc:UserInterface.ResourceId="/Strings/TasksPageAppBarButtonOpenFileLocation"/>
                <AppBarSeparator/>
                <controls:TaskHistoryButton BadgeGlyph="&#xF0B7;" AccessKey="H" Click="ClearCompleted" IsEnabled="{x:Bind ViewModel.CanClearCompleted,Mode=OneWay}" x:Uid="/Strings/TasksClearCompleted" loc:UserInterface.ResourceId="/Strings/TasksClearCompleted"/>
                <controls:TaskHistoryButton BadgeGlyph="&#xEA83;" Click="ClearFailed" IsEnabled="{x:Bind ViewModel.CanClearFailed,Mode=OneWay}" x:Uid="/Strings/TasksClearFailed" loc:UserInterface.ResourceId="/Strings/TasksClearFailed"/>
                <controls:TaskHistoryButton BadgeGlyph="&#xEA81;" Click="ClearAll" IsEnabled="{x:Bind ViewModel.CanClearAll,Mode=OneWay}" x:Uid="/Strings/TasksClearAll" loc:UserInterface.ResourceId="/Strings/TasksClearAll"/>
            </CommandBar></Border>
        </Grid>
        <ListView x:Name="JobList" Grid.Row="3" Margin="0,16,0,0" ItemsSource="{x:Bind ViewModel.Operations}" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Uid="/Strings/TasksPageJobList" loc:UserInterface.ResourceId="/Strings/TasksPageJobList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource StretchListItemStyle}">
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskListItemViewModel">
                    <!-- 与挂载卡片共用外框，分类仅用于筛选和状态文字。 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                    <Grid RowSpacing="4" ColumnSpacing="16" loc:UserInterface.Source="{x:Bind}" loc:UserInterface.ToolTipPath="IssueDetails">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                            <Run loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="MountName"/><Run Text="  "/><Run loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="CardOperation"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="CardSchedule" HorizontalAlignment="Right" loc:UserInterface.ToolTipPath="ProgressDetail"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind CardPath,Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind CardPath,Mode=OneWay}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="CardState" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Id,Mode=OneWay}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" x:Uid="/Strings/TasksPageTextBlockTaskID" loc:UserInterface.ResourceId="/Strings/TasksPageTextBlockTaskID"/>
                        <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{x:Bind ProgressPercent,Mode=OneWay}"/>
                    </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind helpers:TextVisibility.ForEmptyCount(ViewModel.Operations.Count),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" x:Uid="/Strings/TasksPageTextBlockNoTasksMatchTheCurrentFilters" loc:UserInterface.ResourceId="/Strings/TasksPageTextBlockNoTasksMatchTheCurrentFilters"/>
    </Grid>
</Page>
