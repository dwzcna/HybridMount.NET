<ContentDialog x:Class="HybridMount.Views.MountBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HybridMount.Views" Title="导出配置" PrimaryButtonText="导出" CloseButtonText="取消"
    DefaultButton="Primary" PrimaryButtonClick="Submit" Closing="OnClosing" Closed="OnClosed">
    <Grid MinWidth="480" MaxHeight="660">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UserControl x:Name="Form"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Spacing="12" Margin="0,0,0,12" Visibility="{x:Bind PasswordField.Visibility,Mode=OneWay}">
                <PasswordBox x:Name="PasswordField" Header="备份密码（可留空，设置时至少 8 个字符）"/>
                <PasswordBox x:Name="ConfirmPasswordField" Header="再次输入备份密码"/>
                <TextBlock Text="留空时无密码保护，任何获得备份的人均可读取其中的凭据。" TextWrapping="Wrap" MaxWidth="480" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <ListView x:Name="RowsList" Grid.Row="1" SelectionMode="None" MaxHeight="440" HorizontalContentAlignment="Stretch" AutomationProperties.Name="备份挂载配置列表">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:MountBackupRow">
                        <StackPanel Spacing="6" Padding="4,10">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Selected,Mode=TwoWay}" IsEnabled="{x:Bind CanSelect,Mode=OneWay}" Checked="SelectionChanged" Unchecked="SelectionChanged"/>
                            <TextBlock Text="{x:Bind SourceDisplay}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind OptionsDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind LocalPath,Mode=OneWay}" Header="本地目录" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="选择目录" VerticalAlignment="Bottom" Visibility="{x:Bind FolderButtonVisibility}" Tag="{x:Bind}" Click="ChooseFolder"/>
                            </Grid>
                            <TextBlock Text="{x:Bind Status,Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind views:TextVisibility.ForText(Status),Mode=OneWay}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid></UserControl>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind StatusBar.IsOpen,Mode=OneWay}" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" Severity="Informational" Title="配置备份"/>
        </ScrollViewer>
    </Grid>
</ContentDialog>
