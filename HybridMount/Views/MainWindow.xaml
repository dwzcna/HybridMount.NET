<?xml version="1.0" encoding="utf-8"?>
<Window xmlns:loc="using:HybridMount.Helpers.UI" x:Class="HybridMount.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:HybridMount.Models" Title="HybridMount.NET">
    <!-- 全局返回快捷键保留，但根容器不作为自动快捷键提示的悬停目标。 -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="NoneBackdropStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="HybridMount.NET" IsBackButtonVisible="True" IsBackButtonEnabled="False" IsPaneToggleButtonVisible="True">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/HybridMount.png" ShowAsMonochrome="False"/>
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" OpenPaneLength="240" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" loc:Ui.AutomationNameKey="Text_9BAE68040509">
            <NavigationView.MenuItems>
                <NavigationViewItem loc:Ui.ContentKey="Text_203C08E0D44A" Tag="{x:Bind models:ApplicationPage.Home}" loc:Ui.AutomationNameKey="Text_203C08E0D44A">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Ui.ContentKey="Text_6FC9C71CB14F" Tag="{x:Bind models:ApplicationPage.Mounts}" loc:Ui.AutomationNameKey="Text_6FC9C71CB14F">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="MapDrive" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Ui.ContentKey="Text_5253040DB864" Tag="{x:Bind models:ApplicationPage.Tasks}" loc:Ui.AutomationNameKey="Text_5253040DB864">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Ui.ContentKey="Text_7DBAC1C20F23" Tag="{x:Bind models:ApplicationPage.Logs}" loc:Ui.AutomationNameKey="Text_7DBAC1C20F23">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF120;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem loc:Ui.ContentKey="Text_DF3D58C7D84B" Tag="{x:Bind models:ApplicationPage.Settings}" loc:Ui.AutomationNameKey="Text_DF3D58C7D84B">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" >
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
        <StackPanel x:Name="IssueNotifications" Grid.Row="1" Spacing="8" Margin="24" MaxWidth="560" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <InfoBar x:Name="NotificationBar" Title="{x:Bind ViewModel.NotificationSource,Mode=OneWay}" Message="{x:Bind ViewModel.NotificationMessage,Mode=OneWay}" IsOpen="{x:Bind ViewModel.IsNotificationOpen,Mode=TwoWay}" Grid.Row="1" Margin="24" MaxWidth="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsClosable="True" />
    </Grid>
</Window>
