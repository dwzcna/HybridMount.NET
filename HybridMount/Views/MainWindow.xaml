<?xml version="1.0" encoding="utf-8"?>
<Window xmlns:loc="using:HybridMount.Helpers.UI" x:Class="HybridMount.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:HybridMount.Models" Title="HybridMount.NET">
    <!-- 全局返回快捷键保留，但根容器不作为自动快捷键提示的悬停目标。 -->
    <Grid x:Name="RootGrid" MinWidth="600" MinHeight="480" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="NoneBackdropStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="HybridMount.NET" IsBackButtonVisible="True" IsBackButtonEnabled="False" IsPaneToggleButtonVisible="True">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/HybridMount.png" ShowAsMonochrome="False"/>
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" OpenPaneLength="240" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" x:Uid="/Strings/MainWindowNavigation" loc:Ui.ResourceId="/Strings/MainWindowNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="{x:Bind models:ApplicationPage.Home}" x:Uid="/Strings/MainWindowNavigationViewItemHome" loc:Ui.ResourceId="/Strings/MainWindowNavigationViewItemHome">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="{x:Bind models:ApplicationPage.Mounts}" x:Uid="/Strings/MainWindowNavigationViewItemMount" loc:Ui.ResourceId="/Strings/MainWindowNavigationViewItemMount">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="MapDrive" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="{x:Bind models:ApplicationPage.Tasks}" x:Uid="/Strings/MainWindowNavigationViewItemTasks" loc:Ui.ResourceId="/Strings/MainWindowNavigationViewItemTasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="{x:Bind models:ApplicationPage.Logs}" x:Uid="/Strings/MainWindowNavigationViewItemLogs" loc:Ui.ResourceId="/Strings/MainWindowNavigationViewItemLogs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF120;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="{x:Bind models:ApplicationPage.Settings}" x:Uid="/Strings/MainWindowNavigationViewItemSettings" loc:Ui.ResourceId="/Strings/MainWindowNavigationViewItemSettings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" >
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
        <!-- 与参考主窗口一致，所有即时反馈叠放在内容右下角；长消息或多个渠道可在窗口内滚动。 -->
        <ScrollViewer x:Name="NotificationHost" Grid.Row="1" Margin="24" MaxWidth="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <InfoBar x:Name="IndexWarning" Style="{StaticResource InstantNotificationStyle}" IsOpen="False" Severity="Warning">
                    <InfoBar.ActionButton><Button x:Name="IndexSettingsButton" Click="GoToIndexSettings" Style="{StaticResource SubtleButtonStyle}"/></InfoBar.ActionButton>
                </InfoBar>
                <StackPanel x:Name="PageNotifications" Spacing="8"/>
                <StackPanel x:Name="IssueNotifications" Spacing="8"/>
                <InfoBar x:Name="NotificationBar" Style="{StaticResource InstantNotificationStyle}" Title="{x:Bind ViewModel.NotificationSource,Mode=OneWay}" Message="{x:Bind ViewModel.NotificationMessage,Mode=OneWay}" IsOpen="{x:Bind ViewModel.IsNotificationOpen,Mode=TwoWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
