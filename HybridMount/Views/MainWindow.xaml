<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HybridMount.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HybridMount.NET">
  <Grid x:Name="RootGrid">
    <Grid.Resources><Style x:Key="NoneBackdropStyle" TargetType="Grid"><Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" /></Style></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="HybridMount.NET" IsBackButtonVisible="False" IsPaneToggleButtonVisible="True">
      <TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/HybridMount.png" ShowAsMonochrome="False"/></TitleBar.IconSource>
      <TitleBar.Resources><ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" /></TitleBar.Resources>
    </TitleBar>
    <NavigationView x:Name="Navigation" Grid.Row="1" OpenPaneLength="240" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" AutomationProperties.Name="主导航">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="首页" Tag="Home" AutomationProperties.Name="首页"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="日志" Tag="Logs" AutomationProperties.Name="日志"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems><NavigationViewItem Content="设置" Tag="Settings" AutomationProperties.Name="设置"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
      <Frame x:Name="ContentFrame" />
    </NavigationView>
    <InfoBar x:Name="NotificationBar" Grid.Row="1" Margin="24" MaxWidth="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsClosable="True" />
  </Grid>
</Window>
