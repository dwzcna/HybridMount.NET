<ContentDialog x:Class="HybridMount.Views.MockMountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="模拟挂载" PrimaryButtonText="创建并连接" CloseButtonText="取消" DefaultButton="Primary" PrimaryButtonClick="CreateMount" Closing="OnClosing">
    <StackPanel Spacing="12" MinWidth="420">
        <UserControl x:Name="Form">
            <StackPanel Spacing="12">
                <TextBox x:Name="NameField" Header="名称" Text="模拟挂载"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PathField" Header="本地 NTFS 空目录" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="选择目录" VerticalAlignment="Bottom" Click="ChooseFolder"/>
                </Grid>
                <ToggleSwitch x:Name="AutoConnectField" Header="随程序启动连接" IsOn="True"/>
            </StackPanel>
        </UserControl>
        <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Title="无法创建挂载"/>
    </StackPanel>
</ContentDialog>
