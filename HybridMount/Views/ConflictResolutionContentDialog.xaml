<ContentDialog x:Class="HybridMount.Views.ConflictResolutionContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:HybridMount.Views"
    Title="{x:Bind ViewModel.ConflictTitle,Mode=OneWay}" PrimaryButtonText="使用本地覆盖远端" SecondaryButtonText="使用远端替换本地" CloseButtonText="稍后" DefaultButton="Close"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanResolveWithLocal,Mode=OneWay}" IsSecondaryButtonEnabled="{x:Bind ViewModel.CanResolveWithRemote,Mode=OneWay}"
    PrimaryButtonClick="UseLocal" SecondaryButtonClick="UseRemote">
    <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">820</x:Double></ContentDialog.Resources>
    <ScrollViewer MaxHeight="520" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" MinWidth="440" MaxWidth="720">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Spacing="8"><TextBlock Text="当前本地" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.ConflictLocalText,Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="当前远端" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.ConflictRemoteText,Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.ConflictBaselineText,Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <TextBlock Text="使用本地：冻结当前本地内容，按已确认的远端版本条件上传。使用远端：先在同步根外保存可恢复的本地备份，再用核验后的远端内容替换本地。任一端在确认后变化时会停止处理。" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind ViewModel.ConflictLocalRestriction,Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind views:TextVisibility.ForText(ViewModel.ConflictLocalRestriction),Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.ConflictRemoteRestriction,Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind views:TextVisibility.ForText(ViewModel.ConflictRemoteRestriction),Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.ConflictRecoveryText,Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind views:TextVisibility.ForText(ViewModel.ConflictRecoveryText),Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.ConflictStatus,Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <Button Content="重新核对" Click="RefreshComparison" IsEnabled="{x:Bind ViewModel.CanRefreshConflict,Mode=OneWay}"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
