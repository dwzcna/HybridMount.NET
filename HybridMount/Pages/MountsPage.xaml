<Page xmlns:controls="using:HybridMount.Controls" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Pages.MountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewmodels="using:HybridMount.ViewModels"
      xmlns:views="using:HybridMount.Views">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="挂载" Style="{ThemeResource TitleTextBlockStyle}"/>
        <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="12">
            <InfoBar IsOpen="{x:Bind ViewModel.HasRuntimeFailedMounts,Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="原生后台已断开" Message="已保留恢复记录。请先核对未确认结果，再重新连接受影响的挂载。">
                <InfoBar.ActionButton>
                    <Button Content="重新连接全部" Command="{x:Bind ViewModel.ReconnectRuntimeFailedCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddButton" ToolTipService.ToolTip="新增挂载">
                    <Button.Content>
                        <Grid>
                            <FontIcon Glyph="&#xEDA2;" />
                            <FontIcon Glyph="&#xF0B6;" />
                        </Grid>
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="WebDAV" Click="CreateWebDavMount"/>
                            <MenuFlyoutItem Text="WebDAV(HTTPS)" Click="CreateWebDavHttpsMount"/>
                            <MenuFlyoutItem Text="S3 对象存储" Click="CreateS3Mount"/>
                            <MenuFlyoutItem Text="群晖 NAS（Synology）" Click="CreateSynologyMount"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ExportButton" ToolTipService.ToolTip="导出配置" Click="ExportConfigurations">
                    <FontIcon Glyph="&#xE78C;" />
                </Button>
                <Button x:Name="ImportButton"  ToolTipService.ToolTip="导入配置" Click="ImportConfigurations">
                    <FontIcon Glyph="&#xEA52;" />
                </Button>
                <Button x:Name="RecoveryButton"  ToolTipService.ToolTip="遗留挂载" Click="RecoverOrphanedMounts">
                    <FontIcon Glyph="&#xF847;" />
                </Button>
            </StackPanel>
        </StackPanel>
        <ListView x:Name="MountList" Grid.Row="2" Margin="0,16,0,0" ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="Single" AutomationProperties.Name="挂载列表"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MountListItem">
                    <controls:MountCard Item="{x:Bind}" ActionRequested="CardAction"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <InfoBar Grid.Row="3" Margin="0,16,0,0" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="Informational" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
    </Grid>
</Page>
