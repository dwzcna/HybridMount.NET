<Page x:Class="HybridMount.Pages.MountsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mounts="using:HybridMount.Models.Mounting">
    <Page.Resources>
        <DataTemplate x:Key="JobResultTemplate" x:DataType="mounts:MountItemResult">
            <StackPanel Padding="6" Spacing="4">
                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="挂载" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="将内置模拟文件源显示为本地占位文件，打开时按需读取。" TextWrapping="Wrap"/>
        </StackPanel>
        <Expander Grid.Row="1" Header="新增挂载" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
                <TextBox x:Name="NameField" Header="名称" Text="模拟挂载"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathField" Header="本地 NTFS 空目录" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="选择目录" VerticalAlignment="Bottom" Click="ChooseFolder"/>
                </Grid>
                <ToggleSwitch x:Name="AutoConnectField" Header="随程序启动连接" IsOn="True"/>
                <Button Content="创建并连接" Click="CreateMount"/>
            </StackPanel>
        </Expander>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="打开目录" Click="OpenFolder"/>
                <Button Content="连接" Click="Connect"/>
                <Button Content="断开" Click="Disconnect"/>
                <Button Content="刷新" Click="RefreshMount"/>
                <Button Content="始终保留在设备上" Click="Keep"/>
                <Button Content="释放空间" Click="Release"/>
                <Button Content="移除挂载" Click="Remove"/>
            </StackPanel>
        </ScrollViewer>
        <ListView x:Name="MountList" Grid.Row="3" ItemsSource="{x:Bind ViewModel.Mounts}" SelectionMode="Single" AutomationProperties.Name="挂载列表">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="mounts:MountSnapshot">
                    <StackPanel Padding="8" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind Definition.Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Status}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Definition.LocalPath}" TextWrapping="Wrap"/>
                        <TextBlock Text="内置模拟" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="任务" FontWeight="SemiBold"/>
                <Button Content="取消选中任务" Click="CancelJob"/>
                <Button Content="查看结果" Click="ShowResults"/>
            </StackPanel>
            <ListView x:Name="JobList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Operations}" SelectionMode="Single" AutomationProperties.Name="挂载任务">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="mounts:MountOperationSnapshot">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind DisplayOperation}"/>
                                <TextBlock Text="{x:Bind DisplayState}"/>
                                <TextBlock Text="{x:Bind Completed}"/>
                                <TextBlock Text="/"/>
                                <TextBlock Text="{x:Bind Total}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Error}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <TextBlock Grid.Row="5" Text="{x:Bind ViewModel.Status,Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Page>
