<Page xmlns:loc="using:HybridMount.Helpers.UI" xmlns:controls="using:HybridMount.Controls" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Pages.MountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewmodels="using:HybridMount.ViewModels"
      xmlns:views="using:HybridMount.Views">
    <Grid Style="{StaticResource SharedPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock loc:Ui.TextKey="Text_6FC9C71CB14F" Style="{ThemeResource TitleTextBlockStyle}"/>
        <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="12">
            <InfoBar IsOpen="{x:Bind ViewModel.HasRuntimeFailedMounts,Mode=OneWay}" IsClosable="False" Severity="Warning"
                     loc:Ui.TitleKey="Text_70CCDAD8E77E" loc:Ui.MessageKey="Text_92B13F21F95E">
                <InfoBar.ActionButton>
                    <Button loc:Ui.AutomationNameKey="Text_335DD2ADA3E2" Command="{x:Bind ViewModel.ReconnectRuntimeFailedCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Sync"/><TextBlock loc:Ui.TextKey="Text_335DD2ADA3E2" VerticalAlignment="Center"/></StackPanel></Button>
                </InfoBar.ActionButton>
            </InfoBar>
            <CommandBar Style="{StaticResource PageCommandBarStyle}" loc:Ui.AutomationNameKey="Text_FAF3E262130E">
                <AppBarButton x:Name="AddButton" loc:Ui.ToolTipKey="Text_12E2E50738C5" loc:Ui.LabelKey="Text_12E2E50738C5" Icon="Add" AccessKey="N" loc:Ui.AutomationNameKey="Text_12E2E50738C5">
                    <AppBarButton.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="WebDAV" Click="CreateWebDavMount"/>
                        <MenuFlyoutItem Text="WebDAV(HTTPS)" Click="CreateWebDavHttpsMount"/>
                        <MenuFlyoutItem loc:Ui.TextKey="Text_F62DFC6C48E8" Click="CreateS3Mount"/>
                        <MenuFlyoutItem loc:Ui.TextKey="Text_A0E1ADC4B7E5" Click="CreateSynologyMount"/>
                    </MenuFlyout></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="ExportButton" loc:Ui.AutomationNameKey="Text_429EA3AF443D" loc:Ui.ToolTipKey="Text_429EA3AF443D" loc:Ui.LabelKey="Text_429EA3AF443D" Icon="Save" AccessKey="E" Click="ExportConfigurations"/>
                <AppBarButton x:Name="ImportButton" loc:Ui.AutomationNameKey="Text_B48B6518293A" loc:Ui.ToolTipKey="Text_B48B6518293A" loc:Ui.LabelKey="Text_B48B6518293A" Icon="OpenFile" AccessKey="I" Click="ImportConfigurations"/>
                <AppBarButton x:Name="RecoveryButton" loc:Ui.AutomationNameKey="Text_0F25BC7459AB" loc:Ui.ToolTipKey="Text_0F25BC7459AB" loc:Ui.LabelKey="Text_0F25BC7459AB" Icon="Repair" AccessKey="R" Click="RecoverOrphanedMounts"/>
            </CommandBar>
        </StackPanel>
        <ListView x:Name="MountList" Grid.Row="2" Margin="0,16,0,0" ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="Single" loc:Ui.AutomationNameKey="Text_9D25DF22DEE7"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MountListItem">
                    <controls:MountCard Item="{x:Bind}" ActionRequested="CardAction"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" loc:Ui.TextKey="Text_13F57F838028" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind helpers:TextVisibility.ForEmptyCount(ViewModel.Items.Count),Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
        <InfoBar Grid.Row="3" Margin="0,16,0,0" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
    </Grid>
</Page>
