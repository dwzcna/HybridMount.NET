<Page x:Class="HybridMount.Pages.MountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewmodels="using:HybridMount.ViewModels"
      xmlns:views="using:HybridMount.Views">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="挂载" Style="{ThemeResource TitleTextBlockStyle}"/>
        <StackPanel Grid.Row="1" Margin="0,16,0,0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddButton" Content="新增挂载">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="WebDAV" Click="CreateWebDavMount"/>
                        <MenuFlyoutItem Text="S3 对象存储" Click="CreateS3Mount"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="ExportButton" Content="导出配置" Click="ExportConfigurations"/>
            <Button x:Name="ImportButton" Content="导入配置" Click="ImportConfigurations"/>
        </StackPanel>
        <ListView x:Name="MountList" Grid.Row="2" Margin="0,16,0,0" ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="Single" AutomationProperties.Name="挂载列表"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MountListItem">
                    <views:MountCard Item="{x:Bind}" ActionRequested="CardAction"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Margin="0,16,0,0" Text="{x:Bind ViewModel.Status,Mode=OneWay}" TextWrapping="Wrap" MaxLines="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind views:TextVisibility.ForText(ViewModel.Status),Mode=OneWay}"/>
    </Grid>
</Page>
