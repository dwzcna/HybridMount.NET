<Page x:Class="HybridMount.Pages.MountsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mounts="using:HybridMount.Models.Mounting">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="挂载" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="打开时按需下载，连接后持续上传新增和修改。本地删除不删除远端。" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddButton" Content="新增挂载"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="WebDAV" Click="CreateWebDavMount"/><MenuFlyoutItem Text="S3 对象存储" Click="CreateS3Mount"/></MenuFlyout></Button.Flyout></Button>
            <Button x:Name="ExportButton" Content="导出配置" Click="ExportConfigurations"/>
            <Button x:Name="ImportButton" Content="导入配置" Click="ImportConfigurations"/>
        </StackPanel>
        <Grid x:Name="Workspace" Grid.Row="2" ColumnSpacing="16" RowSpacing="12" SizeChanged="WorkspaceSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="320"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition x:Name="DetailRow" Height="0"/></Grid.RowDefinitions>
            <ListView x:Name="MountList" ItemsSource="{x:Bind ViewModel.Mounts}" SelectionMode="Single" AutomationProperties.Name="挂载列表" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate><DataTemplate x:DataType="mounts:MountSnapshot">
                    <StackPanel Padding="8" Spacing="6">
                        <TextBlock Text="{x:Bind Definition.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Status}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Definition.LocalPath}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind SourceDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <Border x:Name="DetailsPanel" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptySelection" Text="选择一个挂载，查看连接、检测设置和操作。" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="DetailName" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailStatus" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailPath" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock x:Name="DetailSource" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailSummary" TextWrapping="Wrap"/>
                                <Expander x:Name="DiagnosticExpander" Header="完整诊断" HorizontalAlignment="Stretch" Visibility="Collapsed"><TextBlock x:Name="DetailDiagnostic" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
                            </StackPanel>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button x:Name="ConnectButton" Content="连接" Click="Connect" HorizontalAlignment="Stretch"/>
                                <Button x:Name="CancelConnectionButton" Grid.Column="1" Content="取消连接" Click="CancelConnection" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                                <Button x:Name="DisconnectButton" Grid.Column="1" Content="断开" Click="Disconnect" HorizontalAlignment="Stretch"/>
                                <Button x:Name="OpenButton" Grid.Row="1" Content="打开目录" Click="OpenFolder" HorizontalAlignment="Stretch"/>
                                <Button x:Name="CredentialsButton" Grid.Row="1" Grid.Column="1" Content="更新凭据" Click="UpdateCredentials" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Text="同步与显示" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UploadDescription" TextWrapping="Wrap"/>
                                <Button x:Name="ScanButton" Content="扫描本地改动" Click="ReviewUploadChanges"/>
                                <ToggleSwitch x:Name="ThumbnailsToggle" Header="缩略图（实验性）" Toggled="ThumbnailsChanged" IsEnabled="False"/>
                                <TextBlock x:Name="ThumbnailDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="RemoteControls" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="远端检测" FontWeight="SemiBold"/>
                                <ToggleSwitch x:Name="RemoteAutoToggle" Header="远端自动检测" Toggled="RemoteAutoChanged"/>
                                <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap"/>
                                <NumberBox x:Name="IncrementalInterval" Header="增量检测间隔（秒）" Minimum="10" Maximum="86400" Value="60" ValueChanged="IntervalChanged" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch"/>
                                <NumberBox x:Name="FullInterval" Header="完整对账间隔（秒）" Minimum="30" Maximum="604800" Value="300" ValueChanged="IntervalChanged" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch"/>
                                <Button x:Name="SaveIntervalsButton" Content="保存检测间隔" Click="SaveDetectionIntervals"/>
                                <TextBlock x:Name="SqsDescription" TextWrapping="Wrap"/>
                                <Button x:Name="SqsSettingsButton" Content="SQS 事件加速设置" Click="SqsSettings" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="文件与缓存" FontWeight="SemiBold"/>
                                <Button x:Name="RefreshButton" Content="刷新远端" Click="RefreshMount" HorizontalAlignment="Stretch"/>
                                <Button x:Name="KeepButton" Content="始终保留在设备上" Click="Keep" HorizontalAlignment="Stretch"/>
                                <Button x:Name="ReleaseButton" Content="释放空间" Click="Release" HorizontalAlignment="Stretch"/>
                                <TextBlock x:Name="RemovalNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <Button x:Name="RemoveButton" Content="移除挂载" Click="Remove" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status,Mode=OneWay}" TextWrapping="Wrap" MaxLines="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Page>
