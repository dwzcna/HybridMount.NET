<Page x:Class="HybridMount.Pages.TasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mounts="using:HybridMount.Models.Mounting">
    <Page.Resources>
        <DataTemplate x:Key="JobResultTemplate" x:DataType="mounts:MountItemResult">
            <StackPanel Padding="8" Spacing="4">
                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="任务" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="查看挂载操作的进度、取消请求和逐项结果。" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="取消选中任务" Click="CancelJob"/>
            <Button Content="查看结果" Click="ShowResults"/>
            <Button Content="重试上传" Click="RetryUpload"/>
            <Button Content="另存副本" Click="SaveUploadCopy"/>
        </StackPanel>
        <ListView x:Name="JobList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Operations}" SelectionMode="Single" AutomationProperties.Name="挂载任务">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="mounts:MountOperationSnapshot">
                    <StackPanel Padding="8" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind DisplayOperation}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind DisplayState}"/>
                            <TextBlock Text="{x:Bind ProgressText}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ItemPath}" TextWrapping="Wrap"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ProgressPercent}"/>
                        <TextBlock Text="{x:Bind Error}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status,Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Page>
