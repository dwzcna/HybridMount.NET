<Page x:Class="HybridMount.Pages.TasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:HybridMount.Views" xmlns:mounts="using:HybridMount.Models.Mounting">
    <Page.Resources>
        <DataTemplate x:Key="JobResultTemplate" x:DataType="mounts:MountItemResult">
            <StackPanel Padding="8" Spacing="4">
                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" Visibility="{x:Bind views:TextVisibility.ForText(Message),Mode=OneTime}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="任务" Style="{ThemeResource TitleTextBlockStyle}"/>
            <ToggleButton Content="同步问题" IsChecked="{x:Bind ViewModel.IssuesOnly,Mode=TwoWay}" VerticalAlignment="Center" ToolTipService.ToolTip="查看独立保存的未解决同步问题"/>
            <ToggleButton Content="冲突" IsChecked="{x:Bind ViewModel.ConflictsOnly,Mode=TwoWay}" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.IssueViewTitle,Mode=OneWay}" VerticalAlignment="Center" Visibility="{x:Bind views:TextVisibility.ForFlag(ViewModel.HasIssueFilter),Mode=OneWay}"/>
            <Button Content="全部挂载" Click="ClearIssueFilter" Visibility="{x:Bind views:TextVisibility.ForFlag(ViewModel.HasIssueFilter),Mode=OneWay}"/>
        </StackPanel>
        <Grid x:Name="Toolbar" Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="8" SizeChanged="ToolbarSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="取消选中任务" Click="CancelJob"/>
                <Button Content="处理冲突" Click="ResolveConflict"/>
                <Button Content="查看结果" Click="ShowResults"/>
                <Button Content="重试上传" Click="RetryUpload"/>
                <Button Content="另存副本" Click="SaveUploadCopy"/>
                <Button Content="打开所在位置" Click="OpenLocation"/>
            </StackPanel>
            <StackPanel x:Name="HistoryToolbar" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="清除已完成" Click="ClearCompleted" IsEnabled="{x:Bind ViewModel.CanClearCompleted,Mode=OneWay}" ToolTipService.ToolTip="清除成功完成的任务历史，保留其他任务及同步数据。"/>
                <Button Content="清除失败" Click="ClearFailed" IsEnabled="{x:Bind ViewModel.CanClearFailed,Mode=OneWay}" ToolTipService.ToolTip="清除失败及部分失败的任务历史，不删除文件或恢复数据。"/>
                <Button Content="清除所有" Click="ClearAll" IsEnabled="{x:Bind ViewModel.CanClearAll,Mode=OneWay}" ToolTipService.ToolTip="清除所有已结束任务；保留进行中、等待、冲突和结果待核对，不删除文件或恢复数据。"/>
            </StackPanel>
        </Grid>
        <ListView x:Name="JobList" Grid.Row="2" Margin="0,16,0,0" ItemsSource="{x:Bind ViewModel.Operations}" SelectionMode="Single" AutomationProperties.Name="挂载任务">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="mounts:MountOperationSnapshot">
                    <StackPanel Padding="8" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind DisplayOperation}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind DisplayState}"/>
                            <TextBlock Text="{x:Bind ProgressText}" ToolTipService.ToolTip="{x:Bind ProgressDetail}" AutomationProperties.HelpText="{x:Bind ProgressDetail}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind DisplayTarget}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind IssueTimeText}" Visibility="{x:Bind views:TextVisibility.ForText(IssueTimeText),Mode=OneTime}"/>
                        <TextBlock Text="{x:Bind IssueStage}" Visibility="{x:Bind views:TextVisibility.ForText(IssueStage),Mode=OneTime}"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ProgressPercent}"/>
                        <TextBlock Text="{x:Bind DisplayIssueReason}" TextWrapping="Wrap" Visibility="{x:Bind views:TextVisibility.ForText(DisplayIssueReason),Mode=OneTime}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Margin="0,16,0,0" Text="{x:Bind ViewModel.Status,Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind views:TextVisibility.ForText(ViewModel.Status),Mode=OneWay}"/>
    </Grid>
</Page>
