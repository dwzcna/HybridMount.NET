<Page xmlns:loc="using:HybridMount.Helpers.UI" x:Class="HybridMount.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource SharedPageGridStyle}"><ScrollViewer x:Name="HomeScroll">
    <StackPanel Spacing="24" HorizontalAlignment="Stretch">
      <StackPanel Orientation="Horizontal" Spacing="16"><Image Source="ms-appx:///Assets/HybridMount.png" Width="64" Height="64"/><StackPanel Spacing="8"><TextBlock Text="HybridMount.NET" Style="{ThemeResource TitleTextBlockStyle}"/></StackPanel></StackPanel>
      <Border Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12">
        <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/HomePageTextBlockOnDemandMountsAreReady" loc:Ui.ResourceId="/Strings/HomePageTextBlockOnDemandMountsAreReady"/>
        <CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/HomePageCommandBarManageMounts" loc:Ui.ResourceId="/Strings/HomePageCommandBarManageMounts"><AppBarButton Icon="Folder" Click="OpenMounts" x:Uid="/Strings/HomePageAppBarButtonManageMounts" loc:Ui.ResourceId="/Strings/HomePageAppBarButtonManageMounts"/></CommandBar>
        <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel></Border>
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="28" HorizontalAlignment="Left"/><TextBlock FontSize="18" FontWeight="SemiBold" x:Uid="/Strings/HomePageTextBlockCustomizeTheAppearance" loc:Ui.ResourceId="/Strings/HomePageTextBlockCustomizeTheAppearance"/><CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/HomePageCommandBarOpenSettings" loc:Ui.ResourceId="/Strings/HomePageCommandBarOpenSettings"><AppBarButton Icon="Setting" Click="OpenSettings" x:Uid="/Strings/HomePageAppBarButtonOpenSettings" loc:Ui.ResourceId="/Strings/HomePageAppBarButtonOpenSettings"/></CommandBar></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12"><FontIcon Glyph="&#xE8A5;" FontSize="28" HorizontalAlignment="Left"/><TextBlock FontSize="18" FontWeight="SemiBold" x:Uid="/Strings/HomePageTextBlockViewRuntimeRecords" loc:Ui.ResourceId="/Strings/HomePageTextBlockViewRuntimeRecords"/><CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/HomePageCommandBarViewLogs" loc:Ui.ResourceId="/Strings/HomePageCommandBarViewLogs"><AppBarButton Icon="Document" Click="OpenLogs" x:Uid="/Strings/HomePageAppBarButtonViewLogs" loc:Ui.ResourceId="/Strings/HomePageAppBarButtonViewLogs"/></CommandBar></StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer></Grid>
</Page>
