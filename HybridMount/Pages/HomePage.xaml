<Page xmlns:loc="using:HybridMount.Helpers.UI" x:Class="HybridMount.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource SharedPageGridStyle}"><ScrollViewer x:Name="HomeScroll">
    <StackPanel Spacing="24" HorizontalAlignment="Stretch">
      <StackPanel Orientation="Horizontal" Spacing="16"><Image Source="ms-appx:///Assets/HybridMount.png" Width="64" Height="64"/><StackPanel Spacing="8"><TextBlock Text="HybridMount.NET" Style="{ThemeResource TitleTextBlockStyle}"/></StackPanel></StackPanel>
      <Border Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12">
        <TextBlock loc:Ui.TextKey="Text_9299A5E47BB2" FontSize="20" FontWeight="SemiBold"/>
        <Button loc:Ui.ContentKey="Text_CC194E99AC16" Click="OpenMounts" Style="{StaticResource PageActionButtonStyle}"/>
        <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel></Border>
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="28" HorizontalAlignment="Left"/><TextBlock loc:Ui.TextKey="Text_1F5ECAC72EEE" FontSize="18" FontWeight="SemiBold"/><Button loc:Ui.ContentKey="Text_37AA6AD6A36D" Click="OpenSettings" Style="{StaticResource PageActionButtonStyle}"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="24"><StackPanel Spacing="12"><FontIcon Glyph="&#xE8A5;" FontSize="28" HorizontalAlignment="Left"/><TextBlock loc:Ui.TextKey="Text_FAB66225B551" FontSize="18" FontWeight="SemiBold"/><Button loc:Ui.ContentKey="Text_659875587949" Click="OpenLogs" Style="{StaticResource PageActionButtonStyle}"/></StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer></Grid>
</Page>
