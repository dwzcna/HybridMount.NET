<Page xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:HybridMount.Controls" xmlns:views="using:HybridMount.Views">
  <Grid Style="{StaticResource SharedPageGridStyle}" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" x:Uid="/Strings/SettingsPageTextBlockSettings" loc:Ui.ResourceId="/Strings/SettingsPageTextBlockSettings"/>
    <ScrollViewer IsEnabled="{x:Bind ViewModel.CanEditSettings,Mode=OneWay}" x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
      <!-- 视口始终拉伸，单列将宽屏余量留在右侧；避免受限宽度内容被默认居中后偏移。 -->
      <Grid Padding="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.AppearanceMessage}">
            <StackPanel Spacing="16">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsPageTextBlockAppearance" loc:Ui.ResourceId="/Strings/SettingsPageTextBlockAppearance"/>
              <!-- 控件在可用列宽内缩小；宽屏仍保持原控件宽度和左侧对齐。 -->
              <Grid RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="300"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ComboBox HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.ThemeSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditAppearance, Mode=OneWay}" x:Uid="/Strings/SettingsPageComboBoxWindowTheme" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxWindowTheme">
                  <ComboBoxItem Tag="System" x:Uid="/Strings/SettingsPageComboBoxItemFollowSystem" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxItemFollowSystem"/><ComboBoxItem Tag="Light" x:Uid="/Strings/SettingsPageComboBoxItemLight" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxItemLight"/><ComboBoxItem Tag="Dark" x:Uid="/Strings/SettingsPageComboBoxItemDark" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxItemDark"/>
                </ComboBox>
                <ComboBox Grid.Row="1" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.BackdropSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditAppearance, Mode=OneWay}" x:Uid="/Strings/SettingsPageComboBoxWindowBackground" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxWindowBackground">
                  <ComboBoxItem Tag="None" x:Uid="/Strings/SettingsPageComboBoxItemNoMaterial" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxItemNoMaterial"/><ComboBoxItem Content="Mica" Tag="MicaBase"/><ComboBoxItem Content="Mica Alt" Tag="MicaAltBaseAlt"/><ComboBoxItem Content="Acrylic" Tag="AcrylicBase"/><ComboBoxItem Content="Thin Acrylic" Tag="AcrylicThin"/>
                </ComboBox>
                <ComboBox Grid.Row="2" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.DensitySelection,Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditDensity,Mode=OneWay}" x:Uid="/Strings/SettingsPageComboBoxInterfaceDensity" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxInterfaceDensity">
                    <ComboBoxItem Tag="Comfortable" x:Uid="/Strings/SettingsPageComboBoxItemStandard" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxItemStandard"/><ComboBoxItem Tag="Compact" x:Uid="/Strings/SettingsPageComboBoxItemCompact" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxItemCompact"/>
                </ComboBox>
                <ComboBox Grid.Row="3" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.LanguageSelection,Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditLanguage,Mode=OneWay}" x:Uid="/Strings/SettingsPageComboBoxInterfaceLanguage" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxInterfaceLanguage">
                  <ComboBoxItem Tag="system" x:Uid="/Strings/SettingsPageComboBoxItemFollowSystem2" loc:Ui.ResourceId="/Strings/SettingsPageComboBoxItemFollowSystem2"/><ComboBoxItem Content="中文（中国）" Tag="zh-CN"/><ComboBoxItem Content="English (United States)" Tag="en-US"/><ComboBoxItem Content="中文（香港特別行政區）" Tag="zh-HK"/>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.StatusMessage}">
            <StackPanel Spacing="8">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsPageTextBlockStartupAndTray" loc:Ui.ResourceId="/Strings/SettingsPageTextBlockStartupAndTray"/>
              <controls:SettingRow IsCompact="True" x:Uid="/Strings/SettingsPageSettingRowHideToTheTrayWhenClosing" loc:Ui.ResourceId="/Strings/SettingsPageSettingRowHideToTheTrayWhenClosing"><ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTraySelection, Mode=TwoWay}" x:Uid="/Strings/SettingsPageToggleSwitchHideToTheTrayWhenClosing" loc:Ui.ResourceId="/Strings/SettingsPageToggleSwitchHideToTheTrayWhenClosing"/></controls:SettingRow>
              <controls:SettingRow IsCompact="True" Description="{x:Bind ViewModel.StartupDetail,Mode=OneWay}" x:Uid="/Strings/SettingsPageSettingRowStartAfterSigningInToWindows" loc:Ui.ResourceId="/Strings/SettingsPageSettingRowStartAfterSigningInToWindows"><ToggleSwitch IsOn="{x:Bind ViewModel.StartupSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditStartup, Mode=OneWay}" x:Uid="/Strings/SettingsPageToggleSwitchStartAfterSigningInToWindows" loc:Ui.ResourceId="/Strings/SettingsPageToggleSwitchStartAfterSigningInToWindows"/></controls:SettingRow>
              <CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/SettingsPageCommandBarOpenWindowsStartupSettings" loc:Ui.ResourceId="/Strings/SettingsPageCommandBarOpenWindowsStartupSettings"><AppBarButton Icon="Setting" Click="OpenStartupSettings" x:Uid="/Strings/SettingsPageAppBarButtonOpenWindowsStartupSettings" loc:Ui.ResourceId="/Strings/SettingsPageAppBarButtonOpenWindowsStartupSettings"/></CommandBar>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.CloudMessage}">
            <StackPanel Spacing="16">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsCloudHeading" loc:Ui.ResourceId="/Strings/SettingsCloudHeading"/>
              <TextBlock Text="{x:Bind ViewModel.CloudRecommendation,Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBox Text="{x:Bind ViewModel.CloudConcurrency,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" InputScope="Number" IsEnabled="{x:Bind ViewModel.CanSaveCloud,Mode=OneWay}" MaxLength="10" HorizontalAlignment="Left" Width="200" x:Uid="/Strings/SettingsCloudInput" loc:Ui.ResourceId="/Strings/SettingsCloudInput"/>
              <Button Style="{StaticResource SubtleButtonStyle}" IsEnabled="{x:Bind ViewModel.CanSaveCloud,Mode=OneWay}" Click="SaveCloudConcurrency" x:Uid="/Strings/SettingsCloudSave" loc:Ui.ResourceId="/Strings/SettingsCloudSave">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;"/><TextBlock x:Uid="/Strings/SettingsCloudSaveText" loc:Ui.ResourceId="/Strings/SettingsCloudSaveText"/></StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.CacheMessage}">
            <StackPanel Spacing="16">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsPageTextBlockOfflineCache" loc:Ui.ResourceId="/Strings/SettingsPageTextBlockOfflineCache"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="320"/></Grid.ColumnDefinitions>
                <NumberBox Value="{x:Bind ViewModel.CacheLimitGiB, Mode=TwoWay}" Minimum="0" Maximum="1048576" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" x:Uid="/Strings/SettingsPageNumberBoxCacheSoftLimitGiBDisablesAutomatic" loc:Ui.ResourceId="/Strings/SettingsPageNumberBoxCacheSoftLimitGiBDisablesAutomatic"/>
              </Grid>
              <CommandBar Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/SettingsPageCommandBarOfflineCache" loc:Ui.ResourceId="/Strings/SettingsPageCommandBarOfflineCache">
                <AppBarButton IsEnabled="{x:Bind ViewModel.CanEditCache, Mode=OneWay}" Icon="Save" Click="SaveCache" x:Uid="/Strings/SettingsPageAppBarButtonSaveLimit" loc:Ui.ResourceId="/Strings/SettingsPageAppBarButtonSaveLimit"/>
                <AppBarButton IsEnabled="{x:Bind ViewModel.CanEditCache, Mode=OneWay}" Icon="Delete" Click="TrimCache" x:Uid="/Strings/SettingsPageAppBarButtonCheckEvictionNow" loc:Ui.ResourceId="/Strings/SettingsPageAppBarButtonCheckEvictionNow"/>
              </CommandBar>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24" helpers:PageMessagePresentation.Message="{x:Bind ViewModel.ResetMessage}">
            <StackPanel Spacing="12">
              <TextBlock FontSize="20" FontWeight="SemiBold" x:Uid="/Strings/SettingsPageTextBlockReset" loc:Ui.ResourceId="/Strings/SettingsPageTextBlockReset"/>
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="/Strings/SettingsPageTextBlockClearSettingsLogsAndCachesFor" loc:Ui.ResourceId="/Strings/SettingsPageTextBlockClearSettingsLogsAndCachesFor"/>
              <CommandBar Style="{StaticResource PageCommandBarStyle}">
                <AppBarButton IsEnabled="{x:Bind ViewModel.CanReset,Mode=OneWay}" Icon="Undo" Click="ResetSettings" x:Uid="/Strings/SettingsPageAppBarButtonClearAllAppSettings" loc:Ui.ResourceId="/Strings/SettingsPageAppBarButtonClearAllAppSettings"/>
              </CommandBar>
              <Button Style="{StaticResource SubtleButtonStyle}" Click="SearchExplorerEntries" IsEnabled="{x:Bind ViewModel.CanReset,Mode=OneWay}" x:Uid="/Strings/ExplorerEntrySearchButton" loc:Ui.ResourceId="/Strings/ExplorerEntrySearchButton"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
