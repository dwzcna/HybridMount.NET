<Page xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:HybridMount.Controls" xmlns:views="using:HybridMount.Views">
  <Grid Style="{StaticResource SharedPageGridStyle}" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}"/>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
      <!-- 视口始终拉伸，单列将宽屏余量留在右侧；避免受限宽度内容被默认居中后偏移。 -->
      <Grid Padding="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource CardBorderStyle}" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold"/>
              <!-- 控件在可用列宽内缩小；宽屏仍保持原控件宽度和左侧对齐。 -->
              <Grid RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="300"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ComboBox Header="窗口主题" AutomationProperties.Name="窗口主题" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.ThemeSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditAppearance, Mode=OneWay}">
                  <ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/>
                </ComboBox>
                <ComboBox Grid.Row="1" Header="窗口背景" AutomationProperties.Name="窗口背景" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.BackdropSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditAppearance, Mode=OneWay}">
                  <ComboBoxItem Content="无材质" Tag="None"/><ComboBoxItem Content="Mica" Tag="MicaBase"/><ComboBoxItem Content="Mica Alt" Tag="MicaAltBaseAlt"/><ComboBoxItem Content="Acrylic" Tag="AcrylicBase"/><ComboBoxItem Content="Thin Acrylic" Tag="AcrylicThin"/>
                </ComboBox>
                <ComboBox Grid.Row="2" Header="界面密度" AutomationProperties.Name="界面密度" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.DensitySelection,Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditDensity,Mode=OneWay}">
                    <ComboBoxItem Content="标准" Tag="Comfortable"/><ComboBoxItem Content="紧凑" Tag="Compact"/>
                </ComboBox>
              </Grid>
              <InfoBar Message="{x:Bind ViewModel.AppearanceStatus,Mode=OneWay}" IsOpen="{x:Bind ViewModel.AppearanceMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.AppearanceMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.AppearanceMessage.IsOpen),Mode=OneWay}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="启动与托盘" FontSize="20" FontWeight="SemiBold"/>
              <controls:SettingRow Header="关闭窗口时隐藏到托盘"><ToggleSwitch AutomationProperties.Name="关闭窗口时隐藏到托盘" IsOn="{x:Bind ViewModel.CloseToTraySelection, Mode=TwoWay}"/></controls:SettingRow>
              <controls:SettingRow Header="登录 Windows 后启动"><ToggleSwitch AutomationProperties.Name="登录 Windows 后启动" IsOn="{x:Bind ViewModel.StartupSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditStartup, Mode=OneWay}"/></controls:SettingRow>
              <TextBlock Text="{x:Bind ViewModel.StartupDetail, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind helpers:TextVisibility.ForText(ViewModel.StartupDetail),Mode=OneWay}"/>
              <Button Content="打开 Windows 启动设置" Click="OpenStartupSettings" Style="{StaticResource PageActionButtonStyle}"/>
              <InfoBar Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="离线缓存" FontSize="20" FontWeight="SemiBold"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="320"/></Grid.ColumnDefinitions>
                <NumberBox Value="{x:Bind ViewModel.CacheLimitGiB, Mode=TwoWay}" Header="缓存软上限（GiB，0 关闭自动回收）" Minimum="0" Maximum="1048576" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8"><Button IsEnabled="{x:Bind ViewModel.CanEditCache, Mode=OneWay}" Content="保存上限" Click="SaveCache"/><Button IsEnabled="{x:Bind ViewModel.CanEditCache, Mode=OneWay}" Content="立即检查回收" Click="TrimCache"/></StackPanel>
              <InfoBar Message="{x:Bind ViewModel.CacheStatus,Mode=OneWay}" IsOpen="{x:Bind ViewModel.CacheMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.CacheMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.CacheMessage.IsOpen),Mode=OneWay}"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{x:Bind ViewModel.VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
