<?xml version="1.0" encoding="utf-8"?>
<Page xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Pages.LogsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:HybridMount.Views" xmlns:diagnostics="using:HybridMount.Models.Diagnostics" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <Grid helpers:PageMessagePresentation.Message="{x:Bind ViewModel.StatusMessage}" Style="{StaticResource SharedPageGridStyle}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" x:Uid="/Strings/LogsPageTextBlockLogs" loc:Ui.ResourceId="/Strings/LogsPageTextBlockLogs"/>
    <Grid x:Name="QueryHeader" Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="12" RowSpacing="8" SizeChanged="QueryHeaderSizeChanged">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="LogSearch" MinWidth="160" Text="{x:Bind ViewModel.Query,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AccessKey="Q" x:Uid="/Strings/LogsPageTextBoxSearchLogs" loc:Ui.ResourceId="/Strings/LogsPageTextBoxSearchLogs"/>
      <StackPanel x:Name="DateFilter" SizeChanged="DateFilterSizeChanged" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
        <DatePicker x:Name="SelectedDate" SelectedDate="{x:Bind ViewModel.SelectedDate,Mode=TwoWay}" x:Uid="/Strings/LogsPageSelectedDate" loc:Ui.ResourceId="/Strings/LogsPageSelectedDate"/>
        <Button Click="ClearDateClicked" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.HasSelectedDate),Mode=OneWay}" VerticalAlignment="Center" x:Uid="/Strings/LogsPageClearDate" loc:Ui.ResourceId="/Strings/LogsPageClearDate"><SymbolIcon Symbol="Clear"/></Button>
      </StackPanel>
    </Grid>
    <Grid x:Name="LogToolbar" Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <toolkit:Segmented x:Name="LogFilters" SelectedIndex="{x:Bind ViewModel.SelectedSeverityIndex,Mode=TwoWay}" HorizontalAlignment="Left">
        <toolkit:SegmentedItem x:Name="AllFilter" x:Uid="/Strings/LogsPageAllFilter" loc:Ui.ResourceId="/Strings/LogsPageAllFilter"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="AllApps"/><TextBlock x:Name="AllFilterLabel" VerticalAlignment="Center" x:Uid="/Strings/LogsPageAllFilterLabel" loc:Ui.ResourceId="/Strings/LogsPageAllFilterLabel"/></StackPanel></toolkit:SegmentedItem>
        <toolkit:SegmentedItem x:Name="InformationFilter" x:Uid="/Strings/LogsPageInformationFilter" loc:Ui.ResourceId="/Strings/LogsPageInformationFilter"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Message"/><TextBlock x:Name="InformationFilterLabel" VerticalAlignment="Center" x:Uid="/Strings/LogsPageInformationFilterLabel" loc:Ui.ResourceId="/Strings/LogsPageInformationFilterLabel"/></StackPanel></toolkit:SegmentedItem>
        <toolkit:SegmentedItem x:Name="WarningFilter" x:Uid="/Strings/LogsPageWarningFilter" loc:Ui.ResourceId="/Strings/LogsPageWarningFilter"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Important"/><TextBlock x:Name="WarningFilterLabel" VerticalAlignment="Center" x:Uid="/Strings/LogsPageWarningFilterLabel" loc:Ui.ResourceId="/Strings/LogsPageWarningFilterLabel"/></StackPanel></toolkit:SegmentedItem>
        <toolkit:SegmentedItem x:Name="ErrorFilter" x:Uid="/Strings/LogsPageErrorFilter" loc:Ui.ResourceId="/Strings/LogsPageErrorFilter"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Cancel"/><TextBlock x:Name="ErrorFilterLabel" VerticalAlignment="Center" x:Uid="/Strings/LogsPageErrorFilterLabel" loc:Ui.ResourceId="/Strings/LogsPageErrorFilterLabel"/></StackPanel></toolkit:SegmentedItem>
      </toolkit:Segmented>
      <CommandBar x:Name="LogActions" Grid.Column="1" HorizontalContentAlignment="Right" Style="{StaticResource PageCommandBarStyle}" x:Uid="/Strings/LogsPageCommandBarLogActions" loc:Ui.ResourceId="/Strings/LogsPageCommandBarLogActions">
        <AppBarButton Icon="Download" IsEnabled="{x:Bind ViewModel.CanLoadMore,Mode=OneWay}" Click="OlderClicked" x:Uid="/Strings/LogsPageAppBarButtonLoadEarlier" loc:Ui.ResourceId="/Strings/LogsPageAppBarButtonLoadEarlier"/>
        <AppBarButton Icon="Refresh" AccessKey="R" Click="RefreshClicked" x:Uid="/Strings/LogsPageAppBarButtonRefresh" loc:Ui.ResourceId="/Strings/LogsPageAppBarButtonRefresh"/>
        <AppBarButton Icon="Copy" AccessKey="C" Click="CopyClicked" x:Uid="/Strings/LogsPageAppBarButtonCopy" loc:Ui.ResourceId="/Strings/LogsPageAppBarButtonCopy"/>
        <AppBarButton Icon="Save" AccessKey="E" IsEnabled="{x:Bind ViewModel.CanInteract,Mode=OneWay}" Click="ExportClicked" x:Uid="/Strings/LogsPageAppBarButtonExport" loc:Ui.ResourceId="/Strings/LogsPageAppBarButtonExport"/>
        <AppBarButton Icon="Delete" AccessKey="D" IsEnabled="{x:Bind ViewModel.CanInteract,Mode=OneWay}" Click="ClearClicked" x:Uid="/Strings/LogsPageAppBarButtonClear" loc:Ui.ResourceId="/Strings/LogsPageAppBarButtonClear"/>
        <AppBarButton Icon="Document" AccessKey="L" Click="LifecycleClicked" x:Uid="/Strings/LogsPageAppBarButtonLifecycleRecords" loc:Ui.ResourceId="/Strings/LogsPageAppBarButtonLifecycleRecords"/>
      </CommandBar>
    </Grid>
    <ListView x:Name="LogList" Grid.Row="3" Margin="0,16,0,0" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None" x:Uid="/Strings/LogsPageLogList" loc:Ui.ResourceId="/Strings/LogsPageLogList">
      <ListView.ItemTemplate><DataTemplate x:DataType="diagnostics:DiagnosticEntry"><Grid Padding="8" RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind DisplayTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind DisplaySeverity}"/><TextBlock Text="{x:Bind Source}" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Row="1" Text="{x:Bind Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <ProgressRing Grid.Row="3" IsActive="{x:Bind ViewModel.IsReading,Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.IsReading),Mode=OneWay}" x:Uid="/Strings/LogsPageProgressRingLoadingLogs" loc:Ui.ResourceId="/Strings/LogsPageProgressRingLoadingLogs"/>
    <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind helpers:TextVisibility.ForEmptyAndIdle(ViewModel.Entries.Count,ViewModel.IsReading),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" x:Uid="/Strings/LogsPageTextBlockNoLogsMatchTheCurrentFilters" loc:Ui.ResourceId="/Strings/LogsPageTextBlockNoLogsMatchTheCurrentFilters"/>
  </Grid>
</Page>
