<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="HybridMount.Pages.LogsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:diagnostics="using:HybridMount.Models.Diagnostics">
  <Grid Padding="28" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="6"><TextBlock Text="日志" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="查看本机运行记录和资源管理器菜单请求。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox PlaceholderText="搜索日志" Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索日志"/>
      <ComboBox x:Name="SeverityBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="SeverityChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="日志级别">
        <ComboBoxItem Content="全部级别" Tag="All"/><ComboBoxItem Content="信息" Tag="Information"/><ComboBoxItem Content="警告" Tag="Warning"/><ComboBoxItem Content="错误" Tag="Error"/>
      </ComboBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button Content="刷新" Click="RefreshClicked"/><Button Content="复制" Click="CopyClicked"/><Button IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" Content="导出" Click="ExportClicked"/><Button IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" Content="清除" Click="ClearClicked"/></StackPanel>
    </Grid>
    <ListView x:Name="LogList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None" AutomationProperties.Name="日志列表">
      <ListView.ItemTemplate><DataTemplate x:DataType="diagnostics:DiagnosticEntry"><Grid Padding="8" RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind DisplayTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind DisplaySeverity}"/><TextBlock Text="{x:Bind Source}" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Row="1" Text="{x:Bind Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
  </Grid>
</Page>
