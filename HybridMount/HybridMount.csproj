<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
		<RootNamespace>HybridMount</RootNamespace>
		<AssemblyName>HybridMount</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\HybridMount.ico</ApplicationIcon>
		<UseWinUI>true</UseWinUI>
        <DefaultLanguage>zh-CN</DefaultLanguage>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<WinUISDKReferences>false</WinUISDKReferences>
		<EnableMsixTooling>true</EnableMsixTooling>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
		<PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
		<PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<PublishTrimmed>false</PublishTrimmed>
		<PublishAot>false</PublishAot>
	</PropertyGroup>
	<Import Project="..\build\HybridMount.Packaging.targets" />
    <Import Project="..\build\HybridMount.ResourceValidation.targets" />
    <Target Name="CheckUiLocalization" BeforeTargets="BeforeBuild" DependsOnTargets="ValidateHybridMountResources" Condition="'$(DesignTimeBuild)' != 'true'" />
    <ItemGroup><EmbeddedResource Include="Resources\UiCatalog.json" LogicalName="HybridMount.Resources.UiCatalog.json" /></ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="AWSSDK.S3" />
		<PackageReference Include="AWSSDK.SQS" />
		<PackageReference Include="WebDAVClient" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="ThirdParty\**\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\HybridMount.Stock\bin\$(Platform)\$(Configuration)\HybridMount.Stock.exe" Condition="'$(DesignTimeBuild)' != 'true'" Link="HybridMount.Stock.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\zh-CN\HybridMount.Ext.resources.dll.mui" Link="zh-CN\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\en-US\HybridMount.Ext.resources.dll.mui" Link="en-US\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\zh-HK\HybridMount.Ext.resources.dll.mui" Link="zh-HK\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\HybridMount.Ext.resources.dll" Link="HybridMount.Ext.resources.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Manifest Include="$(ApplicationManifest)" />
		<Content Include="..\HybridMount.Ext\bin\$(Platform)\$(Configuration)\HybridMount.Ext.dll" Condition="'$(DesignTimeBuild)' != 'true'" Link="HybridMount.Ext.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
