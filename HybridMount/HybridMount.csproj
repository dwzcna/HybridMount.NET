<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>HybridMount</RootNamespace>
    <AssemblyName>HybridMount.NET</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HybridMount.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- VS 显式配置与命令行属性均可选择模式；输出隔离，避免交替调试污染缓存。 -->
    <Configurations>Debug;Release;DebugUnpackaged;ReleaseUnpackaged</Configurations>
    <HybridMountDeployment Condition="'$(HybridMountDeployment)' == '' and ('$(Configuration)' == 'DebugUnpackaged' or '$(Configuration)' == 'ReleaseUnpackaged' or '$(WindowsPackageType)' == 'None')">Unpackaged</HybridMountDeployment>
    <HybridMountDeployment Condition="'$(HybridMountDeployment)' == ''">Packaged</HybridMountDeployment>
    <WindowsPackageType Condition="'$(HybridMountDeployment)' == 'Unpackaged'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(HybridMountDeployment)' == 'Packaged'">MSIX</WindowsPackageType>
    <AppxPackage Condition="'$(HybridMountDeployment)' == 'Unpackaged'">false</AppxPackage>
    <AppxPackage Condition="'$(HybridMountDeployment)' == 'Packaged'">true</AppxPackage>
    <GenerateAppxPackageOnBuild Condition="'$(HybridMountDeployment)' == 'Unpackaged'">false</GenerateAppxPackageOnBuild>
    <OutputPath>bin\$(Platform)\$(Configuration)\$(HybridMountDeployment)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(HybridMountDeployment)\</IntermediateOutputPath>
    <NativeConfiguration Condition="'$(Configuration)' == 'DebugUnpackaged'">Debug</NativeConfiguration>
    <NativeConfiguration Condition="'$(Configuration)' == 'ReleaseUnpackaged'">Release</NativeConfiguration>
    <NativeConfiguration Condition="'$(NativeConfiguration)' == ''">$(Configuration)</NativeConfiguration>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DebugUnpackaged'">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize><DebugSymbols>true</DebugSymbols><DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseUnpackaged'">
    <Optimize>true</Optimize><DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK"/>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools"/>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="Microsoft.Data.Sqlite"/>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Assets\HybridMount.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Manifest Include="$(ApplicationManifest)"/>
    <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(NativeConfiguration)\HybridMount.Ext.dll" Condition="'$(DesignTimeBuild)' != 'true'" Link="HybridMount.Ext.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
