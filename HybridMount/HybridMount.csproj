<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>HybridMount</RootNamespace>
    <AssemblyName>HybridMount.NET</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HybridMount.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- VS 显式配置与命令行属性均可选择模式；输出隔离，避免交替调试污染缓存。 -->
    <Configurations>Debug;Release;DebugUnpackaged;ReleaseUnpackaged</Configurations>
    <HybridMountDeployment Condition="'$(HybridMountDeployment)' == '' and ('$(Configuration)' == 'DebugUnpackaged' or '$(Configuration)' == 'ReleaseUnpackaged' or '$(WindowsPackageType)' == 'None')">Unpackaged</HybridMountDeployment>
    <HybridMountDeployment Condition="'$(HybridMountDeployment)' == ''">Packaged</HybridMountDeployment>
    <WindowsPackageType Condition="'$(HybridMountDeployment)' == 'Unpackaged'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(HybridMountDeployment)' == 'Packaged'">MSIX</WindowsPackageType>
    <AppxPackage Condition="'$(HybridMountDeployment)' == 'Unpackaged'">false</AppxPackage>
    <AppxPackage Condition="'$(HybridMountDeployment)' == 'Packaged'">true</AppxPackage>
    <GenerateAppxPackageOnBuild Condition="'$(HybridMountDeployment)' == 'Unpackaged'">false</GenerateAppxPackageOnBuild>
    <OutputPath>bin\$(Platform)\$(Configuration)\$(HybridMountDeployment)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(HybridMountDeployment)\</IntermediateOutputPath>
    <NativeConfiguration Condition="'$(Configuration)' == 'DebugUnpackaged'">Debug</NativeConfiguration>
    <NativeConfiguration Condition="'$(Configuration)' == 'ReleaseUnpackaged'">Release</NativeConfiguration>
    <NativeConfiguration Condition="'$(NativeConfiguration)' == ''">$(Configuration)</NativeConfiguration>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DebugUnpackaged'">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize><DebugSymbols>true</DebugSymbols><DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseUnpackaged'">
    <Optimize>true</Optimize><DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK"/>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools"/>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="Microsoft.Data.Sqlite"/>
    <PackageReference Include="AWSSDK.S3"/><PackageReference Include="AWSSDK.SQS"/>
    <PackageReference Include="WebDAVClient"/>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="ThirdParty\**\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Assets\HybridMount.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Manifest Include="$(ApplicationManifest)"/>
    <Content Include="..\HybridMount.Ext\bin\$(Platform)\$(NativeConfiguration)\HybridMount.Ext.dll" Condition="'$(DesignTimeBuild)' != 'true'" Link="HybridMount.Ext.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <!-- 真实 EXE Shell 路径及其他类型回归通过前，正式包默认不接管云缩略图。 -->
  <PropertyGroup><HybridMountEnableCloudThumbnails Condition="'$(HybridMountEnableCloudThumbnails)'==''">false</HybridMountEnableCloudThumbnails></PropertyGroup>
  <!-- 源清单供 VS 包向导读取，必须与集中版本一致；构建副本仅切换实验扩展。 -->
  <Target Name="PrepareProductManifest" BeforeTargets="PrepareForBuild" Condition="'$(HybridMountDeployment)'=='Packaged'">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="_SourceManifestVersion"/>
    </XmlPeek>
    <Error Condition="'$(_SourceManifestVersion)' != '$(BinaryVersion)'"
           Text="Package.appxmanifest 版本 $(_SourceManifestVersion) 与集中版本 $(BinaryVersion) 不一致；请同步源清单，确保 Visual Studio 打包向导显示正确版本。" />
    <PropertyGroup>
      <_ProductManifest>$(IntermediateOutputPath)HybridMount.appxmanifest</_ProductManifest>
      <_ProductManifestContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Package.appxmanifest'))</_ProductManifestContent>
      <_ProductManifestContent Condition="'$(HybridMountEnableCloudThumbnails)'=='true'">$(_ProductManifestContent.Replace('&lt;!-- HYBRIDMOUNT_CLOUD_THUMBNAIL --&gt;', '&lt;desktop3:CustomStateHandler /&gt;&lt;desktop3:ThumbnailProviderHandler Clsid=&quot;A65802EB-4D1C-4C7E-A519-34C76B9BB281&quot; /&gt;&lt;desktop3:ExtendedPropertyHandler /&gt;&lt;desktop3:BannersHandler /&gt;&lt;desktop3:CloudFilesContextMenus /&gt;'))</_ProductManifestContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_ProductManifest)" Lines="$(_ProductManifestContent)" Overwrite="true" Encoding="UTF-8" WriteOnlyWhenDifferent="true" />
    <ItemGroup><AppxManifest Remove="@(AppxManifest)"/><AppxManifest Include="$(_ProductManifest)"/><FileWrites Include="$(_ProductManifest)"/></ItemGroup>
  </Target>
</Project>
