<UserControl x:Class="HybridMount.Controls.SettingRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:HybridMount.Helpers.UI" SizeChanged="Resized">
    <Grid x:Name="Row" Padding="0,10" ColumnSpacing="24" RowSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="TextHost" Spacing="4" VerticalAlignment="Center">
            <TextBlock x:Name="Label" Text="{x:Bind Header,Mode=OneWay}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind Description,Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind helpers:TextVisibility.ForText(Description),Mode=OneWay}"/>
        </StackPanel>
        <ContentPresenter x:Name="ValueHost" Grid.Column="1" Content="{x:Bind Setting,Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
