<ContentDialog xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.Mounting.WebDAVConfigurationContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:HybridMount.Views" xmlns:vm="using:HybridMount.ViewModels">
    <Grid MaxHeight="640" MinWidth="360" MaxWidth="520">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <UserControl x:Name="ConnectionFields"><StackPanel Spacing="12">
                    <TextBlock Text="连接配置" FontWeight="SemiBold"/>
                    <TextBox x:Name="NameField" Header="名称"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathField" Header="本地 NTFS 空目录" IsReadOnly="True"/>
                        <Button x:Name="ChooseButton" Grid.Column="1" Content="选择目录" VerticalAlignment="Bottom" Click="ChooseFolder"/>
                    </Grid>
                    <TextBox x:Name="EndpointField" Header="服务器地址"/>
                    <StackPanel x:Name="HttpsFields" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="群晖 WebDAV： https://nas.example.com:5006/共享文件夹/（需在 WebDAV Server 套件启用 HTTPS）。DSM 5001 请使用群晖 NAS 入口。" TextWrapping="Wrap"/>
                        <TextBox x:Name="CertificatePinField" Header="HTTPS 证书 SHA-256 指纹（可选）" PlaceholderText="留空使用系统证书验证"/>
                        <TextBlock Text="自签名证书需先通过可信渠道核对指纹后填写，仅信任当前挂载；证书更新后需重新核验。不要填写未经核对的指纹。" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="12">
                                    <TextBox x:Name="UserField" Header="账号"/>
                                    <PasswordBox x:Name="PasswordField" Header="密码或第三方应用密码"/>
                                </StackPanel>
                    <CheckBox x:Name="HttpField" Content="允许明文 HTTP（仅可信测试环境）"/>
                    <ToggleSwitch x:Name="AutoConnectField" Header="随程序启动连接" IsOn="True"/>
                </StackPanel></UserControl>
                <UserControl x:Name="ExclusionFields"><StackPanel Spacing="8">
                    <TextBlock Text="排除文件" FontWeight="SemiBold"/>
                    <ListView x:Name="ExclusionList" SelectionMode="None" MaxHeight="220" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:FileExclusionRuleDraft">
                            <Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind Enabled,Mode=TwoWay}" ToolTipService.ToolTip="启用规则" AutomationProperties.Name="启用规则"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{x:Bind MatchIndex,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="匹配方式"><x:String>包含</x:String><x:String>前缀</x:String><x:String>后缀</x:String></ComboBox>
                                <TextBox Grid.Column="2" Text="{x:Bind Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="255" PlaceholderText="文件名文本" AutomationProperties.Name="匹配文本"/>
                                <Button Grid.Column="3" Tag="{x:Bind}" Click="RemoveExclusionRule" Padding="6" ToolTipService.ToolTip="删除规则" AutomationProperties.Name="删除规则"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="添加规则" Click="AddExclusionRule"/>
                        <Button Content="添加默认规则" Click="AddDefaultExclusionRules"/>
                        <Button x:Name="SaveExclusionsButton" Content="保存排除规则" Click="SaveExclusions"/>
                    </StackPanel>
                </StackPanel></UserControl>
                <UserControl x:Name="SettingsFields" Visibility="Collapsed"><StackPanel Spacing="12">
                    <TextBlock Text="容量上限" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="CapacityAuto" Header="自动从服务器信息替代" Toggled="CapacityModeChanged"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MaximumField" Header="手动最大容量（留空不限）" TextChanged="CapacityTextChanged"/>
                        <ComboBox x:Name="CapacityUnit" Grid.Column="1" Header="单位" HorizontalAlignment="Stretch" SelectionChanged="CapacityUnitChanged"><x:String>GB</x:String><x:String>TB</x:String></ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="SaveCapacityButton" Click="SaveCapacity" HorizontalAlignment="Stretch"><TextBlock Text="保存容量设置" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                        <Button x:Name="RecheckButton" Grid.Column="1" Click="RecheckCapacity" HorizontalAlignment="Stretch"><TextBlock Text="从服务器抓取容量信息" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                    </Grid>
                    <TextBlock x:Name="CapacityDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(CapacityDescription.Text),Mode=OneWay}"/>
                    <TextBlock Text="同步与预览" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="ThumbnailToggle" Header="缩略图（实验性）" Toggled="ThumbnailChanged"/>
                    <TextBlock x:Name="ThumbnailDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(ThumbnailDescription.Text),Mode=OneWay}"/>
                    <ToggleSwitch x:Name="RemoteAuto" Header="远端自动检测(RFC 6578)" Toggled="RemoteAutoChanged"/>
                    <NumberBox x:Name="IncrementalField" Header="增量检测间隔（秒）" Minimum="10" Maximum="86400" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged"/>
                    <NumberBox x:Name="FullField" Header="完整对账间隔（秒）" Minimum="30" Maximum="604800" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged"/>
                    <Button x:Name="SaveIntervalsButton" Content="保存检测间隔" Click="SaveIntervals"/>
                    <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(DetectionDescription.Text),Mode=OneWay}"/>
                </StackPanel></UserControl>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind helpers:TextVisibility.ForFeedback(ProbeBar.IsOpen,ErrorBar.IsOpen,StatusText.Text),Mode=OneWay}" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <InfoBar x:Name="ProbeBar" Visibility="{x:Bind ProbeBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="False" Severity="Informational" Title="只读连接测试"/>
                <InfoBar x:Name="ErrorBar" Visibility="{x:Bind ErrorBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="False" Severity="Error" Title="未能完成操作"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(StatusText.Text),Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
