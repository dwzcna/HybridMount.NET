<ContentDialog xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.Mounting.WebDAVConfigurationContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:HybridMount.Controls" xmlns:views="using:HybridMount.Views" xmlns:vm="using:HybridMount.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <UserControl x:Name="ConnectionFields"><StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockConnectionSettings" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockConnectionSettings"/>
                    <TextBox x:Name="NameField" x:Uid="/Strings/WebDAVConfigurationContentDialogNameField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogNameField"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathField" IsReadOnly="True" x:Uid="/Strings/WebDAVConfigurationContentDialogPathField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogPathField"/>
                        <Button x:Name="ChooseButton" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseFolder" x:Uid="/Strings/WebDAVConfigurationContentDialogChooseButton" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogChooseButton"/>
                    </Grid>
                    <TextBox x:Name="EndpointField" x:Uid="/Strings/WebDAVConfigurationContentDialogEndpointField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogEndpointField"/>
                    <StackPanel x:Name="HttpsFields" Spacing="12" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockSynologyWebDAVHttpsNasExampleCom" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockSynologyWebDAVHttpsNasExampleCom"/>
                        <TextBox x:Name="CertificatePinField" x:Uid="/Strings/WebDAVConfigurationContentDialogCertificatePinField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogCertificatePinField"/>
                        <TextBlock TextWrapping="Wrap" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockForASelfSignedCertificateVerify" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockForASelfSignedCertificateVerify"/>
                    </StackPanel>
                    <StackPanel Spacing="12">
                                    <TextBox x:Name="UserField" x:Uid="/Strings/WebDAVConfigurationContentDialogUserField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogUserField"/>
                                    <PasswordBox x:Name="PasswordField" x:Uid="/Strings/WebDAVConfigurationContentDialogPasswordField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogPasswordField"/>
                                </StackPanel>
                    <CheckBox x:Name="HttpField" x:Uid="/Strings/WebDAVConfigurationContentDialogHttpField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogHttpField"/>
                    <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="HttpWarning" IsOpen="False" IsClosable="True" Severity="Warning" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(HttpWarning.IsOpen),Mode=OneWay}" x:Uid="/Strings/WebDAVConfigurationContentDialogHttpWarning" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogHttpWarning"/>
                    <controls:SettingRow x:Uid="/Strings/WebDAVConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts"><ToggleSwitch x:Name="AutoConnectField" IsOn="True" Toggled="AutoConnectChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogAutoConnectField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogAutoConnectField"/></controls:SettingRow>
                </StackPanel></UserControl>
                <Expander HorizontalAlignment="Stretch" x:Uid="/Strings/WebDAVConfigurationContentDialogExpanderExcludedFilesAdvanced" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogExpanderExcludedFilesAdvanced"><UserControl x:Name="ExclusionFields"><StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockExcludedFiles" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockExcludedFiles"/>
                    <ListView x:Name="ExclusionList" SelectionMode="None" MaxHeight="220" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:FileExclusionRuleDraft">
                            <Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" SelectedIndex="{x:Bind MatchIndex,Mode=TwoWay}" HorizontalAlignment="Stretch" x:Uid="/Strings/WebDAVConfigurationContentDialogComboBoxMatchMode" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogComboBoxMatchMode"><x:String>包含</x:String><x:String>前缀</x:String><x:String>后缀</x:String></ComboBox>
                                <TextBox Grid.Column="1" Text="{x:Bind Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="255" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBoxFileNameText" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBoxFileNameText"/>
                                <Button Grid.Column="2" Tag="{x:Bind}" Click="RemoveExclusionRule" Padding="6" x:Uid="/Strings/WebDAVConfigurationContentDialogButtonDeleteRule" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogButtonDeleteRule"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="AddExclusionRule" x:Uid="/Strings/WebDAVConfigurationContentDialogButtonAddRule" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogButtonAddRule"/>
                        <Button Click="AddDefaultExclusionRules" x:Uid="/Strings/WebDAVConfigurationContentDialogButtonAddDefaultRules" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogButtonAddDefaultRules"/>
                        <Button x:Name="SaveExclusionsButton" Click="SaveExclusions" x:Uid="/Strings/WebDAVConfigurationContentDialogSaveExclusionsButton" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogSaveExclusionsButton"/>
                    </StackPanel>
                </StackPanel></UserControl></Expander>
                <Expander HorizontalAlignment="Stretch" x:Uid="/Strings/WebDAVConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced"><UserControl x:Name="SettingsFields" Visibility="Collapsed"><StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockCapacityLimit" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockCapacityLimit"/>
                    <controls:SettingRow Visibility="{x:Bind CapacityAuto.Visibility,Mode=OneWay}" x:Uid="/Strings/WebDAVConfigurationContentDialogSettingRowUseServerCapacityInformationAutomatically" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogSettingRowUseServerCapacityInformationAutomatically"><ToggleSwitch x:Name="CapacityAuto" Toggled="CapacityModeChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogCapacityAuto" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogCapacityAuto"/></controls:SettingRow>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MaximumField" TextChanged="CapacityTextChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogMaximumField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogMaximumField"/>
                        <ComboBox x:Name="CapacityUnit" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="CapacityUnitChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogCapacityUnit" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogCapacityUnit"><x:String>GB</x:String><x:String>TB</x:String></ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="SaveCapacityButton" Click="SaveCapacity" HorizontalAlignment="Stretch"><TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockSaveCapacitySettings" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockSaveCapacitySettings"/></Button>
                        <Button x:Name="RecheckButton" Grid.Column="1" Click="RecheckCapacity" HorizontalAlignment="Stretch"><TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockFetchCapacityInformationFromServer" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockFetchCapacityInformationFromServer"/></Button>
                    </Grid>
                    <TextBlock x:Name="CapacityDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(CapacityDescription.Text),Mode=OneWay}"/>
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/WebDAVConfigurationContentDialogTextBlockSyncAndPreviews" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogTextBlockSyncAndPreviews"/>
                    <controls:SettingRow Visibility="{x:Bind ThumbnailToggle.Visibility,Mode=OneWay}" x:Uid="/Strings/WebDAVConfigurationContentDialogSettingRowThumbnailsExperimental" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogSettingRowThumbnailsExperimental"><ToggleSwitch x:Name="ThumbnailToggle" Toggled="ThumbnailChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogThumbnailToggle" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogThumbnailToggle"/></controls:SettingRow>
                    <TextBlock x:Name="ThumbnailDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(ThumbnailDescription.Text),Mode=OneWay}"/>
                    <controls:SettingRow x:Uid="/Strings/WebDAVConfigurationContentDialogSettingRowAutomaticRemoteDetectionRFC" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogSettingRowAutomaticRemoteDetectionRFC"><ToggleSwitch x:Name="RemoteAuto" Toggled="RemoteAutoChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogRemoteAuto" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogRemoteAuto"/></controls:SettingRow>
                    <NumberBox x:Name="IncrementalField" Minimum="10" Maximum="86400" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogIncrementalField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogIncrementalField"/>
                    <NumberBox x:Name="FullField" Minimum="30" Maximum="604800" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged" x:Uid="/Strings/WebDAVConfigurationContentDialogFullField" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogFullField"/>
                    <Button x:Name="SaveIntervalsButton" Click="SaveIntervals" x:Uid="/Strings/WebDAVConfigurationContentDialogSaveIntervalsButton" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogSaveIntervalsButton"/>
                    <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(DetectionDescription.Text),Mode=OneWay}"/>
                </StackPanel></UserControl></Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind helpers:TextVisibility.ForOpenFeedback(ProbeBar.IsOpen,ErrorBar.IsOpen,OperationBar.IsOpen),Mode=OneWay}" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ProbeBar" Visibility="{x:Bind ProbeBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Informational" x:Uid="/Strings/WebDAVConfigurationContentDialogProbeBar" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogProbeBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ErrorBar" Visibility="{x:Bind ErrorBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Error" x:Uid="/Strings/WebDAVConfigurationContentDialogErrorBar" loc:Ui.ResourceId="/Strings/WebDAVConfigurationContentDialogErrorBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="OperationBar" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
