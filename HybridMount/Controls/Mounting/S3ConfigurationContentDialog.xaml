<ContentDialog xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.Mounting.S3ConfigurationContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:HybridMount.Controls" xmlns:views="using:HybridMount.Views" xmlns:vm="using:HybridMount.ViewModels">
    <Grid MaxHeight="640" MinWidth="360" MaxWidth="520">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <UserControl x:Name="ConnectionFields"><StackPanel Spacing="12">
                    <TextBlock loc:Ui.TextKey="Text_E38AB48681DD" FontWeight="SemiBold"/>
                    <TextBox x:Name="NameField" loc:Ui.HeaderKey="Text_D44E9B3D3B31"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathField" loc:Ui.HeaderKey="Text_4BB83F1A69F9" IsReadOnly="True"/>
                        <Button x:Name="ChooseButton" Grid.Column="1" loc:Ui.ContentKey="Text_E5FE24CA742F" VerticalAlignment="Bottom" Click="ChooseFolder"/>
                    </Grid>
                    <TextBox x:Name="EndpointField" loc:Ui.HeaderKey="Text_D3716CC5A2F5"/>
                    <StackPanel Spacing="12">
                                    <TextBox x:Name="BucketField" loc:Ui.HeaderKey="Text_587ECDB3BA8F"/>
                                    <TextBox x:Name="PrefixField" loc:Ui.HeaderKey="Text_8BAA7CFDED0B"/>
                                    <TextBox x:Name="RegionField" loc:Ui.HeaderKey="Text_C60745B652A6" Text="us-east-1"/>
                                    <CheckBox x:Name="PathStyleField" loc:Ui.ContentKey="Text_C866EBEF00E6" IsChecked="True"/>
                                    <CheckBox x:Name="DefaultCredentialsField" loc:Ui.ContentKey="Text_E79E19D19A9D" Checked="CredentialsModeChanged" Unchecked="CredentialsModeChanged"/>
                                    <UserControl x:Name="S3Secrets"><StackPanel Spacing="12">
                                        <TextBox x:Name="AccessKeyField" Header="Access Key ID"/>
                                        <PasswordBox x:Name="SecretKeyField" Header="Secret Access Key"/>
                                        <PasswordBox x:Name="SessionTokenField" loc:Ui.HeaderKey="Text_DDA61DA868D8"/>
                                    </StackPanel></UserControl>
                                </StackPanel>
                    <CheckBox x:Name="HttpField" loc:Ui.ContentKey="Text_10D3BF1F23A3"/>
                    <InfoBar x:Name="HttpWarning" IsOpen="False" IsClosable="True" Severity="Warning" loc:Ui.TitleKey="Text_CB4488E8DBC2" loc:Ui.MessageKey="Text_3769CB3E7C40" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(HttpWarning.IsOpen),Mode=OneWay}"/>
                    <controls:SettingRow loc:Ui.HeaderKey="Text_499B2ECC88CD"><ToggleSwitch x:Name="AutoConnectField" IsOn="True" Toggled="AutoConnectChanged" loc:Ui.AutomationNameKey="Text_499B2ECC88CD"/></controls:SettingRow>
                </StackPanel></UserControl>
                <Expander loc:Ui.HeaderKey="Text_09C5BAC0EC82" HorizontalAlignment="Stretch"><UserControl x:Name="ExclusionFields"><StackPanel Spacing="8">
                    <TextBlock loc:Ui.TextKey="Text_F0986AB1A2C4" FontWeight="SemiBold"/>
                    <ListView x:Name="ExclusionList" SelectionMode="None" MaxHeight="220" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:FileExclusionRuleDraft">
                            <Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" SelectedIndex="{x:Bind MatchIndex,Mode=TwoWay}" HorizontalAlignment="Stretch" loc:Ui.AutomationNameKey="Text_E1F0F1CB1AB4"><x:String>包含</x:String><x:String>前缀</x:String><x:String>后缀</x:String></ComboBox>
                                <TextBox Grid.Column="1" Text="{x:Bind Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="255" loc:Ui.PlaceholderTextKey="Text_71668ADD2876" loc:Ui.AutomationNameKey="Text_05FC5419DE3F"/>
                                <Button Grid.Column="2" Tag="{x:Bind}" Click="RemoveExclusionRule" Padding="6" loc:Ui.ToolTipKey="Text_C02FDCF208B3" loc:Ui.AutomationNameKey="Text_C02FDCF208B3"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button loc:Ui.ContentKey="Text_C9F9E18B0623" Click="AddExclusionRule"/>
                        <Button loc:Ui.ContentKey="Text_AF0AD96CB324" Click="AddDefaultExclusionRules"/>
                        <Button x:Name="SaveExclusionsButton" loc:Ui.ContentKey="Text_6E5DDDF098FC" Click="SaveExclusions"/>
                    </StackPanel>
                </StackPanel></UserControl></Expander>
                <Expander loc:Ui.HeaderKey="Text_9A0F126A843B" HorizontalAlignment="Stretch"><UserControl x:Name="SettingsFields" Visibility="Collapsed"><StackPanel Spacing="12">
                    <TextBlock loc:Ui.TextKey="Text_3276C0F65EE8" FontWeight="SemiBold"/>
                    <controls:SettingRow loc:Ui.HeaderKey="Text_19BCEEEF8DE1" Visibility="{x:Bind CapacityAuto.Visibility,Mode=OneWay}"><ToggleSwitch x:Name="CapacityAuto" Toggled="CapacityModeChanged" loc:Ui.AutomationNameKey="Text_19BCEEEF8DE1"/></controls:SettingRow>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MaximumField" loc:Ui.HeaderKey="Text_27467832B606" TextChanged="CapacityTextChanged"/>
                        <ComboBox x:Name="CapacityUnit" Grid.Column="1" loc:Ui.HeaderKey="Text_80B19D68B149" HorizontalAlignment="Stretch" SelectionChanged="CapacityUnitChanged"><x:String>GB</x:String><x:String>TB</x:String></ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="SaveCapacityButton" Click="SaveCapacity" HorizontalAlignment="Stretch"><TextBlock loc:Ui.TextKey="Text_6B814AEC0BC3" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                        <Button x:Name="RecheckButton" Grid.Column="1" Click="RecheckCapacity" HorizontalAlignment="Stretch"><TextBlock loc:Ui.TextKey="Text_B6FD03C2DB1D" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                    </Grid>
                    <TextBlock x:Name="CapacityDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(CapacityDescription.Text),Mode=OneWay}"/>
                    <TextBlock loc:Ui.TextKey="Text_601740321114" FontWeight="SemiBold"/>
                    <controls:SettingRow loc:Ui.HeaderKey="Text_2556F45FAF22" Visibility="{x:Bind ThumbnailToggle.Visibility,Mode=OneWay}"><ToggleSwitch x:Name="ThumbnailToggle" Toggled="ThumbnailChanged" loc:Ui.AutomationNameKey="Text_2556F45FAF22"/></controls:SettingRow>
                    <TextBlock x:Name="ThumbnailDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(ThumbnailDescription.Text),Mode=OneWay}"/>
                    <controls:SettingRow loc:Ui.HeaderKey="Text_8084D978D651"><ToggleSwitch x:Name="RemoteAuto" Toggled="RemoteAutoChanged" loc:Ui.AutomationNameKey="Text_8084D978D651"/></controls:SettingRow>
                    <NumberBox x:Name="IncrementalField" loc:Ui.HeaderKey="Text_3CF3EBC61173" Minimum="10" Maximum="86400" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged"/>
                    <NumberBox x:Name="FullField" loc:Ui.HeaderKey="Text_750F712B33B8" Minimum="30" Maximum="604800" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged"/>
                    <Button x:Name="SaveIntervalsButton" loc:Ui.ContentKey="Text_B8826D711144" Click="SaveIntervals"/>
                    <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(DetectionDescription.Text),Mode=OneWay}"/>
                    <TextBlock x:Name="SqsDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(SqsDescription.Text),Mode=OneWay}"/>
                    <Expander loc:Ui.HeaderKey="Text_B64BD4615124" HorizontalAlignment="Stretch" IsExpanded="False">
                        <StackPanel Spacing="12">
                            <UserControl x:Name="SqsFields"><StackPanel Spacing="12">
                                <controls:SettingRow loc:Ui.HeaderKey="Text_01054FF40565"><ToggleSwitch x:Name="SqsEnabled" Toggled="SqsEnabledChanged" loc:Ui.AutomationNameKey="Text_01054FF40565"/></controls:SettingRow>
                                <TextBox x:Name="SqsUrl" Header="Standard Queue URL"/>
                                <TextBox x:Name="SqsRegion" loc:Ui.HeaderKey="Text_1CBD62ABD1B0"/>
                                <ComboBox x:Name="SqsMode" loc:Ui.HeaderKey="Text_E2012BC95CE4" HorizontalAlignment="Stretch" SelectionChanged="SqsCredentialsModeChanged">
                                    <x:String>明确复用 S3 凭据</x:String><x:String>SDK 默认凭据链</x:String><x:String>独立访问密钥</x:String>
                                </ComboBox>
                                <UserControl x:Name="SqsSecrets"><StackPanel Spacing="12">
                                    <TextBox x:Name="SqsAccessField" loc:Ui.HeaderKey="Text_FA89C102F166"/>
                                    <PasswordBox x:Name="SqsSecretField" loc:Ui.HeaderKey="Text_6439A5C466AB"/>
                                    <PasswordBox x:Name="SqsSessionField" loc:Ui.HeaderKey="Text_C25FEEEB96C6"/>
                                </StackPanel></UserControl>
                            </StackPanel></UserControl>
                            <Button x:Name="SqsTestButton" loc:Ui.ContentKey="Text_D76876D823BF" Click="TestSqs"/>
                            <Button x:Name="SqsSaveButton" loc:Ui.ContentKey="Text_ED1373DA607C" Click="SaveSqs"/>
                        </StackPanel>
                    </Expander>
                </StackPanel></UserControl></Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind helpers:TextVisibility.ForOpenFeedback(ProbeBar.IsOpen,ErrorBar.IsOpen,OperationBar.IsOpen),Mode=OneWay}" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <InfoBar x:Name="ProbeBar" Visibility="{x:Bind ProbeBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Informational" loc:Ui.TitleKey="Text_17D7F8B86E5F"/>
                <InfoBar x:Name="ErrorBar" Visibility="{x:Bind ErrorBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Error" loc:Ui.TitleKey="Text_73555A93A314"/>
                <InfoBar x:Name="OperationBar" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
