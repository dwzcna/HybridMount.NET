<ContentDialog xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.Mounting.S3ConfigurationContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:HybridMount.Controls" xmlns:views="using:HybridMount.Views" xmlns:vm="using:HybridMount.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <UserControl x:Name="ConnectionFields"><StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockConnectionSettings" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockConnectionSettings"/>
                    <TextBox x:Name="NameField" x:Uid="/Strings/S3ConfigurationContentDialogNameField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogNameField"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathField" IsReadOnly="True" x:Uid="/Strings/S3ConfigurationContentDialogPathField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogPathField"/>
                        <Button x:Name="ChooseButton" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseFolder" x:Uid="/Strings/S3ConfigurationContentDialogChooseButton" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogChooseButton"/>
                    </Grid>
                    <TextBox x:Name="EndpointField" x:Uid="/Strings/S3ConfigurationContentDialogEndpointField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogEndpointField"/>
                    <StackPanel Spacing="12">
                                    <TextBox x:Name="BucketField" x:Uid="/Strings/S3ConfigurationContentDialogBucketField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogBucketField"/>
                                    <TextBox x:Name="PrefixField" x:Uid="/Strings/S3ConfigurationContentDialogPrefixField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogPrefixField"/>
                                    <TextBox x:Name="RegionField" Text="us-east-1" x:Uid="/Strings/S3ConfigurationContentDialogRegionField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogRegionField"/>
                                    <CheckBox x:Name="PathStyleField" IsChecked="True" x:Uid="/Strings/S3ConfigurationContentDialogPathStyleField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogPathStyleField"/>
                                    <CheckBox x:Name="DefaultCredentialsField" Checked="CredentialsModeChanged" Unchecked="CredentialsModeChanged" x:Uid="/Strings/S3ConfigurationContentDialogDefaultCredentialsField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogDefaultCredentialsField"/>
                                    <UserControl x:Name="S3Secrets"><StackPanel Spacing="12">
                                        <TextBox x:Name="AccessKeyField" Header="Access Key ID"/>
                                        <PasswordBox x:Name="SecretKeyField" Header="Secret Access Key"/>
                                        <PasswordBox x:Name="SessionTokenField" x:Uid="/Strings/S3ConfigurationContentDialogSessionTokenField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSessionTokenField"/>
                                    </StackPanel></UserControl>
                                </StackPanel>
                    <CheckBox x:Name="HttpField" x:Uid="/Strings/S3ConfigurationContentDialogHttpField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogHttpField"/>
                    <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="HttpWarning" IsOpen="False" IsClosable="True" Severity="Warning" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(HttpWarning.IsOpen),Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogHttpWarning" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogHttpWarning"/>
                    <controls:SettingRow x:Uid="/Strings/S3ConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts"><ToggleSwitch x:Name="AutoConnectField" IsOn="True" Toggled="AutoConnectChanged" x:Uid="/Strings/S3ConfigurationContentDialogAutoConnectField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogAutoConnectField"/></controls:SettingRow>
                </StackPanel></UserControl>
                <Expander HorizontalAlignment="Stretch" x:Uid="/Strings/S3ConfigurationContentDialogExpanderExcludedFilesAdvanced" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogExpanderExcludedFilesAdvanced"><UserControl x:Name="ExclusionFields"><StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockExcludedFiles" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockExcludedFiles"/>
                    <ListView x:Name="ExclusionList" SelectionMode="None" MaxHeight="220" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:FileExclusionRuleDraft">
                            <Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" SelectedIndex="{x:Bind MatchIndex,Mode=TwoWay}" HorizontalAlignment="Stretch" x:Uid="/Strings/S3ConfigurationContentDialogComboBoxMatchMode" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogComboBoxMatchMode"><x:String>包含</x:String><x:String>前缀</x:String><x:String>后缀</x:String></ComboBox>
                                <TextBox Grid.Column="1" Text="{x:Bind Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="255" x:Uid="/Strings/S3ConfigurationContentDialogTextBoxFileNameText" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogTextBoxFileNameText"/>
                                <Button Grid.Column="2" Tag="{x:Bind}" Click="RemoveExclusionRule" Padding="6" x:Uid="/Strings/S3ConfigurationContentDialogButtonDeleteRule" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogButtonDeleteRule"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="AddExclusionRule" x:Uid="/Strings/S3ConfigurationContentDialogButtonAddRule" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogButtonAddRule"/>
                        <Button Click="AddDefaultExclusionRules" x:Uid="/Strings/S3ConfigurationContentDialogButtonAddDefaultRules" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogButtonAddDefaultRules"/>
                        <Button x:Name="SaveExclusionsButton" Click="SaveExclusions" x:Uid="/Strings/S3ConfigurationContentDialogSaveExclusionsButton" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSaveExclusionsButton"/>
                    </StackPanel>
                </StackPanel></UserControl></Expander>
                <Expander HorizontalAlignment="Stretch" x:Uid="/Strings/S3ConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced"><UserControl x:Name="SettingsFields" Visibility="Collapsed"><StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockCapacityLimit" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockCapacityLimit"/>
                    <controls:SettingRow Visibility="{x:Bind CapacityAuto.Visibility,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogSettingRowUseServerCapacityInformationAutomatically" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowUseServerCapacityInformationAutomatically"><ToggleSwitch x:Name="CapacityAuto" Toggled="CapacityModeChanged" x:Uid="/Strings/S3ConfigurationContentDialogCapacityAuto" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogCapacityAuto"/></controls:SettingRow>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MaximumField" TextChanged="CapacityTextChanged" x:Uid="/Strings/S3ConfigurationContentDialogMaximumField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogMaximumField"/>
                        <ComboBox x:Name="CapacityUnit" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="CapacityUnitChanged" x:Uid="/Strings/S3ConfigurationContentDialogCapacityUnit" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogCapacityUnit"><x:String>GB</x:String><x:String>TB</x:String></ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="SaveCapacityButton" Click="SaveCapacity" HorizontalAlignment="Stretch"><TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockSaveCapacitySettings" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockSaveCapacitySettings"/></Button>
                        <Button x:Name="RecheckButton" Grid.Column="1" Click="RecheckCapacity" HorizontalAlignment="Stretch"><TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockFetchCapacityInformationFromServer" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockFetchCapacityInformationFromServer"/></Button>
                    </Grid>
                    <TextBlock x:Name="CapacityDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(CapacityDescription.Text),Mode=OneWay}"/>
                    <TextBlock FontWeight="SemiBold" x:Uid="/Strings/S3ConfigurationContentDialogTextBlockSyncAndPreviews" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogTextBlockSyncAndPreviews"/>
                    <controls:SettingRow Visibility="{x:Bind ThumbnailToggle.Visibility,Mode=OneWay}" x:Uid="/Strings/S3ConfigurationContentDialogSettingRowThumbnailsExperimental" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowThumbnailsExperimental"><ToggleSwitch x:Name="ThumbnailToggle" Toggled="ThumbnailChanged" x:Uid="/Strings/S3ConfigurationContentDialogThumbnailToggle" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogThumbnailToggle"/></controls:SettingRow>
                    <TextBlock x:Name="ThumbnailDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(ThumbnailDescription.Text),Mode=OneWay}"/>
                    <controls:SettingRow x:Uid="/Strings/S3ConfigurationContentDialogSettingRowAutomaticRemoteDetection" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowAutomaticRemoteDetection"><ToggleSwitch x:Name="RemoteAuto" Toggled="RemoteAutoChanged" x:Uid="/Strings/S3ConfigurationContentDialogRemoteAuto" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogRemoteAuto"/></controls:SettingRow>
                    <NumberBox x:Name="IncrementalField" Minimum="10" Maximum="86400" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged" x:Uid="/Strings/S3ConfigurationContentDialogIncrementalField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogIncrementalField"/>
                    <NumberBox x:Name="FullField" Minimum="30" Maximum="604800" SpinButtonPlacementMode="Compact" ValueChanged="IntervalChanged" x:Uid="/Strings/S3ConfigurationContentDialogFullField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogFullField"/>
                    <Button x:Name="SaveIntervalsButton" Click="SaveIntervals" x:Uid="/Strings/S3ConfigurationContentDialogSaveIntervalsButton" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSaveIntervalsButton"/>
                    <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind helpers:TextVisibility.ForText(DetectionDescription.Text),Mode=OneWay}"/>
                    <TextBlock x:Name="SqsDescription" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(SqsDescription.Text),Mode=OneWay}"/>
                    <Expander HorizontalAlignment="Stretch" IsExpanded="False" x:Uid="/Strings/S3ConfigurationContentDialogExpanderSQSEventAccelerationSettings" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogExpanderSQSEventAccelerationSettings">
                        <StackPanel Spacing="12">
                            <UserControl x:Name="SqsFields"><StackPanel Spacing="12">
                                <controls:SettingRow x:Uid="/Strings/S3ConfigurationContentDialogSettingRowEnableSQSEventAcceleration" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSettingRowEnableSQSEventAcceleration"><ToggleSwitch x:Name="SqsEnabled" Toggled="SqsEnabledChanged" x:Uid="/Strings/S3ConfigurationContentDialogSqsEnabled" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSqsEnabled"/></controls:SettingRow>
                                <TextBox x:Name="SqsUrl" Header="Standard Queue URL"/>
                                <TextBox x:Name="SqsRegion" x:Uid="/Strings/S3ConfigurationContentDialogSqsRegion" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSqsRegion"/>
                                <ComboBox x:Name="SqsMode" HorizontalAlignment="Stretch" SelectionChanged="SqsCredentialsModeChanged" x:Uid="/Strings/S3ConfigurationContentDialogSqsMode" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSqsMode">
                                    <x:String>明确复用 S3 凭据</x:String><x:String>SDK 默认凭据链</x:String><x:String>独立访问密钥</x:String>
                                </ComboBox>
                                <UserControl x:Name="SqsSecrets"><StackPanel Spacing="12">
                                    <TextBox x:Name="SqsAccessField" x:Uid="/Strings/S3ConfigurationContentDialogSqsAccessField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSqsAccessField"/>
                                    <PasswordBox x:Name="SqsSecretField" x:Uid="/Strings/S3ConfigurationContentDialogSqsSecretField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSqsSecretField"/>
                                    <PasswordBox x:Name="SqsSessionField" x:Uid="/Strings/S3ConfigurationContentDialogSqsSessionField" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSqsSessionField"/>
                                </StackPanel></UserControl>
                            </StackPanel></UserControl>
                            <Button x:Name="SqsTestButton" Click="TestSqs" x:Uid="/Strings/S3ConfigurationContentDialogSqsTestButton" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSqsTestButton"/>
                            <Button x:Name="SqsSaveButton" Click="SaveSqs" x:Uid="/Strings/S3ConfigurationContentDialogSqsSaveButton" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogSqsSaveButton"/>
                        </StackPanel>
                    </Expander>
                </StackPanel></UserControl></Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind helpers:TextVisibility.ForOpenFeedback(ProbeBar.IsOpen,ErrorBar.IsOpen,OperationBar.IsOpen),Mode=OneWay}" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ProbeBar" Visibility="{x:Bind ProbeBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Informational" x:Uid="/Strings/S3ConfigurationContentDialogProbeBar" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogProbeBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ErrorBar" Visibility="{x:Bind ErrorBar.IsOpen,Mode=OneWay}" IsOpen="False" IsClosable="True" Severity="Error" x:Uid="/Strings/S3ConfigurationContentDialogErrorBar" loc:Ui.ResourceId="/Strings/S3ConfigurationContentDialogErrorBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="OperationBar" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
