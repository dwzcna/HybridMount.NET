<ContentDialog xmlns:loc="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.Mounting.SynologyConfigurationContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:HybridMount.Helpers.UI" xmlns:controls="using:HybridMount.Controls">
    <Grid MinWidth="360" MaxWidth="520" MaxHeight="640"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock TextWrapping="Wrap" x:Uid="/Strings/SynologyConfigurationContentDialogTextBlockThisReleaseSupportsReadingCreatingAnd" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogTextBlockThisReleaseSupportsReadingCreatingAnd"/>
            <UserControl x:Name="ConnectionFields"><StackPanel Spacing="12">
                    <TextBox x:Name="NameField" x:Uid="/Strings/SynologyConfigurationContentDialogNameField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogNameField"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathField" IsReadOnly="True" x:Uid="/Strings/SynologyConfigurationContentDialogPathField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogPathField"/>
                        <Button x:Name="ChooseButton" Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseFolder" x:Uid="/Strings/SynologyConfigurationContentDialogChooseButton" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogChooseButton"/>
                    </Grid>
                    <TextBox x:Name="EndpointField" PlaceholderText="https://nas.example.com:5001" TextChanged="EndpointChanged" x:Uid="/Strings/SynologyConfigurationContentDialogEndpointField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogEndpointField"/>
                    <CheckBox x:Name="HttpField" Checked="ConnectionChanged" Unchecked="ConnectionChanged" x:Uid="/Strings/SynologyConfigurationContentDialogHttpField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogHttpField"/>
                    <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="HttpWarning" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(HttpWarning.IsOpen),Mode=OneWay}" Severity="Warning" x:Uid="/Strings/SynologyConfigurationContentDialogHttpWarning" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogHttpWarning"/>
                    <TextBox x:Name="UserField" TextChanged="CredentialsChanged" x:Uid="/Strings/SynologyConfigurationContentDialogUserField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogUserField"/>
                    <PasswordBox x:Name="PasswordField" PasswordChanged="PasswordChanged" x:Uid="/Strings/SynologyConfigurationContentDialogPasswordField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogPasswordField"/>
                    <PasswordBox x:Name="OtpField" Visibility="Collapsed" x:Uid="/Strings/SynologyConfigurationContentDialogOtpField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogOtpField"/>
                    <TextBlock TextWrapping="Wrap" x:Uid="/Strings/SynologyConfigurationContentDialogTextBlockTestTheConnectionFirstToLoad" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogTextBlockTestTheConnectionFirstToLoad"/>
                    <ComboBox x:Name="ShareField" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ShareChanged" x:Uid="/Strings/SynologyConfigurationContentDialogShareField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogShareField"/>
                    <TextBox x:Name="SubfolderField" TextChanged="SubfolderChanged" x:Uid="/Strings/SynologyConfigurationContentDialogSubfolderField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogSubfolderField"/>
                    <TextBlock x:Name="PinText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <Button x:Name="ClearPinButton" Click="ClearPin" Visibility="Collapsed" x:Uid="/Strings/SynologyConfigurationContentDialogClearPinButton" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogClearPinButton"/>
                    <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="CertificateBar" IsOpen="False" IsClosable="False" Severity="Warning" x:Uid="/Strings/SynologyConfigurationContentDialogCertificateBar" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogCertificateBar">
                        <InfoBar.ActionButton><Button Click="TrustCertificate" x:Uid="/Strings/SynologyConfigurationContentDialogButtonFingerprintVerifiedTrustForThisMount" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogButtonFingerprintVerifiedTrustForThisMount"/></InfoBar.ActionButton>
                    </InfoBar>
                    <controls:SettingRow x:Uid="/Strings/SynologyConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogSettingRowConnectWhenTheApplicationStarts"><ToggleSwitch x:Name="AutoConnectField" IsOn="True" Toggled="AutoConnectChanged" x:Uid="/Strings/SynologyConfigurationContentDialogAutoConnectField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogAutoConnectField"/></controls:SettingRow>
                </StackPanel></UserControl>
                <Expander HorizontalAlignment="Stretch" x:Uid="/Strings/SynologyConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogExpanderSyncCapacityAndPreviewsAdvanced"><UserControl x:Name="SettingsFields"><StackPanel Spacing="12">
                    <controls:SettingRow x:Uid="/Strings/SynologyConfigurationContentDialogSettingRowAutomaticRemoteDetectionFullFolderPolling" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogSettingRowAutomaticRemoteDetectionFullFolderPolling"><ToggleSwitch x:Name="RemoteAuto" IsOn="True" Toggled="RemoteAutoChanged" x:Uid="/Strings/SynologyConfigurationContentDialogRemoteAuto" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogRemoteAuto"/></controls:SettingRow>
                    <NumberBox x:Name="IncrementalField" Minimum="10" Maximum="86400" Value="60" SpinButtonPlacementMode="Compact" x:Uid="/Strings/SynologyConfigurationContentDialogIncrementalField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogIncrementalField"/>
                    <NumberBox x:Name="FullField" Minimum="30" Maximum="604800" Value="300" SpinButtonPlacementMode="Compact" x:Uid="/Strings/SynologyConfigurationContentDialogFullField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogFullField"/>
                    <TextBlock TextWrapping="Wrap" x:Uid="/Strings/SynologyConfigurationContentDialogTextBlockSynologyDoesNotProvideAnIncremental" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogTextBlockSynologyDoesNotProvideAnIncremental"/>
                    <Button x:Name="SaveIntervalsButton" Click="SaveIntervals" Visibility="Collapsed" x:Uid="/Strings/SynologyConfigurationContentDialogSaveIntervalsButton" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogSaveIntervalsButton"/>
                    <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ExistingSettings" Spacing="12" Visibility="Collapsed">
                        <controls:SettingRow Visibility="{x:Bind CapacityAuto.Visibility,Mode=OneWay}" x:Uid="/Strings/SynologyConfigurationContentDialogSettingRowDetectVolumeCapacityAutomaticallyNotAccount" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogSettingRowDetectVolumeCapacityAutomaticallyNotAccount"><ToggleSwitch x:Name="CapacityAuto" Toggled="CapacityAutoChanged" x:Uid="/Strings/SynologyConfigurationContentDialogCapacityAuto" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogCapacityAuto"/></controls:SettingRow>
                        <TextBox x:Name="MaximumField" x:Uid="/Strings/SynologyConfigurationContentDialogMaximumField" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogMaximumField"/>
                        <Button x:Name="SaveCapacityButton" Click="SaveCapacity" x:Uid="/Strings/SynologyConfigurationContentDialogSaveCapacityButton" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogSaveCapacityButton"/>
                        <Button x:Name="RecheckButton" Click="RecheckCapacity" x:Uid="/Strings/SynologyConfigurationContentDialogRecheckButton" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogRecheckButton"/>
                        <TextBlock x:Name="CapacityDescription" TextWrapping="Wrap"/>
                        <controls:SettingRow Visibility="{x:Bind ThumbnailToggle.Visibility,Mode=OneWay}" x:Uid="/Strings/SynologyConfigurationContentDialogSettingRowThumbnailsExperimental" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogSettingRowThumbnailsExperimental"><ToggleSwitch x:Name="ThumbnailToggle" Toggled="SaveThumbnails" x:Uid="/Strings/SynologyConfigurationContentDialogThumbnailToggle" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogThumbnailToggle"/></controls:SettingRow>
                    </StackPanel>
                </StackPanel></UserControl></Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" MaxHeight="160" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind helpers:TextVisibility.ForOpenFeedback(ProbeBar.IsOpen,ErrorBar.IsOpen,OperationBar.IsOpen),Mode=OneWay}"><StackPanel Spacing="8">
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ProbeBar" IsOpen="False" IsClosable="True" x:Uid="/Strings/SynologyConfigurationContentDialogProbeBar" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogProbeBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" x:Uid="/Strings/SynologyConfigurationContentDialogErrorBar" loc:Ui.ResourceId="/Strings/SynologyConfigurationContentDialogErrorBar"/>
                <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="OperationBar" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
        </StackPanel></ScrollViewer>
    </Grid>
</ContentDialog>
