<ContentDialog xmlns:loc="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.Mounting.SynologyConfigurationContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:HybridMount.Helpers.UI" xmlns:controls="using:HybridMount.Controls">
    <Grid MinWidth="360" MaxWidth="520" MaxHeight="640"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock loc:Ui.TextKey="Text_8FD2EE522D59" TextWrapping="Wrap" />
            <UserControl x:Name="ConnectionFields"><StackPanel Spacing="12">
                    <TextBox x:Name="NameField" loc:Ui.HeaderKey="Text_D44E9B3D3B31"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathField" loc:Ui.HeaderKey="Text_4BB83F1A69F9" IsReadOnly="True"/>
                        <Button x:Name="ChooseButton" Grid.Column="1" loc:Ui.ContentKey="Text_E5FE24CA742F" VerticalAlignment="Bottom" Click="ChooseFolder"/>
                    </Grid>
                    <TextBox x:Name="EndpointField" loc:Ui.HeaderKey="Text_F745D52559D6" PlaceholderText="https://nas.example.com:5001" TextChanged="EndpointChanged"/>
                    <CheckBox x:Name="HttpField" loc:Ui.ContentKey="Text_75604CC8C1A4" Checked="ConnectionChanged" Unchecked="ConnectionChanged"/>
                    <InfoBar x:Name="HttpWarning" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(HttpWarning.IsOpen),Mode=OneWay}" Severity="Warning" loc:Ui.TitleKey="Text_B8B974267CBE" loc:Ui.MessageKey="Text_63116F299742"/>
                    <TextBox x:Name="UserField" loc:Ui.HeaderKey="Text_311BB313FDEC" TextChanged="CredentialsChanged"/>
                    <PasswordBox x:Name="PasswordField" loc:Ui.HeaderKey="Text_A621AB606DB2" PasswordChanged="PasswordChanged"/>
                    <PasswordBox x:Name="OtpField" loc:Ui.HeaderKey="Text_0A71879C4E40" Visibility="Collapsed"/>
                    <TextBlock loc:Ui.TextKey="Text_D8510A0D488B" TextWrapping="Wrap"/>
                    <ComboBox x:Name="ShareField" loc:Ui.HeaderKey="Text_8DF2FA80A06C" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ShareChanged"/>
                    <TextBox x:Name="SubfolderField" loc:Ui.HeaderKey="Text_DD44CB00BAD0" loc:Ui.PlaceholderTextKey="Text_E131031441CF" TextChanged="SubfolderChanged"/>
                    <TextBlock x:Name="PinText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <Button x:Name="ClearPinButton" loc:Ui.ContentKey="Text_1558E3701CFB" Click="ClearPin" Visibility="Collapsed"/>
                    <InfoBar x:Name="CertificateBar" IsOpen="False" IsClosable="False" Severity="Warning" loc:Ui.TitleKey="Text_7179375682A0">
                        <InfoBar.ActionButton><Button loc:Ui.ContentKey="Text_EDCD0FE3A86E" Click="TrustCertificate"/></InfoBar.ActionButton>
                    </InfoBar>
                    <controls:SettingRow loc:Ui.HeaderKey="Text_499B2ECC88CD"><ToggleSwitch x:Name="AutoConnectField" IsOn="True" Toggled="AutoConnectChanged" loc:Ui.AutomationNameKey="Text_499B2ECC88CD"/></controls:SettingRow>
                </StackPanel></UserControl>
                <Expander loc:Ui.HeaderKey="Text_9A0F126A843B" HorizontalAlignment="Stretch"><UserControl x:Name="SettingsFields"><StackPanel Spacing="12">
                    <controls:SettingRow loc:Ui.HeaderKey="Text_0B0898C3FDB7"><ToggleSwitch x:Name="RemoteAuto" IsOn="True" Toggled="RemoteAutoChanged" loc:Ui.AutomationNameKey="Text_0B0898C3FDB7"/></controls:SettingRow>
                    <NumberBox x:Name="IncrementalField" loc:Ui.HeaderKey="Text_9F2D27D64F39" Minimum="10" Maximum="86400" Value="60" SpinButtonPlacementMode="Compact"/>
                    <NumberBox x:Name="FullField" loc:Ui.HeaderKey="Text_750F712B33B8" Minimum="30" Maximum="604800" Value="300" SpinButtonPlacementMode="Compact"/>
                    <TextBlock loc:Ui.TextKey="Text_5148506BD02C" TextWrapping="Wrap"/>
                    <Button x:Name="SaveIntervalsButton" loc:Ui.ContentKey="Text_B85162F2AE16" Click="SaveIntervals" Visibility="Collapsed"/>
                    <TextBlock x:Name="DetectionDescription" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ExistingSettings" Spacing="12" Visibility="Collapsed">
                        <controls:SettingRow loc:Ui.HeaderKey="Text_7F8906AE1654" Visibility="{x:Bind CapacityAuto.Visibility,Mode=OneWay}"><ToggleSwitch x:Name="CapacityAuto" Toggled="CapacityAutoChanged" loc:Ui.AutomationNameKey="Text_7F8906AE1654"/></controls:SettingRow>
                        <TextBox x:Name="MaximumField" loc:Ui.HeaderKey="Text_B583ABBE6D7C"/>
                        <Button x:Name="SaveCapacityButton" loc:Ui.ContentKey="Text_6B814AEC0BC3" Click="SaveCapacity"/>
                        <Button x:Name="RecheckButton" loc:Ui.ContentKey="Text_B6FD03C2DB1D" Click="RecheckCapacity"/>
                        <TextBlock x:Name="CapacityDescription" TextWrapping="Wrap"/>
                        <controls:SettingRow loc:Ui.HeaderKey="Text_2556F45FAF22" Visibility="{x:Bind ThumbnailToggle.Visibility,Mode=OneWay}"><ToggleSwitch x:Name="ThumbnailToggle" Toggled="SaveThumbnails" loc:Ui.AutomationNameKey="Text_2556F45FAF22"/></controls:SettingRow>
                    </StackPanel>
                </StackPanel></UserControl></Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" MaxHeight="160" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind helpers:TextVisibility.ForOpenFeedback(ProbeBar.IsOpen,ErrorBar.IsOpen,OperationBar.IsOpen),Mode=OneWay}"><StackPanel Spacing="8">
                <InfoBar x:Name="ProbeBar" IsOpen="False" IsClosable="True" loc:Ui.TitleKey="Text_17D7F8B86E5F"/>
                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" loc:Ui.TitleKey="Text_73555A93A314"/>
                <InfoBar x:Name="OperationBar" Message="{x:Bind ViewModel.Status,Mode=OneWay}" IsOpen="{x:Bind ViewModel.StatusMessage.IsOpen,Mode=TwoWay}" IsClosable="True" Severity="{x:Bind helpers:PageMessagePresentation.Severity(ViewModel.StatusMessage.Severity),Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind helpers:TextVisibility.ForFlag(ViewModel.StatusMessage.IsOpen),Mode=OneWay}"/>
        </StackPanel></ScrollViewer>
    </Grid>
</ContentDialog>
