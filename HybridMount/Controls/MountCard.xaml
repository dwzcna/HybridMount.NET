<UserControl xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.MountCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HybridMount.Views"
             SizeChanged="CardSizeChanged">
    <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid x:Name="CardGrid" ColumnSpacing="16" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="CapacityColumn" Width="180"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="MountName" Grid.Row="0" Grid.Column="0"
                       Text="{x:Bind Item.Name,Mode=OneWay}" FontWeight="SemiBold" FontSize="18"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Item.Name,Mode=OneWay}"/>
            <TextBlock x:Name="MountPath" Grid.Row="1" Grid.Column="0"
                       Text="{x:Bind Item.SourceAndPath,Mode=OneWay}" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       ToolTipService.ToolTip="{x:Bind Item.SourceAndPath,Mode=OneWay}"/>
            <TextBlock x:Name="UsedCapacity" Grid.Row="0" Grid.Column="1"
                       Text="{x:Bind Item.UsedText,Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       ToolTipService.ToolTip="{x:Bind Item.CapacityDetails,Mode=OneWay}"/>
            <TextBlock x:Name="TotalCapacity" Grid.Row="1" Grid.Column="1"
                       Text="{x:Bind Item.TotalText,Mode=OneWay}" HorizontalAlignment="Right"
                       ToolTipService.ToolTip="{x:Bind Item.CapacityDetails,Mode=OneWay}"/>
            <Grid x:Name="ActionsHost" Grid.Row="2" Grid.Column="0" SizeChanged="ActionsSizeChanged">
                <Grid x:Name="StatusPanel" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Item.ConnectionGlyph,Mode=OneWay}" FontSize="16"
                              AutomationProperties.Name="{x:Bind Item.ConnectionStatus,Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Item.ConnectionStatus,Mode=OneWay}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Item.ConnectionStatus,Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <StackPanel x:Name="ActionsGrid" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <ToggleButton x:Name="ConnectionButton" Tag="connection" Height="32" Padding="8,4"
                                  IsChecked="{x:Bind Item.IsConnected,Mode=OneWay}" IsEnabled="{x:Bind Item.CanChangeConnection,Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind Item.ConnectionText,Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind Item.ConnectionText,Mode=OneWay}" Click="PerformAction">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind Item.ConnectionActionGlyph,Mode=OneWay}" FontSize="16"/><TextBlock Text="{x:Bind Item.ConnectionText,Mode=OneWay}" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <Button x:Name="SettingsButton" Tag="settings" Height="32" Padding="8,4"
                            IsEnabled="{x:Bind Item.CanEdit,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardSettingsButton" loc:Ui.ResourceId="/Strings/MountCardSettingsButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountCardTextBlockEditSettings" loc:Ui.ResourceId="/Strings/MountCardTextBlockEditSettings"/></StackPanel>
                    </Button>
                    <Border x:Name="ConnectionSeparator" Width="1" Height="18" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="ScanButton" Tag="scan" Height="32" Padding="8,4"
                            IsEnabled="{x:Bind Item.CanRun,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardScanButton" loc:Ui.ResourceId="/Strings/MountCardScanButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="16"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountCardTextBlockScanLocalChanges" loc:Ui.ResourceId="/Strings/MountCardTextBlockScanLocalChanges"/></StackPanel>
                    </Button>
                    <Button x:Name="DetectButton" Tag="refresh" Height="32" Padding="8,4"
                            IsEnabled="{x:Bind Item.CanRun,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardDetectButton" loc:Ui.ResourceId="/Strings/MountCardDetectButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="16"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountCardTextBlockManualRemoteDetection" loc:Ui.ResourceId="/Strings/MountCardTextBlockManualRemoteDetection"/></StackPanel>
                    </Button>
                    <Border x:Name="ManualSeparator" Width="1" Height="18" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="ThumbnailButton" Tag="thumbnails" Height="32" Padding="8,4"
                                  IsChecked="{x:Bind Item.ThumbnailsEnabled,Mode=OneWay}" IsEnabled="{x:Bind Item.CanEdit,Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind Item.ThumbnailText,Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.ThumbnailText,Mode=OneWay}" Click="PerformAction">
                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Pictures"/><TextBlock Text="{x:Bind Item.ThumbnailText,Mode=OneWay}" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="RemoteDetectionButton" Tag="remoteDetection" Height="32" Padding="8,4"
                                  IsChecked="{x:Bind Item.RemoteDetectionEnabled,Mode=OneWay}" IsEnabled="{x:Bind Item.CanEdit,Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind Item.DetectionText,Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.DetectionText,Mode=OneWay}" Click="PerformAction">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{x:Bind Item.DetectionText,Mode=OneWay}" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <Border x:Name="OptionsSeparator" Width="1" Height="18" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="KeepButton" Tag="keepOnDevice" Height="32" Padding="8,4"
                            IsEnabled="{x:Bind Item.CanRun,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardKeepButton" loc:Ui.ResourceId="/Strings/MountCardKeepButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE718;" FontSize="16"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountCardTextBlockAlwaysKeepOnDevice" loc:Ui.ResourceId="/Strings/MountCardTextBlockAlwaysKeepOnDevice"/></StackPanel>
                    </Button>
                    <Button x:Name="FreeButton" Tag="freeSpace" Height="32" Padding="8,4"
                            IsEnabled="{x:Bind Item.CanRun,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardFreeButton" loc:Ui.ResourceId="/Strings/MountCardFreeButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE753;" FontSize="16"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountCardTextBlockFreeUpSpace" loc:Ui.ResourceId="/Strings/MountCardTextBlockFreeUpSpace"/></StackPanel>
                    </Button>
                    <Button x:Name="CapacityButton" Tag="capacity" Height="32" Padding="8,4"
                            IsEnabled="{x:Bind Item.CanRecheck,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardCapacityButton" loc:Ui.ResourceId="/Strings/MountCardCapacityButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDA2;" FontSize="16"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountCardTextBlockRecheckCapacity" loc:Ui.ResourceId="/Strings/MountCardTextBlockRecheckCapacity"/></StackPanel>
                    </Button>
                    <Border x:Name="StorageSeparator" Width="1" Height="18" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="RemoveButton" Tag="remove" Height="32" Padding="8,4"
                            IsEnabled="{x:Bind Item.CanRemove,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Item.RemoveText,Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Item.RemoveText,Mode=OneWay}" Click="PerformAction">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="16"/><TextBlock Text="{x:Bind Item.RemoveText,Mode=OneWay}" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <DropDownButton x:Name="MoreButton" Width="48" Height="32" Padding="6" IsEnabled="{x:Bind Item.CanInspect,Mode=OneWay}" x:Uid="/Strings/MountCardMoreButton" loc:Ui.ResourceId="/Strings/MountCardMoreButton">
                        <FontIcon Glyph="&#xE712;" FontSize="16"/>
                        <DropDownButton.Flyout>
                            <MenuFlyout Opening="OverflowOpening">
                                <MenuFlyoutItem x:Name="ConnectionOverflow" Text="{x:Bind Item.ConnectionText,Mode=OneWay}" Tag="connection" IsEnabled="{x:Bind Item.CanChangeConnection,Mode=OneWay}" Click="PerformAction" Visibility="Collapsed">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind Item.ConnectionActionGlyph,Mode=OneWay}"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="SettingsOverflow" Tag="settings" IsEnabled="{x:Bind Item.CanEdit,Mode=OneWay}" Click="PerformAction" Visibility="Collapsed" x:Uid="/Strings/MountCardSettingsOverflow" loc:Ui.ResourceId="/Strings/MountCardSettingsOverflow">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="ConnectionOverflowSeparator" Visibility="Collapsed"/>
                                <MenuFlyoutItem x:Name="ScanOverflow" Tag="scan" IsEnabled="{x:Bind Item.CanRun,Mode=OneWay}" Click="PerformAction" Visibility="Collapsed" x:Uid="/Strings/MountCardScanOverflow" loc:Ui.ResourceId="/Strings/MountCardScanOverflow">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DetectOverflow" Tag="refresh" IsEnabled="{x:Bind Item.CanRun,Mode=OneWay}" Click="PerformAction" Visibility="Collapsed" x:Uid="/Strings/MountCardDetectOverflow" loc:Ui.ResourceId="/Strings/MountCardDetectOverflow">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="ManualOverflowSeparator" Visibility="Collapsed"/>
                                <ToggleMenuFlyoutItem x:Name="ThumbnailOverflow" Text="{x:Bind Item.ThumbnailText,Mode=OneWay}" Tag="thumbnails" IsChecked="{x:Bind Item.ThumbnailsEnabled,Mode=OneWay}" IsEnabled="{x:Bind Item.CanEdit,Mode=OneWay}" Click="PerformAction"/>
                                <ToggleMenuFlyoutItem x:Name="RemoteDetectionOverflow" Text="{x:Bind Item.DetectionText,Mode=OneWay}" Tag="remoteDetection" IsChecked="{x:Bind Item.RemoteDetectionEnabled,Mode=OneWay}" IsEnabled="{x:Bind Item.CanEdit,Mode=OneWay}" Click="PerformAction"/>
                                <MenuFlyoutSeparator x:Name="OverflowSeparator" Visibility="Collapsed"/>
                                <MenuFlyoutItem x:Name="KeepOverflow" Tag="keepOnDevice" IsEnabled="{x:Bind Item.CanRun,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardKeepOverflow" loc:Ui.ResourceId="/Strings/MountCardKeepOverflow">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="FreeOverflow" Tag="freeSpace" IsEnabled="{x:Bind Item.CanRun,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardFreeOverflow" loc:Ui.ResourceId="/Strings/MountCardFreeOverflow">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE753;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CapacityOverflow" Tag="capacity" IsEnabled="{x:Bind Item.CanRecheck,Mode=OneWay}" Click="PerformAction" x:Uid="/Strings/MountCardCapacityOverflow" loc:Ui.ResourceId="/Strings/MountCardCapacityOverflow">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDA2;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="StorageOverflowSeparator" Visibility="Collapsed"/>
                                <MenuFlyoutItem x:Name="RemoveOverflow" Text="{x:Bind Item.RemoveText,Mode=OneWay}" Tag="remove" IsEnabled="{x:Bind Item.CanRemove,Mode=OneWay}" Click="PerformAction">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="CapacityPercentage" Grid.Row="2" Grid.Column="1"
                       Text="{x:Bind Item.PercentageText,Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       ToolTipService.ToolTip="{x:Bind Item.CapacityDetails,Mode=OneWay}"/>
            <Border Grid.Column="2" Grid.RowSpan="3" BorderThickness="1,0,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="12,0,0,0">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button Tag="open" Click="PerformAction" IsEnabled="{x:Bind Item.CanOpen,Mode=OneWay}" Height="32" Padding="8,4" x:Uid="/Strings/MountCardButtonOpenFolder" loc:Ui.ResourceId="/Strings/MountCardButtonOpenFolder"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xED25;" FontSize="16"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountCardTextBlockOpenFolder" loc:Ui.ResourceId="/Strings/MountCardTextBlockOpenFolder"/></StackPanel></Button>
                    <Grid Grid.Row="2" Height="32">
                        <Button Tag="diagnostics" Click="PerformAction" IsEnabled="{x:Bind Item.CanInspect,Mode=OneWay}" Height="32" Padding="8,4" ToolTipService.ToolTip="{x:Bind Item.DiagnosticTooltip,Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.DiagnosticTooltip,Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="16"/><TextBlock VerticalAlignment="Center" x:Uid="/Strings/MountCardTextBlockDiagnostics" loc:Ui.ResourceId="/Strings/MountCardTextBlockDiagnostics"/></StackPanel>
                            <Button.ContextFlyout><MenuFlyout Opening="OverflowOpening"><MenuFlyoutItem Tag="fullDiagnostics" Click="PerformAction" x:Uid="/Strings/MountCardMenuFlyoutItemFullDiagnostics" loc:Ui.ResourceId="/Strings/MountCardMenuFlyoutItemFullDiagnostics"/></MenuFlyout></Button.ContextFlyout>
                        </Button>
                        <Border Background="{ThemeResource MountIssueBadgeBackgroundBrush}" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-6,0" MinWidth="14" Height="14" IsHitTestVisible="False" Visibility="{x:Bind helpers:TextVisibility.ForFlag(Item.HasUploadIssues),Mode=OneWay}">
                            <TextBlock Text="{x:Bind Item.IssueBadge,Mode=OneWay}" Foreground="{ThemeResource MountIssueBadgeForegroundBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
