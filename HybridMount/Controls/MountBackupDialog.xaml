<ContentDialog xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.MountBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HybridMount.ViewModels"
    DefaultButton="Primary" Loaded="OnLoaded" PrimaryButtonClick="Submit" Closing="OnClosing" Closed="OnClosed" x:Uid="/Strings/MountBackupDialogContentDialogExportConfiguration" loc:UserInterface.ResourceId="/Strings/MountBackupDialogContentDialogExportConfiguration">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UserControl x:Name="Form"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Spacing="12" Margin="0,0,0,12">
                <CheckBox x:Name="ProtectionToggle" IsChecked="False" Checked="ProtectionChanged" Unchecked="ProtectionChanged" x:Uid="/Strings/BackupProtectionToggle" loc:UserInterface.ResourceId="/Strings/BackupProtectionToggle"/>
                <TextBlock x:Name="UnprotectedNotice" TextWrapping="Wrap" MaxWidth="480" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="/Strings/BackupPlaintextNotice" loc:UserInterface.ResourceId="/Strings/BackupPlaintextNotice"/>
                <StackPanel x:Name="PasswordPanel" Spacing="12" Visibility="Collapsed">
                    <PasswordBox x:Name="PasswordField" PasswordChanged="PasswordChanged" x:Uid="/Strings/MountBackupDialogPasswordField" loc:UserInterface.ResourceId="/Strings/MountBackupDialogPasswordField"/>
                    <PasswordBox x:Name="ConfirmPasswordField" PasswordChanged="PasswordChanged" x:Uid="/Strings/MountBackupDialogConfirmPasswordField" loc:UserInterface.ResourceId="/Strings/MountBackupDialogConfirmPasswordField"/>
                    <TextBlock TextWrapping="Wrap" MaxWidth="480" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="/Strings/BackupProtectedNotice" loc:UserInterface.ResourceId="/Strings/BackupProtectedNotice"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ImportSelectionPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
                <ComboBox x:Name="ImportChoice" SelectedIndex="-1" HorizontalAlignment="Stretch" SelectionChanged="ImportChoiceChanged" x:Uid="/Strings/BackupImportChoice" loc:UserInterface.ResourceId="/Strings/BackupImportChoice">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="views:MountBackupRow">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/>
                                <TextBlock loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="SourceDisplay" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="ImportDetails" TextWrapping="Wrap"/>
            </StackPanel>
            <ListView x:Name="RowsList" Grid.Row="1" SelectionMode="None" MaxHeight="440" HorizontalContentAlignment="Stretch" x:Uid="/Strings/MountBackupDialogRowsList" loc:UserInterface.ResourceId="/Strings/MountBackupDialogRowsList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:MountBackupRow">
                        <StackPanel Spacing="6" Padding="4,10">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Selected,Mode=TwoWay}" IsEnabled="{x:Bind CanSelect,Mode=OneWay}" Checked="SelectionChanged" Unchecked="SelectionChanged"/>
                            <TextBlock loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="SourceDisplay" TextWrapping="Wrap"/>
                            <TextBlock loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="OptionsDisplay" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind LocalPath,Mode=OneWay}" IsReadOnly="True" x:Uid="/Strings/MountBackupDialogTextBoxLocalFolder" loc:UserInterface.ResourceId="/Strings/MountBackupDialogTextBoxLocalFolder"/>

                            </Grid>
                            <TextBlock loc:UserInterface.Source="{x:Bind}" loc:UserInterface.Path="StatusDisplay" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(Status),Mode=OneWay}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid></UserControl>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind StatusBar.IsOpen,Mode=OneWay}" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="StatusBar" IsOpen="False" IsClosable="False" Severity="Informational" x:Uid="/Strings/MountBackupDialogStatusBar" loc:UserInterface.ResourceId="/Strings/MountBackupDialogStatusBar"/>
        </ScrollViewer>
    </Grid>
</ContentDialog>
