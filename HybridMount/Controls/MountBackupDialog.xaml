<ContentDialog xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.MountBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HybridMount.ViewModels"
    DefaultButton="Primary" PrimaryButtonClick="Submit" Closing="OnClosing" Closed="OnClosed" x:Uid="/Strings/MountBackupDialogContentDialogExportConfiguration" loc:Ui.ResourceId="/Strings/MountBackupDialogContentDialogExportConfiguration">
    <Grid MinWidth="480" MaxHeight="660">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UserControl x:Name="Form"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Spacing="12" Margin="0,0,0,12" Visibility="{x:Bind PasswordField.Visibility,Mode=OneWay}">
                <PasswordBox x:Name="PasswordField" x:Uid="/Strings/MountBackupDialogPasswordField" loc:Ui.ResourceId="/Strings/MountBackupDialogPasswordField"/>
                <PasswordBox x:Name="ConfirmPasswordField" x:Uid="/Strings/MountBackupDialogConfirmPasswordField" loc:Ui.ResourceId="/Strings/MountBackupDialogConfirmPasswordField"/>
                <TextBlock TextWrapping="Wrap" MaxWidth="480" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="/Strings/MountBackupDialogTextBlockLeavingThisBlankGivesNoPassword" loc:Ui.ResourceId="/Strings/MountBackupDialogTextBlockLeavingThisBlankGivesNoPassword"/>
            </StackPanel>
            <ListView x:Name="RowsList" Grid.Row="1" SelectionMode="None" MaxHeight="440" HorizontalContentAlignment="Stretch" x:Uid="/Strings/MountBackupDialogRowsList" loc:Ui.ResourceId="/Strings/MountBackupDialogRowsList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:MountBackupRow">
                        <StackPanel Spacing="6" Padding="4,10">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Selected,Mode=TwoWay}" IsEnabled="{x:Bind CanSelect,Mode=OneWay}" Checked="SelectionChanged" Unchecked="SelectionChanged"/>
                            <TextBlock loc:Ui.Source="{x:Bind}" loc:Ui.Path="SourceDisplay" TextWrapping="Wrap"/>
                            <TextBlock loc:Ui.Source="{x:Bind}" loc:Ui.Path="OptionsDisplay" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind LocalPath,Mode=OneWay}" IsReadOnly="True" x:Uid="/Strings/MountBackupDialogTextBoxLocalFolder" loc:Ui.ResourceId="/Strings/MountBackupDialogTextBoxLocalFolder"/>
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Visibility="{x:Bind helpers:TextVisibility.ForFlag(IsImporting)}" Tag="{x:Bind}" Click="ChooseFolder" x:Uid="/Strings/MountBackupDialogButtonSelectFolder" loc:Ui.ResourceId="/Strings/MountBackupDialogButtonSelectFolder"/>
                            </Grid>
                            <TextBlock loc:Ui.Source="{x:Bind}" loc:Ui.Path="StatusDisplay" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(Status),Mode=OneWay}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid></UserControl>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind StatusBar.IsOpen,Mode=OneWay}" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <InfoBar Style="{StaticResource InstantNotificationStyle}" x:Name="StatusBar" IsOpen="False" IsClosable="False" Severity="Informational" x:Uid="/Strings/MountBackupDialogStatusBar" loc:Ui.ResourceId="/Strings/MountBackupDialogStatusBar"/>
        </ScrollViewer>
    </Grid>
</ContentDialog>
