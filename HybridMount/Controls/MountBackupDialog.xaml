<ContentDialog xmlns:loc="using:HybridMount.Helpers.UI" xmlns:helpers="using:HybridMount.Helpers.UI" x:Class="HybridMount.Controls.MountBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HybridMount.ViewModels" loc:Ui.TitleKey="Text_429EA3AF443D" loc:Ui.PrimaryButtonTextKey="Text_76420433F22D" loc:Ui.CloseButtonTextKey="Text_2CD0F3BE8738"
    DefaultButton="Primary" PrimaryButtonClick="Submit" Closing="OnClosing" Closed="OnClosed">
    <Grid MinWidth="480" MaxHeight="660">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UserControl x:Name="Form"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Spacing="12" Margin="0,0,0,12" Visibility="{x:Bind PasswordField.Visibility,Mode=OneWay}">
                <PasswordBox x:Name="PasswordField" loc:Ui.HeaderKey="Text_31850649661F"/>
                <PasswordBox x:Name="ConfirmPasswordField" loc:Ui.HeaderKey="Text_BFF03461DF20"/>
                <TextBlock loc:Ui.TextKey="Text_B571C7266A40" TextWrapping="Wrap" MaxWidth="480" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <ListView x:Name="RowsList" Grid.Row="1" SelectionMode="None" MaxHeight="440" HorizontalContentAlignment="Stretch" loc:Ui.AutomationNameKey="Text_7AA8F0383C44">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:MountBackupRow">
                        <StackPanel Spacing="6" Padding="4,10">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Selected,Mode=TwoWay}" IsEnabled="{x:Bind CanSelect,Mode=OneWay}" Checked="SelectionChanged" Unchecked="SelectionChanged"/>
                            <TextBlock loc:Ui.Source="{x:Bind}" loc:Ui.Path="SourceDisplay" TextWrapping="Wrap"/>
                            <TextBlock loc:Ui.Source="{x:Bind}" loc:Ui.Path="OptionsDisplay" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind LocalPath,Mode=OneWay}" loc:Ui.HeaderKey="Text_AEB65D05782D" IsReadOnly="True"/>
                                <Button Grid.Column="1" loc:Ui.ContentKey="Text_E5FE24CA742F" VerticalAlignment="Bottom" Visibility="{x:Bind helpers:TextVisibility.ForFlag(IsImporting)}" Tag="{x:Bind}" Click="ChooseFolder"/>
                            </Grid>
                            <TextBlock loc:Ui.Source="{x:Bind}" loc:Ui.Path="StatusDisplay" TextWrapping="Wrap" Visibility="{x:Bind helpers:TextVisibility.ForText(Status),Mode=OneWay}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid></UserControl>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Visibility="{x:Bind StatusBar.IsOpen,Mode=OneWay}" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" Severity="Informational" loc:Ui.TitleKey="Text_484747613975"/>
        </ScrollViewer>
    </Grid>
</ContentDialog>
