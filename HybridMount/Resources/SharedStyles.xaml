<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:HybridMount.Helpers.UI">
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#FFFDE7E9"/>
                    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#FFFFF4CE"/>
                    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#FFDFF6DD"/>

                    <StaticResource x:Key="AppBarButtonBackground" ResourceKey="SubtleButtonBackground"/>
                    <StaticResource x:Key="AppBarButtonForeground" ResourceKey="SubtleButtonForeground"/>
                    <StaticResource x:Key="AppBarButtonBorderBrush" ResourceKey="SubtleButtonBorderBrush"/>
                    <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="SubtleButtonBackgroundPointerOver"/>
                    <StaticResource x:Key="AppBarButtonForegroundPointerOver" ResourceKey="SubtleButtonForegroundPointerOver"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushPointerOver" ResourceKey="SubtleButtonBorderBrushPointerOver"/>
                    <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="SubtleButtonBackgroundPressed"/>
                    <StaticResource x:Key="AppBarButtonForegroundPressed" ResourceKey="SubtleButtonForegroundPressed"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushPressed" ResourceKey="SubtleButtonBorderBrushPressed"/>
                    <StaticResource x:Key="AppBarButtonBackgroundDisabled" ResourceKey="SubtleButtonBackgroundDisabled"/>
                    <StaticResource x:Key="AppBarButtonForegroundDisabled" ResourceKey="SubtleButtonForegroundDisabled"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushDisabled" ResourceKey="SubtleButtonBorderBrushDisabled"/>
                    <StaticResource x:Key="AppBarButtonBackgroundSubMenuOpened" ResourceKey="SubtleButtonBackgroundPressed"/>
                    <StaticResource x:Key="AppBarButtonForegroundSubMenuOpened" ResourceKey="SubtleButtonForegroundPressed"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushSubMenuOpened" ResourceKey="SubtleButtonBorderBrushPressed"/>
                    <SolidColorBrush x:Key="FieldErrorForegroundBrush" Color="{ThemeResource SystemFillColorCritical}"/>
                    <SolidColorBrush x:Key="MountIssueBadgeBackgroundBrush" Color="{ThemeResource SystemFillColorCritical}"/><SolidColorBrush x:Key="MountIssueBadgeForegroundBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FF202020"/>
                    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#FF442726"/>
                    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#FF433519"/>
                    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#FF393D1B"/>

                    <StaticResource x:Key="AppBarButtonBackground" ResourceKey="SubtleButtonBackground"/>
                    <StaticResource x:Key="AppBarButtonForeground" ResourceKey="SubtleButtonForeground"/>
                    <StaticResource x:Key="AppBarButtonBorderBrush" ResourceKey="SubtleButtonBorderBrush"/>
                    <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="SubtleButtonBackgroundPointerOver"/>
                    <StaticResource x:Key="AppBarButtonForegroundPointerOver" ResourceKey="SubtleButtonForegroundPointerOver"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushPointerOver" ResourceKey="SubtleButtonBorderBrushPointerOver"/>
                    <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="SubtleButtonBackgroundPressed"/>
                    <StaticResource x:Key="AppBarButtonForegroundPressed" ResourceKey="SubtleButtonForegroundPressed"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushPressed" ResourceKey="SubtleButtonBorderBrushPressed"/>
                    <StaticResource x:Key="AppBarButtonBackgroundDisabled" ResourceKey="SubtleButtonBackgroundDisabled"/>
                    <StaticResource x:Key="AppBarButtonForegroundDisabled" ResourceKey="SubtleButtonForegroundDisabled"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushDisabled" ResourceKey="SubtleButtonBorderBrushDisabled"/>
                    <StaticResource x:Key="AppBarButtonBackgroundSubMenuOpened" ResourceKey="SubtleButtonBackgroundPressed"/>
                    <StaticResource x:Key="AppBarButtonForegroundSubMenuOpened" ResourceKey="SubtleButtonForegroundPressed"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushSubMenuOpened" ResourceKey="SubtleButtonBorderBrushPressed"/>
                    <SolidColorBrush x:Key="FieldErrorForegroundBrush" Color="{ThemeResource SystemFillColorCritical}"/>
                    <SolidColorBrush x:Key="MountIssueBadgeBackgroundBrush" Color="{ThemeResource SystemFillColorCritical}"/><SolidColorBrush x:Key="MountIssueBadgeForegroundBrush" Color="Black"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>

                    <StaticResource x:Key="AppBarButtonBackground" ResourceKey="SubtleButtonBackground"/>
                    <StaticResource x:Key="AppBarButtonForeground" ResourceKey="SubtleButtonForeground"/>
                    <StaticResource x:Key="AppBarButtonBorderBrush" ResourceKey="SubtleButtonBorderBrush"/>
                    <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="SubtleButtonBackgroundPointerOver"/>
                    <StaticResource x:Key="AppBarButtonForegroundPointerOver" ResourceKey="SubtleButtonForegroundPointerOver"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushPointerOver" ResourceKey="SubtleButtonBorderBrushPointerOver"/>
                    <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="SubtleButtonBackgroundPressed"/>
                    <StaticResource x:Key="AppBarButtonForegroundPressed" ResourceKey="SubtleButtonForegroundPressed"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushPressed" ResourceKey="SubtleButtonBorderBrushPressed"/>
                    <StaticResource x:Key="AppBarButtonBackgroundDisabled" ResourceKey="SubtleButtonBackgroundDisabled"/>
                    <StaticResource x:Key="AppBarButtonForegroundDisabled" ResourceKey="SubtleButtonForegroundDisabled"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushDisabled" ResourceKey="SubtleButtonBorderBrushDisabled"/>
                    <StaticResource x:Key="AppBarButtonBackgroundSubMenuOpened" ResourceKey="SubtleButtonBackgroundPressed"/>
                    <StaticResource x:Key="AppBarButtonForegroundSubMenuOpened" ResourceKey="SubtleButtonForegroundPressed"/>
                    <StaticResource x:Key="AppBarButtonBorderBrushSubMenuOpened" ResourceKey="SubtleButtonBorderBrushPressed"/>
                    <SolidColorBrush x:Key="FieldErrorForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="MountIssueBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="MountIssueBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- 主窗口与页面即时提醒共用原生可关闭InfoBar；宽度受可用窗口约束，正文由原生模板换行。 -->
            <Style x:Key="InstantNotificationStyle" TargetType="InfoBar">
                <Setter Property="IsClosable" Value="True"/>
                <Setter Property="MaxWidth" Value="560"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
            </Style>
            <Style x:Key="FieldErrorTextStyle" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{ThemeResource FieldErrorForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
            <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}"/>
            <!-- 保留原生AppBar模板及溢出行为；外观沿用Subtle按钮的主题色、圆角和边框。 -->
            <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleButtonBackground}"/>
                <Setter Property="Foreground" Value="{ThemeResource SubtleButtonForeground}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleButtonBorderBrush}"/>
                <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
            </Style>
            <!-- 页面命令统一显示图标和右侧文字，宽度不足时使用系统溢出菜单。 -->
            <Style x:Key="PageCommandBarStyle" TargetType="CommandBar" BasedOn="{StaticResource DefaultCommandBarStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="DefaultLabelPosition" Value="Right"/>
                <Setter Property="IsDynamicOverflowEnabled" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style x:Key="SharedPageGridStyle" TargetType="Grid"><Setter Property="Padding" Value="24"/><Setter Property="helpers:PageLayout.Enabled" Value="True"/></Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
</ResourceDictionary>
