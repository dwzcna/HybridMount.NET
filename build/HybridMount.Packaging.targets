<Project>
  <!-- 部署、VS 打包能力及清单生成集中在此；解决方案仅有 Debug / Release。 -->
	<PropertyGroup>
		<!-- 两种部署均使用 Debug / Release；输出分开，避免交替调试污染缓存。 -->
		<HybridMountDeployment Condition="'$(HybridMountDeployment)' == '' and '$(WindowsPackageType)' == 'None'">Unpackaged</HybridMountDeployment>
		<HybridMountDeployment Condition="'$(HybridMountDeployment)' == ''">Packaged</HybridMountDeployment>
		<WindowsPackageType Condition="'$(HybridMountDeployment)' == 'Unpackaged'">None</WindowsPackageType>
		<WindowsPackageType Condition="'$(HybridMountDeployment)' == 'Packaged'">MSIX</WindowsPackageType>
		<AppxPackage Condition="'$(HybridMountDeployment)' == 'Unpackaged'">false</AppxPackage>
		<AppxPackage Condition="'$(HybridMountDeployment)' == 'Packaged'">true</AppxPackage>
		<GenerateAppxPackageOnBuild Condition="'$(HybridMountDeployment)' == 'Unpackaged'">false</GenerateAppxPackageOnBuild>
		<OutputPath>bin\$(Platform)\$(Configuration)\$(HybridMountDeployment)\</OutputPath>
		<IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(HybridMountDeployment)\</IntermediateOutputPath>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<AppxBundle>Never</AppxBundle>
		<AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
		<GenerateAppInstallerFile>false</GenerateAppInstallerFile>
		<HasPackageAndPublishMenu Condition="'$(HybridMountDeployment)' == 'Packaged'">true</HasPackageAndPublishMenu>
	</PropertyGroup>
	<PropertyGroup>
		<HybridMountShellProfile Condition="'$(HybridMountShellProfile)'==''">Menus</HybridMountShellProfile>
		<PackageCertificateThumbprint>3FB1D78271BA8F6EDD3CE163F57D93D13FEB83C0</PackageCertificateThumbprint>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<GenerateTestArtifacts>False</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>
	<!-- VS 的单项目 MSIX 菜单由项目能力和菜单属性共同启用；非打包构建不声明该能力。 -->
	<ItemGroup Condition="'$(HybridMountDeployment)' == 'Packaged' and '$(EnableMsixTooling)' == 'true' and '$(DisableMsixProjectCapabilityAddedByProject)' != 'true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>

	<!-- 源清单供 VS 包向导读取，必须与集中版本一致；仅修改构建副本的Shell配置。 -->
	<Target Name="PrepareProductManifest" BeforeTargets="PrepareForBuild" Condition="'$(HybridMountDeployment)'=='Packaged'">
		<Error Condition="'$(HybridMountShellProfile)'=='MenusAndThumbnails'" Text="云缩略图候选会使原生状态显示退化，尚未通过真实MSIX验收；正式构建请使用Menus或Native。" />
		<Error Condition="'$(HybridMountEnableCloudThumbnails)'!=''" Text="请使用HybridMountShellProfile选择Menus或Native。" />
		<Error Condition="'$(HybridMountShellProfile)'!='Native' and '$(HybridMountShellProfile)'!='Menus' and '$(HybridMountShellProfile)'!='MenusAndThumbnails'" Text="Shell配置无效。" />
		<XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
			<Output TaskParameter="Result" PropertyName="_SourceManifestVersion" />
		</XmlPeek>
		<Error Condition="'$(_SourceManifestVersion)' != '$(BinaryVersion)'" Text="Package.appxmanifest 版本 $(_SourceManifestVersion) 与集中版本 $(BinaryVersion) 不一致；请同步源清单，确保 Visual Studio 打包向导显示正确版本。" />
		<PropertyGroup>
			<_ProductManifest>$(IntermediateOutputPath)HybridMount.appxmanifest</_ProductManifest>
		</PropertyGroup>
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Prepare-Manifest.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\Package.appxmanifest&quot; -Destination &quot;$(_ProductManifest)&quot; -ShellProfile $(HybridMountShellProfile)" />
		<ItemGroup>
			<AppxManifest Remove="@(AppxManifest)" />
			<AppxManifest Include="$(_ProductManifest)" />
			<FileWrites Include="$(_ProductManifest)" />
		</ItemGroup>
	</Target>
</Project>
