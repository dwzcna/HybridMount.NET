<Project>
  <!-- 部署、VS 打包能力及清单生成集中在此；解决方案仅有 Debug / Release。 -->
	<PropertyGroup>
		<!-- 两种部署均使用 Debug / Release；输出分开，避免交替调试污染缓存。 -->
		<HybridMountDeployment Condition="'$(HybridMountDeployment)' == '' and '$(WindowsPackageType)' == 'None'">Unpackaged</HybridMountDeployment>
		<HybridMountDeployment Condition="'$(HybridMountDeployment)' == ''">Packaged</HybridMountDeployment>
		<WindowsPackageType Condition="'$(HybridMountDeployment)' == 'Unpackaged'">None</WindowsPackageType>
		<WindowsPackageType Condition="'$(HybridMountDeployment)' == 'Packaged'">MSIX</WindowsPackageType>
		<AppxPackage Condition="'$(HybridMountDeployment)' == 'Unpackaged'">false</AppxPackage>
		<AppxPackage Condition="'$(HybridMountDeployment)' == 'Packaged'">true</AppxPackage>
		<GenerateAppxPackageOnBuild Condition="'$(HybridMountDeployment)' == 'Unpackaged'">false</GenerateAppxPackageOnBuild>
		<OutputPath>bin\$(Platform)\$(Configuration)\$(HybridMountDeployment)\$(HybridMountRuntimeMode)\$(HybridMountShellProfile)\$(HybridMountDistributionChannel)\$(HybridMountPackageName)\$(HybridMountBuildPurpose)\</OutputPath>
		<IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
		<AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == '' and '$(PackageCertificateThumbprint)' != '' and '$(HybridMountDistributionChannel)' != 'Store'">true</AppxPackageSigningEnabled>
        <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
		<AppxBundle>Never</AppxBundle>
        <!-- 渠道与身份也隔离中间产物；新包不得接管旧包根。 -->
        <AppxPackageName>HybridMount.NET_$(BinaryVersion)_$(Platform)_$(HybridMountRuntimeMode)</AppxPackageName>
		<AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
		<GenerateAppInstallerFile>false</GenerateAppInstallerFile>
		<HasPackageAndPublishMenu Condition="'$(HybridMountDeployment)' == 'Packaged'">true</HasPackageAndPublishMenu>
	</PropertyGroup>
	<PropertyGroup>
		<HybridMountShellProfile Condition="'$(HybridMountShellProfile)'==''">MenusAndThumbnails</HybridMountShellProfile>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<GenerateTestArtifacts>False</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>
	<!-- VS 的单项目 MSIX 菜单由项目能力和菜单属性共同启用；非打包构建不声明该能力。 -->
	<ItemGroup Condition="'$(HybridMountDeployment)' == 'Packaged' and '$(EnableMsixTooling)' == 'true' and '$(DisableMsixProjectCapabilityAddedByProject)' != 'true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>

  <Target Name="ValidateDistributionChannel" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_StoreVersionMajor>$([System.Version]::Parse('$(BinaryVersion)').Major)</_StoreVersionMajor>
      <_StoreVersionRevision>$([System.Version]::Parse('$(BinaryVersion)').Revision)</_StoreVersionRevision>
    </PropertyGroup>
    <Error Condition="'$(HybridMountDistributionChannel)' != 'Store' and '$(HybridMountDistributionChannel)' != 'Sideload'" Text="发行渠道必须为Store或Sideload。"/>
    <Error Condition="'$(HybridMountDistributionChannel)' == 'Store' and ('$(Configuration)' != 'Release' or '$(HybridMountDeployment)' != 'Packaged' or '$(HybridMountRuntimeMode)' != 'Full' or '$(AppxPackageSigningEnabled)' == 'true')" Text="Store构建必须为Release／Packaged／Full且不使用侧载签名。"/>
    <Error Condition="'$(HybridMountStoreSubmission)' == 'true' and ('$(_StoreVersionMajor)' == '0' or '$(_StoreVersionRevision)' != '0')" Text="Store正式提交要求非零首段且第四段为0；准备版不能作为正式提交包。"/>
  </Target>
  <Target Name="ValidateRuntimeMode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(HybridMountRuntimeMode)' != 'Full' and '$(HybridMountRuntimeMode)' != 'Small'" Text="HybridMountRuntimeMode必须为Full或Small。"/>
    <Error Condition="('$(HybridMountRuntimeMode)' == 'Full' and ('$(SelfContained)' != 'true' or '$(WindowsAppSDKSelfContained)' != 'true')) or ('$(HybridMountRuntimeMode)' == 'Small' and ('$(SelfContained)' != 'false' or '$(WindowsAppSDKSelfContained)' != 'false'))" Text="运行时模式与SelfContained／WindowsAppSDKSelfContained不一致。"/>
    <Error Condition="'$(_HybridMountKnownProfile)' == 'true' and (($(_HybridMountProfileName.Contains('arm64')) and '$(Platform)' != 'ARM64') or (!$(_HybridMountProfileName.Contains('arm64')) and '$(Platform)' != 'x64'))" Text="发布配置与Platform不一致。"/>

  </Target>

  <UsingTask TaskName="HybridMountPrepareManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <!-- 默认netstandard引用已涵盖本任务API；Task正文不支持MSBuild条件求值。 -->
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)PrepareManifestTask.cs"/>
    </Task>
  </UsingTask>

	<!-- 源清单供 VS 包向导读取，必须与集中版本一致；仅修改构建副本的Shell配置。 -->
	<Target Name="PrepareProductManifest" BeforeTargets="PrepareForBuild" Condition="'$(HybridMountDeployment)'=='Packaged'">
		<Error Condition="'$(HybridMountEnableCloudThumbnails)'!=''" Text="请使用HybridMountShellProfile选择MenusAndThumbnails、Menus或Native。" />
		<Error Condition="'$(HybridMountShellProfile)'!='Native' and '$(HybridMountShellProfile)'!='Menus' and '$(HybridMountShellProfile)'!='MenusAndThumbnails'" Text="Shell配置无效。" />
		<XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
			<Output TaskParameter="Result" PropertyName="_SourceManifestVersion" />
		</XmlPeek>
		<Error Condition="'$(_SourceManifestVersion)' != '$(BinaryVersion)'" Text="Package.appxmanifest 版本 $(_SourceManifestVersion) 与集中版本 $(BinaryVersion) 不一致；请同步源清单，确保 Visual Studio 打包向导显示正确版本。" />
        <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Name"><Output TaskParameter="Result" PropertyName="_SourceIdentityName" /></XmlPeek>
        <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Publisher"><Output TaskParameter="Result" PropertyName="_SourcePublisher" /></XmlPeek>
        <Error Condition="'$(_SourceIdentityName)' != '$(HybridMountPackageName)' or '$(_SourcePublisher)' != '$(HybridMountPublisher)'" Text="包身份与集中发行身份不一致。"/>
        <PropertyGroup>
            <_ProductManifest>$(IntermediateOutputPath)HybridMount.appxmanifest</_ProductManifest>
		</PropertyGroup>
        <HybridMountPrepareManifest Source="$(MSBuildProjectDirectory)\Package.appxmanifest" Destination="$(_ProductManifest)" ProjectDirectory="$(MSBuildProjectDirectory)" ShellProfile="$(HybridMountShellProfile)" />
		<ItemGroup>
			<AppxManifest Remove="@(AppxManifest)" />
			<AppxManifest Include="$(_ProductManifest)" />
			<FileWrites Include="$(_ProductManifest)" />
		</ItemGroup>
	</Target>
</Project>
