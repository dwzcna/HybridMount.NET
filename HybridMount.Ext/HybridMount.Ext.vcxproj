<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><ProjectGuid>{E353AAE2-9EC4-45F5-BBD2-0E53BE1EF224}</ProjectGuid><RootNamespace>HybridMount.Ext</RootNamespace><WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion><VCProjectVersion>18.0</VCProjectVersion></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props"/>
  <PropertyGroup Label="Configuration"><ConfigurationType>DynamicLibrary</ConfigurationType><PlatformToolset>v145</PlatformToolset><CharacterSet>Unicode</CharacterSet><UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props"/>
  <PropertyGroup><OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir><IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir><TargetName>HybridMount.Ext</TargetName></PropertyGroup>
  <!-- 测试 DLL 单独输出且仅在测试进程使用隔离管道；发布 DLL 不定义此宏。 -->
  <ItemDefinitionGroup Condition="'$(HybridMountIsolatedTests)'=='true'"><ClCompile><PreprocessorDefinitions>HYBRIDMOUNT_SHELL_EXTENSION;HYBRIDMOUNT_ISOLATED_TEST_PIPE;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile></ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(HybridMountShellProbeTag)'!=''"><ClCompile><PreprocessorDefinitions>HYBRIDMOUNT_SHELL_EXTENSION;HYBRIDMOUNT_SHELL_PROBE_ID=0x$(HybridMountShellProbeTag);HYBRIDMOUNT_SHELL_PROBE_TAG=$(HybridMountShellProbeTag);%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile></ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <ClCompile><WarningLevel>Level4</WarningLevel><TreatWarningAsError>true</TreatWarningAsError><LanguageStandard>stdcpp20</LanguageStandard><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions><PreprocessorDefinitions>HYBRIDMOUNT_SHELL_EXTENSION;NTDDI_VERSION=0x0A000003;WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions><RuntimeLibrary>MultiThreaded</RuntimeLibrary><ExceptionHandling>Sync</ExceptionHandling><ConformanceMode>true</ConformanceMode><SDLCheck>true</SDLCheck></ClCompile>
    <Link><DelayLoadDLLs>mfplat.dll;mfreadwrite.dll;%(DelayLoadDLLs)</DelayLoadDLLs><ModuleDefinitionFile>Exports.def</ModuleDefinitionFile><AdditionalDependencies>CldApi.lib;propsys.lib;shell32.lib;shlwapi.lib;ole32.lib;advapi32.lib;runtimeobject.lib;user32.lib;windowscodecs.lib;mfplat.lib;mfreadwrite.lib;mfuuid.lib;delayimp.lib;gdi32.lib;crypt32.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies><SubSystem>Windows</SubSystem><GenerateDebugInformation>true</GenerateDebugInformation></Link>
    <ResourceCompile><AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ResourceCompile>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="ShellMenu.cpp"/><ClCompile Include="..\HybridMount.Stock\NativeLanguage.cpp"/><ClInclude Include="..\HybridMount.Stock\NativeLanguage.h"/><ClCompile Include="MenuQuery.cpp"/><ClCompile Include="MenuSelection.cpp"/><ClInclude Include="MenuQuery.h"/><ClCompile Include="PipeClient.cpp"/><ClCompile Include="ThumbnailProvider.cpp"/><ClCompile Include="..\HybridMount.Stock\ThumbnailCache.cpp"/><ClCompile Include="ThumbnailServer.cpp"/><ClCompile Include="PreviewDecoder.cpp"/><ClInclude Include="Extension.h"/><ResourceCompile Include="HybridMount.Ext.rc"/><None Include="Exports.def"/></ItemGroup>
  <Target Name="GenerateVersionHeader" BeforeTargets="ResourceCompile">
    <WriteLinesToFile File="$(IntDir)Version.h" Lines="#define HYBRIDMOUNT_VERSION $(BinaryVersion.Replace('.', ','))%0A#define HYBRIDMOUNT_VERSION_TEXT &quot;$(BinaryVersion)&quot;" Overwrite="true" WriteOnlyWhenDifferent="true"/>
  </Target>
  <!-- 标准Win32 MUI：资源DLL拆成LN与语言卫星，共享校验和，最终回退zh-CN；不修改代码DLL。 -->
  <ItemGroup>
    <_HybridMountMuiLanguage Include="zh-CN"><LanguageId>0x0804</LanguageId></_HybridMountMuiLanguage>
    <_HybridMountMuiLanguage Include="en-US"><LanguageId>0x0409</LanguageId></_HybridMountMuiLanguage>
    <_HybridMountMuiLanguage Include="zh-HK"><LanguageId>0x0c04</LanguageId></_HybridMountMuiLanguage>
    <_HybridMountMuiLanguage Update="@(_HybridMountMuiLanguage)">
      <Source>$(ProjectDir)Resources\%(Identity)\NativeStrings.rc</Source>
      <Work>$(IntDir)mui\%(Identity)</Work>
      <OutputDirectory>$(OutDir)%(Identity)</OutputDirectory>
    </_HybridMountMuiLanguage>
    <None Include="Resources\**\NativeStrings.rc"/>
    <None Include="..\build\NativeMUI.rcconfig"/>
  </ItemGroup>
  <Target Name="BuildNativeLanguageResources" AfterTargets="Link" Inputs="@(_HybridMountMuiLanguage->'%(Source)');$(ProjectDir)..\build\NativeMUI.rcconfig;$(MSBuildProjectFullPath)" Outputs="$(OutDir)HybridMount.Ext.resources.dll;@(_HybridMountMuiLanguage->'%(OutputDirectory)\HybridMount.Ext.resources.dll.mui')">
    <PropertyGroup>
      <_MuiHost>x64</_MuiHost>
      <_MuiHost Condition="'$(VCToolArchitecture)' == 'NativeARM64'">arm64</_MuiHost>
      <_MuiHost Condition="'$(VCToolArchitecture)' == 'Native32Bit'">x86</_MuiHost>
      <_MuiRc>$(WindowsSdkDir)bin\$(TargetPlatformVersion)\$(_MuiHost)\rc.exe</_MuiRc>
      <_MuiTool>$(WindowsSdkDir)bin\$(TargetPlatformVersion)\$(_MuiHost)\muirct.exe</_MuiTool>
      <_MuiLink>$(VCToolsInstallDir)bin\Host$(_MuiHost)\$(_MuiHost)\link.exe</_MuiLink>
      <_MuiConfig>$(ProjectDir)..\build\NativeMUI.rcconfig</_MuiConfig>
    </PropertyGroup>
    <Error Condition="!Exists('$(_MuiRc)') or !Exists('$(_MuiTool)') or !Exists('$(_MuiLink)')" Text="当前VC工具链或Windows SDK的RC、MUIRCT、LINK资源工具不存在。"/>
    <MakeDir Directories="@(_HybridMountMuiLanguage->'%(Work)');@(_HybridMountMuiLanguage->'%(OutputDirectory)')"/>
    <Exec Command="&quot;$(_MuiRc)&quot; /nologo &quot;/fo%(_HybridMountMuiLanguage.Work)\full.res&quot; &quot;%(_HybridMountMuiLanguage.Source)&quot;"/>
    <Exec Command="&quot;$(_MuiLink)&quot; /nologo /DLL /NOENTRY /MACHINE:$(Platform) &quot;/OUT:%(_HybridMountMuiLanguage.Work)\full.dll&quot; &quot;%(_HybridMountMuiLanguage.Work)\full.res&quot;"/>
    <Exec Command="&quot;$(_MuiTool)&quot; -q &quot;$(_MuiConfig)&quot; -x 0x0804 -g 0x0804 &quot;$(IntDir)mui\zh-CN\full.dll&quot; &quot;$(OutDir)HybridMount.Ext.resources.dll&quot; &quot;$(OutDir)zh-CN\HybridMount.Ext.resources.dll.mui&quot;"/>
    <Exec Command="&quot;$(_MuiTool)&quot; -q &quot;$(_MuiConfig)&quot; -x %(_HybridMountMuiLanguage.LanguageId) -g 0x0804 &quot;%(_HybridMountMuiLanguage.Work)\full.dll&quot; &quot;%(_HybridMountMuiLanguage.Work)\discard.dll&quot; &quot;%(_HybridMountMuiLanguage.OutputDirectory)\HybridMount.Ext.resources.dll.mui&quot;"/>
    <Exec Command="&quot;$(_MuiTool)&quot; -c &quot;$(OutDir)HybridMount.Ext.resources.dll&quot; -e &quot;%(_HybridMountMuiLanguage.OutputDirectory)\HybridMount.Ext.resources.dll.mui&quot;"/>
    <ItemGroup><FileWrites Include="$(OutDir)HybridMount.Ext.resources.dll;@(_HybridMountMuiLanguage->'%(OutputDirectory)\HybridMount.Ext.resources.dll.mui')"/></ItemGroup>
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets"/>
</Project>
